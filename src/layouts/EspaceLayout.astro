---
/* Espace connecté (CDC §9) : barre latérale sur ordinateur, barre d'onglets en bas de l'écran sur mobile. */
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { ROLE_LABEL, isStaff, type Role } from '../lib/rbac';
import { eq } from 'drizzle-orm';
import { db } from '../lib/db';
import { callJury, cohortMember } from '../db/schema/programmes';

interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
const user = Astro.locals.user!;
const path = Astro.url.pathname.replace(/\/$/, '');
const roles = user.roles as Role[];
const has = (...r: Role[]) => r.some((x) => roles.includes(x));
// Membre de l'équipe CEA : guider vers le back-office (double authentification obligatoire avant d'y accéder)
const staff = isStaff(roles);
const staffRoles = roles.filter((r) => r !== 'membre' && isStaff([r])).map((r) => ROLE_LABEL[r] ?? r).join(', ');
const tfaMissing = staff && !user.twoFactorEnabled;
// Entrées liées à un rattachement (programmes, CDC §12) : participant d'une cohorte, membre d'un jury
const [[inCohort], [isJury]] = await Promise.all([
  db.select({ u: cohortMember.userId }).from(cohortMember).where(eq(cohortMember.userId, user.id)).limit(1).catch(() => []),
  db.select({ u: callJury.userId }).from(callJury).where(eq(callJury.userId, user.id)).limit(1).catch(() => []),
]);

const groups: [string, [string, string, boolean?][]][] = [
  ['MON ESPACE', [['/espace', 'Tableau de bord'], ['/espace/profil', 'Profil 360°'], ['/espace/carte', 'Carte de membre'], ['/espace/notifications', 'Notifications'], ['/espace/demandes', 'Mes demandes'], ['/espace/securite', 'Sécurité'], ['/espace/confidentialite', 'Confidentialité']]],
  ['MES ACTIVITÉS', [
    ['/espace/apprentissage', 'Apprentissage'], ['/espace/programme', 'Mon programme', !!inCohort], ['/espace/candidatures', 'Candidatures'], ['/espace/billets', 'Billets'], ['/espace/messages', 'Messagerie'],
    ['/espace/projets', 'Mes projets', has('entrepreneur', 'membre')], ['/espace/mentorat', 'Mentorat'], ['/espace/cercle', 'Mon cercle Mastermind'],
  ]],
  ['MES RÔLES', [
    ['/espace/recruteur', 'Espace recruteur', has('employeur')], ['/espace/mentor', 'Espace mentor', has('mentor')], ['/espace/jury', 'Jury', !!isJury],
    ['/kapital/entreprise', 'Kapital — entreprise', has('entrepreneur')], ['/kapital/investisseur', 'Kapital — investisseur', has('investisseur')],
    ['/admin', tfaMissing ? 'Back-office CEA OS (à activer)' : 'Back-office CEA OS', staff],
  ]],
];
/** Icône de chaque entrée du menu (noms de src/data ICON). */
const ICONS: Record<string, string> = {
  '/espace': 'home', '/espace/profil': 'user', '/espace/carte': 'card', '/espace/notifications': 'bell', '/espace/demandes': 'chat', '/espace/securite': 'lock', '/espace/confidentialite': 'shield',
  '/espace/apprentissage': 'learn', '/espace/programme': 'rocket', '/espace/candidatures': 'check', '/espace/billets': 'ticket', '/espace/messages': 'mail', '/espace/projets': 'proj', '/espace/mentorat': 'hand', '/espace/cercle': 'circle',
  '/espace/recruteur': 'job', '/espace/mentor': 'star', '/espace/jury': 'gov', '/kapital/entreprise': 'fund', '/kapital/investisseur': 'chart', '/admin': 'gear',
};
const tabs: [string, string, string][] = [
  ['/espace', 'Accueil', 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z'],
  ['/espace/apprentissage', 'Apprendre', 'M2 9l10-5 10 5-10 5zM6 11v5c3 2 9 2 12 0v-5'],
  ['/communaute', 'Réseau', 'M9 8a3.5 3.5 0 1 0 0-.01M2 20c0-3.3 3.1-6 7-6s7 2.7 7 6M17 9a2.5 2.5 0 1 0 0-.01M22 19c0-2.3-1.8-4.3-4.3-4.9'],
  ['/opportunites', 'Opportunités', 'M3 7h18v13H3zM9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2'],
  ['/espace/profil', 'Profil', 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c0-4 3.6-7 8-7s8 3 8 7'],
];
---
<BaseLayout title={title}>
  <div class="wrap dash">
    <nav class="side" id="sideNav" aria-label="Mon espace">
      <button class="side-toggle" type="button" data-side-toggle aria-controls="sideNav" aria-pressed="false"><span class="st-open">‹ Réduire le menu</span><span class="st-closed" aria-hidden="true">›</span></button>
      <div class="side-body" id="sideBody">
        <div class="small" style="padding:0 12px 8px"><b>{user.name}</b><br /><span class="muted xs">{roles.map((r) => ROLE_LABEL[r] ?? r).join(' · ')}</span></div>
        {groups.map(([h, links]) => (
          <>
            <h5>{h}</h5>
            {links.filter((l) => l[2] !== false).map(([href, label]) => <a href={href} title={label} aria-current={path === href ? 'page' : undefined}><Icon name={ICONS[href] ?? 'info'} size={18} /><span class="sl">{label}</span></a>)}
          </>
        ))}
        <button class="side-logout" type="button" data-logout title="Se déconnecter"><Icon name="logout" size={18} /><span class="sl">Se déconnecter</span></button>
      </div>
    </nav>
    <div>
      {tfaMissing && !path.startsWith('/espace/securite') && (
        <div class="panel staff-cta" role="status">
          <div>
            <span class="tag gold">Équipe CEA · {staffRoles}</span>
            <h2 style="font-size:1.25rem;margin:8px 0 4px">Votre back-office CEA OS vous attend</h2>
            <p class="small" style="margin:0 0 8px">C'est l'espace de gestion de la plateforme : contenus, membres et rôles, programmes, événements, paiements, Kapital Invest. Comme il donne accès à des données sensibles, il faut d'abord activer la <b>double authentification</b> : environ 2 minutes, une seule fois.</p>
            <ol class="small" style="margin:0;padding-left:18px"><li>Installez sur votre téléphone une application d'authentification gratuite (Google Authenticator, Microsoft Authenticator…).</li><li>Scannez le QR code affiché sur la page Sécurité.</li><li>Saisissez le code à 6 chiffres : le back-office s'ouvre.</li></ol>
          </div>
          <a class="btn btn-gold" href="/espace/securite?motif=2fa">Activer maintenant</a>
        </div>
      )}
      {staff && !tfaMissing && path === '/espace' && (
        <div class="panel staff-cta" role="status">
          <div><span class="tag gold">Équipe CEA · {staffRoles}</span><h2 style="font-size:1.25rem;margin:8px 0 0">Back-office CEA OS</h2><p class="small muted" style="margin:4px 0 0">Gérez la plateforme selon vos droits.</p></div>
          <a class="btn btn-primary" href="/admin">Ouvrir le back-office</a>
        </div>
      )}
      <div class="row between" style="align-items:flex-start">
        <div><h1 style="font-size:2rem;margin:0">{title}</h1>{lead && <p class="muted">{lead}</p>}</div>
        <slot name="head" />
      </div>
      <slot />
    </div>
  </div>
  <nav class="tabbar" aria-label="Navigation de l'espace">
    {tabs.map(([href, label, d]) => (
      <a href={href} aria-current={path === href ? 'page' : undefined}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg>{label}</a>
    ))}
  </nav>
</BaseLayout>
