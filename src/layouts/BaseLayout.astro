---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Copilot from '../components/Copilot.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { MENU, KMENU, COURSES, EVENTS, JOBS, OPPS, ARTICLES, country } from '../data/site';
import { getLang, lp, stripLang, localizeHtml, useT, TRANSLATED } from '../i18n/ui';
import { getLocalisation } from '../lib/localisation';

/* os : application CEA OS (back-office) — sans en-tête ni pied de page du site public, typographies du prototype CEA OS */
interface Props { title?: string; description?: string; image?: string; os?: boolean }
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const defaultDesc = lang === 'en'
  ? 'CEA FOR AFRICA — the platform for African entrepreneurs: training, support, events, opportunities and CEA Kapital Invest.'
  : 'CEA FOR AFRICA — la plateforme des entrepreneurs africains : formation, accompagnement, événements, opportunités et CEA Kapital Invest.';
const { title, description = defaultDesc, image, os = false } = Astro.props;
const fullTitle = title ? `${title} — CEA FOR AFRICA` : `CEA FOR AFRICA — ${lang === 'en' ? 'Connect · Build · Act' : 'Connecter · Entreprendre · Agir'}`;

// Chemin français de la page (sur les pages anglaises de repli, Astro fournit déjà le chemin français).
const frPath = (stripLang(Astro.url.pathname).replace(/\/$/, '') || '/');
const translated = lang === 'fr' || TRANSLATED.has(frPath);
// Devises actives, taux et devise/fuseau de chaque pays : Paramétrage › Pays, langues, devises
const loc = await getLocalisation();
// Univers de la page (CDC §5.2) : couleur secondaire d'orientation pour l'Académie, Talents et Events (Kapital a son propre thème)
const section = frPath.split('/')[1] ?? '';
const univers = ({ academie: 'academie', programmes: 'academie', opportunites: 'talents', evenements: 'events' } as Record<string, string>)[section];
const alt = (l: 'fr' | 'en') => new URL(lp(l, frPath === '/' ? '/' : frPath + '/'), Astro.site).href;

// Contenu de la page : en anglais, les liens internes sont réécrits vers /en/…
const body = localizeHtml(await Astro.slots.render('default'), lang);

// Index de recherche : t titre, d description, h lien, ty type ; facultatifs pour les filtres : c pays, s secteur ou thème, dt date (AAAA-MM-JJ)
type SearchEntry = { t: string; d: string; h: string; ty: string; c?: string; s?: string; dt?: string };
const searchIndex = ([
  ...MENU.flatMap((m) => m.cols.flatMap((c) => c.items.map((i) => ({ t: i[2], d: i[3], h: i[0], ty: 'Page' })))),
  ...KMENU.flatMap((m) => m.cols.flatMap((c) => c.items.map((i) => ({ t: i[2], d: 'Kapital Invest — ' + i[3], h: i[0], ty: 'Kapital' })))),
  ...COURSES.map((c) => ({ t: c.t, d: `${c.th} · ${c.by}`, h: `/academie/${c.id}`, ty: lang === 'en' ? 'Course' : 'Cours', s: c.th })),
  ...EVENTS.map((e) => ({ t: e.t, d: `${e.city} · ${e.date}`, h: `/evenements/${e.id}`, ty: lang === 'en' ? 'Event' : 'Événement', c: country(e.c), dt: e.date })),
  ...JOBS.map((j) => ({ t: j.t, d: `${j.co} · ${country(j.c)}`, h: '/opportunites', ty: lang === 'en' ? 'Job' : 'Emploi', c: country(j.c) })),
  ...OPPS.map((o) => ({ t: o.n, d: `${o.s} · ${country(o.c)}`, h: `/kapital/opportunites/${o.id}`, ty: lang === 'en' ? 'Opportunity' : 'Opportunité', c: country(o.c), s: o.s })),
  ...ARTICLES.map((a) => ({ t: a.t, d: a.cat, h: `/ressources/article/${a.id}`, ty: 'Article', c: a.c === 'Panafricain' ? undefined : a.c, s: a.cat, dt: a.d })),
] as SearchEntry[]).map((e) => ({ ...e, h: lp(lang, e.h) }));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={alt(lang)} />
    <link rel="alternate" hreflang="fr" href={alt('fr')} />
    <link rel="alternate" hreflang="en" href={alt('en')} />
    <link rel="alternate" hreflang="x-default" href={alt('fr')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'fr_FR'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#082B4C" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {os && <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />}
    {os && <meta name="robots" content="noindex" />}
    <script is:inline>
      try {
        var t = localStorage.getItem('cea-theme'); if (t) document.documentElement.dataset.theme = t;
        var f = localStorage.getItem('cea-fs'); if (f) document.documentElement.style.setProperty('--fs', f + 'px');
        if (localStorage.getItem('cea-lite') === '1') document.documentElement.classList.add('lite');
        if (localStorage.getItem('cea-side') === 'min') document.documentElement.classList.add('side-min');
      } catch (e) {}
    </script>
  </head>
  <body data-univers={univers} class={os ? 'os' : undefined}>
    <a class="sr" href="#app">{t('skip')}</a>
    {!os && <Header />}
    {!os && !translated && <div class="i18n-note">{t('notTranslated')} <a href={alt('fr')} hreflang="fr">Version française</a></div>}
    <main id="app" tabindex="-1" lang={translated ? lang : 'fr'} set:html={body} />
    {!os && <Footer />}
    <Copilot />
    <CookieBanner lang={lang === 'en' ? 'en' : 'fr'} />
    <script type="application/json" id="searchIndex" set:html={JSON.stringify(searchIndex)} />
    <script type="application/json" id="currencies" set:html={JSON.stringify(loc.currencies.filter((c) => c.active).map(({ code, perEur, symbol }) => ({ code, perEur, symbol })))} />
    <script type="application/json" id="countryCur" set:html={JSON.stringify(Object.fromEntries(loc.countries.map((c) => [c.code, c.currency])))} />
    <script type="application/json" id="countryTz" set:html={JSON.stringify(Object.fromEntries(loc.countries.map((c) => [c.code, c.tz])))} />
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
