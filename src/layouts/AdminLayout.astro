---
/* Back-office « CEA OS » (CDC §12), au design du prototype CEA OS : application à part entière (sans l'en-tête ni le pied de
   page du site public), menu latéral bleu nuit par rubriques avec compteurs, barre supérieure (périmètre, recherche,
   « À traiter », notifications, CEA Copilot, compte), en-tête de page. Navigation filtrée selon les droits ; chaque page
   vérifie aussi son propre droit. */
import { sql } from 'drizzle-orm';
import BaseLayout from './BaseLayout.astro';
import RightsHint from '../components/RightsHint.astro';
import { ADMIN_NAV, ADMIN_ICON, ADMIN_GROUPS, countriesFor } from '../lib/admin';
import Icon from '../components/Icon.astro';
import { db } from '../lib/db';
import { can, ROLE_LABEL, type Obj, type Role } from '../lib/rbac';
import { country } from '../data/site';

/* hints : objets dont les droits manquants sont expliqués en haut de page (par défaut l'objet de la page ; [] pour aucun) */
interface Props { title: string; lead?: string; obj: Obj; hints?: Obj[] }
const { title, lead, obj, hints = [obj] } = Astro.props;
const me = Astro.locals.user!;
const path = Astro.url.pathname.replace(/\/$/, '');
const allowed = can(me.roles, obj, 'L');
const roles = me.roles.filter((r) => r !== 'membre').map((r) => ROLE_LABEL[r as Role] ?? r).join(' · ');
const initials = me.name.split(' ').map((x) => x[0]).join('').slice(0, 2).toUpperCase();

// Menu par rubriques, limité aux entrées autorisées
const nav = ADMIN_NAV.filter(([, , o]) => can(me.roles, o, 'L'));
const placed = new Set(ADMIN_GROUPS.flatMap(([, h]) => h));
const groups = [...ADMIN_GROUPS, ['Autres', nav.map(([h]) => h).filter((h) => !placed.has(h))] as [string, string[]]]
  .map(([g, hrefs]) => [g, hrefs.map((h) => nav.find(([x]) => x === h)).filter((x): x is (typeof nav)[number] => !!x)] as const)
  .filter(([, items]) => items.length);

// Compteurs « à traiter » (comme les pastilles du prototype)
const c = (await db.execute(sql`select
  (select count(*) from contact_message where status = 'nouveau')::int as messages,
  (select count(*) from post where status = 'en_moderation')::int as moderation,
  (select count(*) from job where status = 'en_moderation')::int as emplois,
  (select count(*) from programme_application where status = 'recue')::int as candidatures,
  (select count(*) from kapital.dossier where status = 'recu')::int as kapital`).catch(() => ({ rows: [{}] }))).rows[0] as Record<string, number>;
const COUNT: Record<string, number> = { '/admin/messages': c.messages ?? 0, '/admin/moderation': c.moderation ?? 0, '/admin/emplois': c.emplois ?? 0, '/admin/candidatures': c.candidatures ?? 0, '/admin/kapital': c.kapital ?? 0 };
const todo = Object.entries(COUNT).filter(([h]) => nav.some(([x]) => x === h)).reduce((n, [, v]) => n + v, 0);
const isCurrent = (h: string) => path === h || (h !== '/admin' && path.startsWith(h + '/')) || (h !== '/admin' && path === h);

// Périmètre affiché (lecture seule) : toute l'organisation, ou les pays d'un responsable pays
const scope = await countriesFor(me, obj).catch(() => null);
const scopeLabel = scope ? (scope.length ? scope.map((x) => country(x)).join(', ') : 'Aucun pays attribué') : 'Toute l’organisation';
---
<BaseLayout title={`${title} — CEA OS`} os>
  <div class="os-shell">
    <nav class="os-side side" id="sideNav" aria-label="Navigation CEA OS">
      <a class="os-logo" href="/admin"><img src="/logo.png" alt="CEA FOR AFRICA" width="68" height="38" /><span>CEA OS<small>Connecter • Entreprendre • Accélérer</small></span></a>
      <button class="side-toggle" type="button" data-side-toggle aria-controls="sideNav" aria-pressed="false"><span class="st-open">‹ Réduire le menu</span><span class="st-closed" aria-hidden="true">›</span></button>
      <div class="side-body" id="sideBody">
        {groups.map(([g, items]) => (
          <>
            <h6>{g}</h6>
            {items.map(([href, label]) => <a href={href} title={label} aria-current={isCurrent(href) ? 'page' : undefined}><Icon name={ADMIN_ICON[href] ?? 'info'} size={18} /><span class="sl">{label}</span>{COUNT[href] ? <span class="cnt" aria-label={`${COUNT[href]} à traiter`}>{COUNT[href]}</span> : null}</a>)}
          </>
        ))}
        <h6>Raccourcis</h6>
        <a href="/espace" title="Mon espace"><Icon name="back" size={18} /><span class="sl">Mon espace</span></a>
        <a href="/" title="Site public"><Icon name="home" size={18} /><span class="sl">Site public</span></a>
      </div>
      <div class="os-foot">
        <span class="sl"><b>{me.name}</b><br />{roles}</span>
        <div class="row" style="gap:6px;margin-top:8px"><button class="os-ghost" type="button" id="themeBtn" title="Thème clair / sombre">Thème</button><button class="os-ghost" type="button" data-logout title="Se déconnecter">Déconnexion</button></div>
      </div>
    </nav>
    <div class="os-main">
      <header class="os-top">
        <button class="os-ib os-menu" type="button" data-os-menu aria-controls="sideNav" aria-expanded="false" aria-label="Ouvrir la navigation">☰</button>
        <div class="os-scope" title="Périmètre des données affichées"><b>Périmètre</b><span>{scopeLabel}</span></div>
        <div class="os-grow"></div>
        <button class="os-ib" type="button" id="searchBtn" aria-label="Rechercher (Ctrl+K)">⌕ <span class="hide-s">Rechercher</span></button>
        <a class="os-ib" href="/admin" aria-label={`À traiter : ${todo}`} title="À traiter">✓{todo > 0 && <span class="badge">{todo > 99 ? '99+' : todo}</span>}</a>
        <a class="os-ib" href="/espace/notifications" aria-label="Notifications">🔔<span class="badge" data-unread hidden></span></a>
        <button class="os-ib" type="button" onclick="openChat()" aria-label="Ouvrir CEA Copilot">✦ <span class="hide-s">Copilot</span></button>
        <a class="os-user" href="/espace/profil" title="Mon profil"><span class="av">{initials}</span><span class="t hide-s">{me.name}</span></a>
      </header>
      <div class="os-content">
        <div class="ph">
          <div>
            <div class="crumbs"><a href="/admin">CEA OS</a>{path !== '/admin' && <> / {title}</>}</div>
            <h1>{title}</h1>
            {lead && <p>{lead}</p>}
          </div>
        </div>
        {allowed && <RightsHint objs={hints} />}
        {allowed ? <slot /> : <div class="empty">Vous n’avez pas accès à cette rubrique.</div>}
      </div>
    </div>
  </div>
</BaseLayout>
<script>
  // Menu latéral sur téléphone et tablette : tiroir ouvert par ☰, fermé par un lien ou un clic à côté
  const side = document.getElementById('sideNav');
  const btn = document.querySelector<HTMLButtonElement>('[data-os-menu]');
  const set = (open: boolean) => { side?.classList.toggle('open', open); btn?.setAttribute('aria-expanded', String(open)); };
  btn?.addEventListener('click', (e) => { e.stopPropagation(); set(!side?.classList.contains('open')); });
  side?.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
  document.addEventListener('click', (e) => { if (side?.classList.contains('open') && !side.contains(e.target as Node)) set(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
