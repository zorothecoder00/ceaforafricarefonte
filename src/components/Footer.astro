---
import { getLang, lp, useT } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const en = lang === 'en';
const t = useT(lang);
const L = (p: string) => lp(lang, p);
const btn = 'color:#B8C7D8;border-color:#2A4A6B';
// Colonnes du pied de page, dans l'ordre du prototype
const domaines: [string, string][] = [
  ['/a-propos', en ? 'About' : 'À propos'], ['/programmes', 'CEA Accelerator'], ['/academie', 'CEA Academy'], ['/projets', 'CEA Project Studio'],
  ['/evenements', 'CEA Events'], ['/opportunites', 'CEA Talents'], ['/communaute', 'CEA Network'], ['/voix', en ? 'CEA Entrepreneurs’ Voice' : 'CEA Voix des Entrepreneurs'],
  ['/impact', 'CEA Impact Lab'], ['/domaines/btp', en ? 'CEA Construction & Infrastructure' : 'CEA BTP & Infrastructures'], ['/monde', en ? 'View on the world' : 'Vue sur le monde'],
  ['/representants', en ? 'Country representatives' : 'Représentants pays'], ['/inscription', en ? 'Entrepreneur registration' : 'Inscription des entrepreneurs'],
];
const kapital: [string, string][] = en
  ? [['/kapital', 'Kapital home'], ['/kapital/opportunites', 'Opportunities'], ['/kapital/marches', 'African exchanges'], ['/kapital/capital-risque', 'Venture capital'], ['/kapital/obligations', 'Capital markets'], ['/kapital/risques', 'Risks']]
  : [['/kapital', 'Accueil Kapital'], ['/kapital/opportunites', 'Opportunités'], ['/kapital/marches', 'Bourses africaines'], ['/kapital/capital-risque', 'Capital-risque'], ['/kapital/obligations', 'Marché des capitaux'], ['/kapital/risques', 'Risques']];
const confiance: [string, string][] = [
  ['/contact', t('contact')], ['/legal/confidentialite', t('privacy')], ['/legal/cookies', t('cookies')], ['/legal/conditions', t('terms')],
  ['/legal/accessibilite', t('a11y')], ['/aide', t('help')], ['/statut', en ? 'Platform status' : 'Statut de la plateforme'], ['/admin', en ? 'Back office (demo)' : 'Back-office (démo)'],
];
---
<footer class="foot">
  <div class="wrap">
    <div class="footk">
      <div><span class="xs" style="font-family:var(--display);font-weight:800;letter-spacing:.08em">CEA KAPITAL INVEST</span><br /><b>{t('fkTitle')}</b></div>
      <div class="row"><a class="kbtn" href={L('/kapital/diagnostic')}>{t('fkDiag')}</a><a class="btn btn-ghost" href={L('/kapital/devenir-investisseur')}>{t('fkInv')}</a></div>
    </div>
    <div class="grid g4">
      <div>
        <h4>CEA FOR AFRICA</h4>
        <p class="small"><span class="tagline" style="display:block;margin-bottom:6px">{en ? 'Connect • Build • Accelerate' : 'Connecter • Entreprendre • Accélérer'}</span>{en ? 'The platform for African entrepreneurs, from Dakar to Nairobi.' : 'La plateforme des entrepreneurs africains, de Dakar à Nairobi.'}</p>
        <div class="row small" style="gap:6px">
          <button class="btn btn-ghost btn-sm" type="button" id="themeBtn" style={btn}>{t('theme')}</button>
          <button class="btn btn-ghost btn-sm" type="button" id="liteBtn" style={btn} aria-pressed="false">{t('lite')}</button>
          <button class="btn btn-ghost btn-sm" type="button" id="fsBtn" style={btn}>{t('textSize')}</button>
        </div>
      </div>
      <div>
        <h4>{en ? 'Our areas of work' : "Nos domaines d'intervention"}</h4>
        {domaines.map(([h, l]) => <a href={L(h)}>{l}</a>)}
      </div>
      <div>
        <h4>CEA Kapital Invest</h4>
        {kapital.map(([h, l]) => <a href={L(h)}>{l}</a>)}
      </div>
      <div>
        <h4>{t('trust')}</h4>
        {confiance.map(([h, l]) => <a href={h === '/admin' ? h : L(h)}>{l}</a>)}
      </div>
    </div>
  </div>
</footer>
