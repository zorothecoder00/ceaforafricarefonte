---
/* Fiche de poste du référentiel (prototype › ficheHTML) : raison d'être, missions, pouvoir de décision ; en version complète,
   indicateurs du référentiel, profil, livrables. */
import { poste } from '../../lib/os/ref';
interface Props { code: string; full?: boolean }
const { code, full } = Astro.props;
const f = poste(code);
---
{f ? (
  <div class="card">
    <div><span class="tag gold">{f.c}</span> <b style="font-family:var(--display);font-size:1.05rem">{f.t}</b><div class="small muted">{f.fam} · {f.g} · N+1 : {f.n1}</div></div>
    <p style="margin-top:10px">{f.r}</p>
    <h3>Missions</h3>
    {f.m.map(([a, i]) => <><p class="small" style="margin:6px 0 2px"><b>{a}</b></p><ul class="small" style="margin:0 0 6px;padding-left:18px">{i.map((x) => <li>{x}</li>)}</ul></>)}
    <h3>Pouvoir de décision</h3>
    <ul class="small" style="padding-left:18px">{f.d.map((x) => <li>{x}</li>)}</ul>
    {full && (
      <>
        <h3>Indicateurs du référentiel</h3>
        <div class="tw"><table class="t"><tbody>{f.k.map((k) => <tr><td>{k[0]}</td><td class="num"><b>{k[1]}</b></td></tr>)}</tbody></table></div>
        <h3 style="margin-top:12px">Profil</h3>
        <p class="small">{f.fo} · {f.x}<br />{f.tech.join(' · ')}</p>
        <p class="small"><b>Livrables :</b> {f.l}</p>
      </>
    )}
    <p class="small"><b>Évolution possible :</b> {f.e}</p>
  </div>
) : <p class="muted">Fiche introuvable.</p>}
