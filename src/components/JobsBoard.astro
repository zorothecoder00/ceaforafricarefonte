---
/* Tableau des offres (CDC §7.4) : recherche, filtres, alertes ; compétences du profil surlignées. */
import JobCard from './JobCard.astro';
import KapitalAd from './KapitalAd.astro';
import { country } from '../data/site';
import { mySkills, type JobRow } from '../lib/jobs';
interface Props { jobs: JobRow[] }
const { jobs } = Astro.props;
const me = Astro.locals.user;
const skills = await mySkills(me?.id);
const types = [...new Set(jobs.map((j) => j.type))];
const countries = [...new Set(jobs.map((j) => j.c))];
---
<section class="block" style="padding-top:20px">
  <div class="wrap" data-jobs>
    <div class="filters">
      <input class="in" data-f="q" placeholder="Métier, compétence, entreprise" aria-label="Rechercher une offre" style="flex:1;min-width:220px" />
      <select class="in" data-f="c" aria-label="Pays"><option value="">Tous les pays</option>{countries.map((c) => <option value={c}>{country(c)}</option>)}</select>
      <select class="in" data-f="type" aria-label="Type de contrat"><option value="">Tous les contrats</option>{types.map((t) => <option>{t}</option>)}</select>
      <label class="chip"><input type="checkbox" data-f="remote" /> Télétravail</label>
      {me && <button class="btn btn-ghost btn-sm" type="button" data-alert>Créer une alerte</button>}
    </div>
    <div class="split">
      <div>
        <p class="small muted" data-count>{jobs.length} offre{jobs.length > 1 ? 's' : ''}</p>
        <div data-list>{jobs.map((j) => <JobCard j={j} mine={skills} />)}</div>
        <div class="empty" data-empty hidden={jobs.length > 0}>Aucune offre ne correspond. Retirez un filtre ou créez une alerte.</div>
      </div>
      <aside>
        <KapitalAd variant={0} />
        <div class="panel" style="margin-top:16px"><h3>Votre profil talent</h3><p class="small muted">{skills.length ? `${skills.length} compétences renseignées : elles sont surlignées dans les offres.` : 'Renseignez vos compétences pour voir votre correspondance avec chaque offre.'}</p><a class="btn btn-ghost btn-sm" href="/opportunites/profil">Mon profil talent</a></div>
      </aside>
    </div>
  </div>
</section>
<script>
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  document.querySelectorAll<HTMLElement>('[data-jobs]').forEach((root) => {
    const f = (k: string) => root.querySelector<HTMLInputElement>(`[data-f="${k}"]`)!;
    const apply = () => {
      let n = 0;
      root.querySelectorAll<HTMLElement>('[data-list] > .panel').forEach((el) => {
        const ok = (!f('c').value || el.dataset.c === f('c').value) && (!f('type').value || el.dataset.type === f('type').value) && (!f('remote').checked || el.dataset.remote === '1') && norm(el.dataset.q!).includes(norm(f('q').value));
        el.hidden = !ok;
        if (ok) n++;
      });
      root.querySelector('[data-count]')!.textContent = `${n} offre${n > 1 ? 's' : ''}`;
      root.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
    };
    root.querySelectorAll('[data-f]').forEach((x) => x.addEventListener('input', apply));
    root.querySelector('[data-alert]')?.addEventListener('click', async () => {
      const res = await fetch('/api/emplois', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'alerte', q: f('q').value || undefined, country: f('c').value || undefined, type: f('type').value || undefined, remote: f('remote').checked || undefined }) });
      const d = await res.json().catch(() => ({}));
      (window as unknown as { toast: (t: string) => void }).toast(d.message || d.error || 'Erreur.');
    });
    const q = new URLSearchParams(location.search).get('q');
    if (q) { f('q').value = q; apply(); }
  });
</script>
