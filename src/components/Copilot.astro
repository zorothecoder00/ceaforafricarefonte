---
/* Bouton d'assistance flottant (CDC §5.3) : CEA Copilot, avec accès direct au centre d'aide, à WhatsApp (si le numéro est
   renseigné dans Administration système › Réseaux sociaux) et au formulaire de contact. */
import { getLang, useT } from '../i18n/ui';
import { getSetting } from '../lib/settings';
import LiveChat from './LiveChat.astro';
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const en = lang === 'en';
const whatsapp = (await getSetting('reseaux').catch(() => null))?.whatsapp ?? '';
---
<button class="fab" id="fab" type="button" aria-expanded="false" aria-controls="chat"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>CEA Copilot</button>
<section class="chat" id="chat" aria-label="CEA Copilot" data-lang={lang}>
  <div class="chat-h">
    <div><b style="font-family:var(--display)">CEA Copilot</b><div class="small muted">{t('copSub')}</div></div>
    <button class="icon-btn" id="chatClose" type="button" aria-label={t('close')}>✕</button>
  </div>
  <nav class="chat-alt" aria-label={en ? 'Other ways to get help' : "Autres moyens d'obtenir de l'aide"}>
    <a href={en ? '/en/aide' : '/aide'}>{en ? 'Help centre' : "Centre d'aide"}</a>
    {whatsapp && <a href={whatsapp} target="_blank" rel="noopener">WhatsApp</a>}
    <a href={en ? '/en/contact' : '/contact'} data-live-open>{en ? 'Chat with the team' : "Discuter avec l'équipe"}</a>
  </nav>
  <div class="chat-b" id="chatBody" aria-live="polite"><div class="msg a">{t('copHello')}</div></div>
  <div class="sugg" id="sugg">{t('sugg').split('|').map((s) => <button type="button">{s}</button>)}</div>
  <form class="chat-f" id="chatForm">
    <input id="chatIn" placeholder={t('copAsk')} aria-label={t('copAsk')} autocomplete="off" />
    <button class="btn btn-primary btn-sm" type="submit">{t('send')}</button>
  </form>
</section>
<LiveChat />
<dialog id="dlg">
  <div class="dlg-h"><h3 id="dlgTitle">{lang === 'en' ? 'Search' : 'Rechercher'}</h3><button class="icon-btn" type="button" id="dlgClose" aria-label={t('close')}>✕</button></div>
  <div class="dlg-b" id="dlgBody">
    <input class="in" id="sq" placeholder={t('searchPh')} aria-label={lang === 'en' ? 'Search' : 'Rechercher'} autocomplete="off" />
    <div class="row" id="sfil" role="group" aria-label={lang === 'en' ? 'Filter by type' : 'Filtrer par type'} style="gap:6px;flex-wrap:wrap;margin:10px 0 4px"></div>
    <div class="row" id="sfil2" style="gap:6px;flex-wrap:wrap;margin:6px 0 4px">
      <select class="in" id="sCountry" aria-label={lang === 'en' ? 'Filter by country' : 'Filtrer par pays'} style="width:auto;padding:6px 10px"></select>
      <select class="in" id="sSector" aria-label={lang === 'en' ? 'Filter by sector or topic' : 'Filtrer par secteur ou thème'} style="width:auto;padding:6px 10px"></select>
      <select class="in" id="sDate" aria-label={lang === 'en' ? 'Filter by date' : 'Filtrer par date'} style="width:auto;padding:6px 10px">
        <option value="">{lang === 'en' ? 'Any date' : 'Toutes les dates'}</option>
        <option value="next">{lang === 'en' ? 'Upcoming' : 'À venir'}</option>
        <option value="30">{lang === 'en' ? 'Last 30 days' : '30 derniers jours'}</option>
        <option value="365">{lang === 'en' ? 'Last 12 months' : '12 derniers mois'}</option>
      </select>
    </div>
    <div class="search-res" id="sres"></div>
  </div>
</dialog>
<div class="toast" id="toast" role="status"></div>
