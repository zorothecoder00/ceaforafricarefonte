---
/* Sélecteur pays · langue · devise (CDC §5.3). Les choix sont synchronisés entre l'en-tête et le menu mobile par src/scripts/app.ts.
   inline = champs seuls (menu mobile) ; sinon bouton + fenêtre (en-tête).
   Pays, langues et devises proposés, taux et leur source : Paramétrage › Pays, langues, devises (src/lib/localisation.ts). */
import { getLang, useT } from '../i18n/ui';
import { getLocalisation, LANGUAGES } from '../lib/localisation';

interface Props { id?: string; inline?: boolean }
const { id, inline = false } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const loc = await getLocalisation();
const countries = loc.countries.filter((c) => c.active);
const currencies = loc.currencies.filter((c) => c.active);
const date = new Date(`${loc.ratesDate}T00:00:00Z`).toLocaleDateString(lang === 'en' ? 'en-GB' : 'fr-FR', { timeZone: 'UTC' });
const note = lang === 'en'
  ? `Indicative conversion. Rates as of ${date} (${loc.ratesSource}) — fixed BCEAO/BEAC peg for CFA francs.`
  : `Conversion indicative. Taux du ${date} (${loc.ratesSource}) — parité fixe BCEAO/BEAC pour le FCFA.`;
---
{!inline && (
  <div class="loc">
    <button class="loc-btn" type="button" aria-expanded="false" aria-controls={id} aria-label={t('locTitle')} data-loc-btn>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
      <span class="loc-txt" data-loc-txt>{lang.toUpperCase()} · FCFA</span>
    </button>
    <div class="loc-pop" id={id} hidden>
      <b style="display:block;margin-bottom:10px">{t('locTitle')}</b>
      <label class="f">{t('country')}<select class="in" data-loc="country"><option value="">{t('otherCountry')}</option>{countries.map((c) => <option value={c.code}>{c.name}</option>)}</select></label>
      <label class="f">{t('language')}<select class="in" data-loc="lang">{LANGUAGES.map((l) => <option value={l.code} selected={lang === l.code} disabled={!l.ready || (l.code === 'en' && !loc.english)}>{l.name}{'phase' in l ? ` (${l.phase})` : ''}</option>)}</select></label>
      <label class="f">{t('currency')}<select class="in" data-loc="cur">{currencies.map((c) => <option value={c.code}>{c.code} — {c.name[lang]}</option>)}</select></label>
      <p class="xs muted" style="margin:0">{note}</p>
    </div>
  </div>
)}
{inline && (
  <>
    <b>{t('locTitle')}</b>
    <label class="f">{t('country')}<select class="in" data-loc="country"><option value="">{t('otherCountry')}</option>{countries.map((c) => <option value={c.code}>{c.name}</option>)}</select></label>
    <label class="f">{t('language')}<select class="in" data-loc="lang">{LANGUAGES.map((l) => <option value={l.code} selected={lang === l.code} disabled={!l.ready || (l.code === 'en' && !loc.english)}>{l.name}{'phase' in l ? ` (${l.phase})` : ''}</option>)}</select></label>
    <label class="f">{t('currency')}<select class="in" data-loc="cur">{currencies.map((c) => <option value={c.code}>{c.code} — {c.name[lang]}</option>)}</select></label>
    <p class="xs muted" style="margin:0">{note}</p>
  </>
)}
