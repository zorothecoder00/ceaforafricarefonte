---
/* Encadré « fonction soumise à agrément » : affiché tant que la fonction n'est pas ouverte dans le pays (CDC §8.11).
   Lit les interrupteurs en base ; pays : celui du profil du visiteur, sinon le Togo (pays du siège). */
import { eq } from 'drizzle-orm';
import Icon from './Icon.astro';
import { db } from '../lib/db';
import { profile } from '../db/schema/app';
import { isOpen } from '../lib/kapital';
import { country as countryName } from '../data/site';

interface Props { feature: string; text?: string; country?: string }
const { feature, text = "Cette fonction sera ouverte pays par pays, après obtention des autorisations ou via un partenaire agréé." } = Astro.props;
const me = Astro.locals.user;
const [p] = me ? await db.select({ c: profile.country }).from(profile).where(eq(profile.userId, me.id)) : [];
const c = Astro.props.country ?? p?.c ?? 'TG';
const open = await isOpen(feature, c);
---
{!open && (
  <div class="lock">
    <Icon name="lock" size={22} />
    <div><b>Fonction soumise à agrément</b><br />{text} Statut pour {countryName(c)} : <b>non ouverte</b>. <a href="/kapital/conformite">Voir l'ouverture par pays</a></div>
  </div>
)}
