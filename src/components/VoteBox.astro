---
import { dateFr } from '../data/site';
interface Props { v: { id: string; t: string; c: string; close: string; o: (string | number)[][] }; lang?: 'fr' | 'en' }
const { v, lang = 'fr' } = Astro.props;
const en = lang === 'en';
const total = 0; // résultats réels chargés depuis /api/votes
---
<div class="panel" data-vote={v.id}>
  <div class="row between"><span class="tag info">{v.c}</span><span class="xs muted">{en ? 'Closes' : 'Clôture le'} {en ? new Date(v.close).toLocaleDateString('en-GB') : dateFr(v.close)}</span></div>
  <h3 style="margin:10px 0 14px">{v.t}</h3>
  {v.o.map(([label, n]) => (
    <button class="vote-opt" type="button"><span class="bar" style="width:0"></span><span>{label}</span><span class="pct small" style="float:right"></span></button>
  ))}
  <p class="xs muted" style="margin:6px 0 0"><span class="vote-total">{total.toLocaleString('fr-FR')}</span> {en ? 'participants · one vote per member' : 'participants · un vote par membre'}</p>
</div>
