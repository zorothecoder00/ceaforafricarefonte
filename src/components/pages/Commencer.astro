---
/* « Par où commencer ? » : orientation en 5 questions (CDC §11), puis premières étapes selon le profil déclaré (CDC §5.3). */
import PageHead from '../PageHead.astro';
import Icon from '../Icon.astro';
import { lp, type Lang } from '../../i18n/ui';
import { QUESTIONS } from '../../lib/orientation';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const L = (p: string) => lp(lang, p);
type Step = [string, string, string];
const profiles: { id: string; ic: string; t: string; d: string; steps: Step[] }[] = [
  {
    id: 'entrepreneur', ic: 'rocket', t: en ? 'I am an entrepreneur' : 'Je suis entrepreneur',
    d: en ? 'From idea to growth: learn, get structured, get funded.' : "De l'idée à la croissance : apprendre, se structurer, se financer.",
    steps: [
      ['/academie', en ? 'Take a free course' : 'Suivre un cours gratuit', en ? 'Start with the basics, on your phone.' : 'Commencez par les bases, sur votre téléphone.'],
      ['/kapital/diagnostic', en ? 'Take the maturity diagnostic' : 'Faire le diagnostic de maturité', en ? '8 questions, a score out of 100.' : '8 questions, un score sur 100.'],
      ['/programmes', en ? 'Join a programme' : 'Rejoindre un programme', en ? 'Incubation, acceleration, Investor Ready.' : 'Incubation, accélération, Investor Ready.'],
      ['/communaute/mentorat', en ? 'Find a mentor' : 'Trouver un mentor', en ? 'Verified mentors across the continent.' : 'Des mentors vérifiés sur tout le continent.'],
    ],
  },
  {
    id: 'investisseur', ic: 'fund', t: en ? 'I am an investor' : 'Je suis investisseur',
    d: en ? 'Verified opportunities and African market data.' : 'Des opportunités vérifiées et les données des marchés africains.',
    steps: [
      ['/kapital', en ? 'Discover CEA Kapital Invest' : 'Découvrir CEA Kapital Invest', en ? 'The pan-African financial portal.' : 'Le portail financier panafricain.'],
      ['/kapital/risques', en ? 'Read the investment risks' : "Lire les risques de l'investissement", en ? 'Before anything else.' : 'Avant toute chose.'],
      ['/kapital/devenir-investisseur', en ? 'Get verified' : 'Me faire vérifier', en ? 'Identity check and investor profile.' : "Vérification d'identité et profil investisseur."],
      ['/kapital/opportunites', en ? 'Browse opportunities' : 'Parcourir les opportunités', en ? 'Files reviewed by our analysts.' : 'Des dossiers revus par nos analystes.'],
    ],
  },
  {
    id: 'partenaire', ic: 'hand', t: en ? 'I am a partner' : 'Je suis partenaire',
    d: en ? 'Donor, bank, foundation, ministry: co-build and measure impact.' : "Bailleur, banque, fondation, ministère : co-construire et mesurer l'impact.",
    steps: [
      ['/impact', en ? 'See our impact' : 'Voir notre impact', en ? 'Sourced, dated figures.' : 'Des chiffres sourcés et datés.'],
      ['/a-propos/transparence', en ? 'Read our reports' : 'Lire nos rapports', en ? 'Annual and impact reports.' : "Rapports annuels et d'impact."],
      ['/evenements/organiser', en ? 'Sponsor an event' : 'Soutenir un événement', en ? 'Sponsoring packages.' : 'Offres de sponsoring.'],
      ['/contact', en ? 'Talk to the partnerships team' : "Parler à l'équipe partenariats", en ? 'We reply within 2 working days.' : 'Réponse sous 2 jours ouvrés.'],
    ],
  },
  {
    id: 'talent', ic: 'job', t: en ? 'I am looking for a job' : 'Je cherche un emploi',
    d: en ? 'Jobs, internships and missions in African companies.' : 'Emplois, stages et missions dans des entreprises africaines.',
    steps: [
      ['/opportunites/profil', en ? 'Create my talent profile' : 'Créer mon profil talent', en ? 'Import your CV, choose who sees it.' : 'Importez votre CV, choisissez qui le voit.'],
      ['/opportunites', en ? 'Browse offers' : 'Parcourir les offres', en ? 'Matching skills are highlighted.' : 'Les compétences correspondantes sont surlignées.'],
      ['/opportunites/diaspora', en ? 'Diaspora opportunities' : 'Opportunités diaspora', en ? 'Remote roles and missions.' : 'Télétravail et missions.'],
      ['/academie', en ? 'Train to close the gap' : "Me former pour combler l'écart", en ? 'Courses matched to the offers.' : 'Des cours liés aux offres.'],
    ],
  },
];
---
<PageHead lang={lang} title={en ? 'Where to start?' : 'Par où commencer ?'} lead={en ? 'Choose the profile that fits you: we show you the first steps.' : 'Choisissez le profil qui vous ressemble : nous vous montrons les premières étapes.'} crumbs={[['', en ? 'Where to start?' : 'Par où commencer ?']]} />
<section class="block" style="padding-bottom:0">
  <div class="wrap" style="max-width:820px">
    <form class="panel" id="orientF" data-lang={lang}>
      <h2 style="margin-top:0;font-size:1.3rem">{en ? 'Get oriented in 5 questions' : 'Votre parcours en 5 questions'}</h2>
      <p class="small muted" style="margin-top:-4px">{en ? 'Answer 5 questions: CEA Copilot recommends a programme, a course, a mentor or a funding route.' : 'Répondez à 5 questions : CEA Copilot vous recommande un programme, une formation, un mentor ou une piste de financement.'}</p>
      {QUESTIONS.map((q, i) => (
        <fieldset style="border:0;padding:0;margin:14px 0 0">
          <legend class="f" style="padding:0"><b>{i + 1}. {en ? q.en : q.fr}</b></legend>
          <div class="row" style="gap:6px;flex-wrap:wrap;margin-top:6px">
            {q.opts.map((o) => <label class="chip" style="display:inline-flex;gap:6px;align-items:center"><input type="radio" name={q.k} value={o.v} required />{en ? o.en : o.fr}</label>)}
          </div>
        </fieldset>
      ))}
      <label class="f" for="orNote" style="margin-top:14px">{en ? 'In one sentence, your project (optional)' : 'En une phrase, votre projet (facultatif)'}</label>
      <input class="in" id="orNote" name="note" maxlength="500" placeholder={en ? 'E.g. I process cassava into flour in Lomé' : 'Ex. Je transforme le manioc en farine à Lomé'} />
      <button class="btn btn-primary" type="submit" style="margin-top:14px">{en ? 'See my recommendations' : 'Voir mes recommandations'}</button>
      <div id="orRes" aria-live="polite" style="margin-top:16px"></div>
    </form>
  </div>
</section>
<script>
  /* Orientation : envoi des 5 réponses, affichage du parcours recommandé (IA ou, à défaut, règles) */
  const f = document.getElementById('orientF') as HTMLFormElement | null;
  const out = document.getElementById('orRes')!;
  const en = f?.dataset.lang === 'en';
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const KIND: Record<string, [string, string]> = { programme: ['Programme', 'Programme'], cours: ['Formation', 'Training'], mentor: ['Mentor', 'Mentor'], financement: ['Financement', 'Funding'] };
  f?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(f);
    const answers = Object.fromEntries(['stade', 'besoin', 'secteur', 'fonds', 'cible'].map((k) => [k, fd.get(k)]));
    const btn = f.querySelector<HTMLButtonElement>('[type="submit"]')!;
    btn.disabled = true;
    out.innerHTML = `<p class="small muted">${en ? 'Preparing your path…' : 'Préparation de votre parcours…'}</p>`;
    const r = await fetch('/api/orientation', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ answers, note: String(fd.get('note') ?? '') || undefined, lang: en ? 'en' : 'fr' }) }).catch(() => null);
    const d = r ? await r.json().catch(() => null) : null;
    btn.disabled = false;
    if (!d?.ok) { out.innerHTML = `<p class="small">${esc(d?.error ?? (en ? 'Network error, please try again.' : 'Erreur réseau, réessayez.'))}</p>`; return; }
    const href = (u: string) => (en ? '/en' + u : u);
    out.innerHTML = `<p>${esc(d.summary)}</p><ol class="timeline">${d.recs.map((x: { kind: string; title: string; url: string; desc: string; why: string }, i: number) =>
      `<li class="${i === 0 ? 'cur' : ''}"><span class="tag info">${KIND[x.kind]?.[en ? 1 : 0] ?? ''}</span> <a href="${href(x.url)}"><b>${esc(x.title)}</b></a><div class="small">${esc(x.why)}</div><div class="xs muted">${esc(x.desc)}</div></li>`).join('')}</ol>`
      + `<p class="xs muted" style="margin-top:8px">${d.ai ? (en ? 'Recommendations generated by AI from the CEA catalogue. They are suggestions: admission and funding decisions are made by the CEA team.' : "Recommandations générées par IA à partir du catalogue de CEA. Ce sont des suggestions : l'admission et le financement sont décidés par l'équipe CEA.") : (en ? 'Recommendations based on your answers. Admission and funding decisions are made by the CEA team.' : "Recommandations établies à partir de vos réponses. L'admission et le financement sont décidés par l'équipe CEA.")} <a href="${href('/ia')}">${en ? 'About AI at CEA' : "L'IA chez CEA"}</a></p>`;
    out.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>
<section class="block">
  <div class="wrap">
    <div class="filters">{profiles.map((p) => <a class="chip" href={`#${p.id}`}>{p.t}</a>)}</div>
    <div class="grid g2">
      {profiles.map((p) => (
        <div class="panel" id={p.id} style="scroll-margin-top:140px">
          <div class="row"><span class="ic" style="width:42px;height:42px;border-radius:10px;background:var(--gold-soft);color:var(--gold-ink);display:flex;align-items:center;justify-content:center"><Icon name={p.ic} size={22} /></span><h2 style="margin:0;font-size:1.3rem">{p.t}</h2></div>
          <p class="muted" style="margin:10px 0 14px">{p.d}</p>
          <ol class="timeline">{p.steps.map(([h, t, d], i) => <li class={i === 0 ? 'cur' : ''}><a href={L(h)}><b>{t}</b></a><div class="small muted">{d}</div></li>)}</ol>
        </div>
      ))}
    </div>
    <p class="small muted" style="margin-top:20px">{en ? 'Still unsure? Ask CEA Copilot (bottom right) or ' : 'Toujours un doute ? Demandez à CEA Copilot (en bas à droite) ou '}<a href={L('/contact')}>{en ? 'contact us' : 'contactez-nous'}</a>.</p>
  </div>
</section>
