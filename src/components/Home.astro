---
/* Page d'accueil, calquée sur le prototype de design ; partagée par / et /en/. */
import AfricaMap from './AfricaMap.astro';
import Ticker from './Ticker.astro';
import Icon from './Icon.astro';
import DomainCard from './DomainCard.astro';
import ArticleCard from './ArticleCard.astro';
import EventRow from './EventRow.astro';
import VoteBox from './VoteBox.astro';
import { HUBS, country } from '../data/site';
import { tr } from '../i18n/content-en';
import { lp, type Lang } from '../i18n/ui';
import { programmeCatalogue } from '../lib/calls';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const L = (p: string) => lp(lang, p);
const c = tr(lang);
const members = HUBS.reduce((a, h) => a + h.m, 0);
const projects = HUBS.reduce((a, h) => a + h.p, 0);
const nextEv = [...c.events].sort((a, b) => a.date.localeCompare(b.date)).slice(0, 3);
const freeCourses = c.courses.filter((x) => !x.price).slice(0, 3);
const w = (fr: string, e: string) => (en ? e : fr);
const score: [string, number][] = [[w('Équipe', 'Team'), 5], ['Traction', 4], [w('Finances', 'Finance'), 4], [w('Gouvernance', 'Governance'), 3]];
const partners = en ? ['Partner bank', 'Foundation', 'Donor', 'University', 'Incubator', 'Mobile operator'] : ['Banque partenaire', 'Fondation', 'Bailleur', 'Université', 'Incubateur', 'Opérateur mobile'];
// Appel à candidatures mis en avant : l'appel ouvert qui clôt le plus tôt, sinon la prochaine ouverture (catalogue + appels du back-office)
const catalogue = await programmeCatalogue().catch(() => []);
const call = catalogue.find((p) => p.state === 'ouvert') ?? catalogue.find((p) => p.state === 'a_venir');
const callDate = (d: Date) => d.toLocaleDateString(en ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const topics = en ? ['Funding', 'Training', 'Events', 'Kapital Invest'] : ['Financement', 'Formation', 'Événements', 'Kapital Invest'];
---
<!-- Héros : texte à gauche, carte de l'Afrique à droite, puis les chiffres -->
<section class="hero">
  <div class="wrap hg">
    <div>
      <p class="tagline" style="margin-bottom:14px">{w('Connecter • Entreprendre • Accélérer', 'Connect • Build • Accelerate')}</p>
      <h1>{w('Les entrepreneurs africains,', 'African entrepreneurs,')}<span class="l2">{w('ensemble.', 'together.')}</span></h1>
      <p class="lead">{w("Apprendre, se structurer, se financer, recruter et peser collectivement : tout l'écosystème de CEA FOR AFRICA, dans 16 pays.", 'Learn, get structured, raise funds, hire and carry weight together: the whole CEA FOR AFRICA ecosystem, in 16 countries.')}</p>
      <div class="persona">
        <a href={L('/inscription')}><span>{w('Je suis entrepreneur', 'I am an entrepreneur')}<small>{w('Inscrire mon entreprise dans mon pays', 'Register my business in my country')}</small></span><span aria-hidden="true">›</span></a>
        <a href={L('/kapital')} class="kp"><span>{w('Je suis investisseur', 'I am an investor')}<small>{w('CEA Kapital Invest : opportunités vérifiées et marchés africains', 'CEA Kapital Invest: verified opportunities and African markets')}</small></span><span aria-hidden="true" style="color:var(--gold)">›</span></a>
        <a href={L('/communaute')}><span>{w('Je suis partenaire ou mentor', 'I am a partner or mentor')}<small>{w('Co-construire et transmettre', 'Co-build and pass on')}</small></span><span aria-hidden="true">›</span></a>
      </div>
    </div>
    <AfricaMap />
  </div>
  <div class="stats-band">
    <div class="wrap">
      <div class="stat"><b data-count={members}>{members.toLocaleString('fr-FR')}</b><span>{w('membres inscrits', 'registered members')}</span></div>
      <div class="stat"><b data-count={projects}>{projects}</b><span>{w('projets accompagnés', 'projects supported')}</span></div>
      <div class="stat"><b data-count="2340">2 340</b><span>{w('emplois créés et vérifiés', 'jobs created and verified')}</span></div>
      <div class="stat"><b data-count={HUBS.length}>{HUBS.length}</b><span>{w('pays actifs', 'active countries')}</span></div>
    </div>
    <div class="wrap demo-note" style="color:#8FA6BF;padding-bottom:14px">{w('Chiffres de démonstration, au 30 septembre 2026.', 'Demonstration figures, as of 30 September 2026.')} <a href={L('/impact')} style="color:#C9D6E5">{w('Méthodologie', 'Methodology')}</a></div>
  </div>
</section>
<Ticker />

<!-- CEA Kapital Invest -->
<section class="kpromo" aria-label="CEA Kapital Invest">
  <div class="wrap">
    <div>
      <span class="eyebrow"><Icon name="cap" size={18} /> {w('CEA KAPITAL INVEST — le portail financier panafricain', 'CEA KAPITAL INVEST — the pan-African financial portal')}</span>
      <h2 style="margin-top:12px">{w('Votre entreprise mérite des investisseurs. Nous vous y préparons.', 'Your business deserves investors. We get you ready.')}</h2>
      <p style="color:#B9C9DA;font-size:1.1rem;max-width:52ch">{w('Un diagnostic gratuit, un analyste dédié, une data room sécurisée et un comité qui présente les meilleurs dossiers à des investisseurs vérifiés, dans 16 pays.', 'A free diagnostic, a dedicated analyst, a secure data room and a committee that presents the best files to verified investors, in 16 countries.')}</p>
      <div class="kpills">{(en ? ['Fundraising', 'Venture capital', 'Share sales', 'African stock exchanges', 'Capital markets'] : ['Levée de fonds', 'Capital-risque', "Vente d'actions", 'Bourses africaines', 'Marché des capitaux']).map((x) => <span>{x}</span>)}</div>
      <div class="row"><a class="kbtn" href={L('/kapital/diagnostic')} style="padding:13px 22px;font-size:1rem">{w('Faire le diagnostic gratuit', 'Take the free diagnostic')}</a><a class="btn btn-ghost" style="color:#fff;border-color:#2A5079" href={L('/kapital/opportunites')}>{w('Je suis investisseur', 'I am an investor')}</a></div>
      <div class="kstats">
        <div><b>9,8 Md</b><span>{w('FCFA levés par les entreprises accompagnées', 'FCFA raised by supported companies')}</span></div>
        <div><b>150</b><span>{w('dossiers prêts pour les investisseurs', 'investor-ready files')}</span></div>
        <div><b>40</b><span>{w('investisseurs au Demo Day 2026', 'investors at Demo Day 2026')}</span></div>
      </div>
      <p class="xs" style="color:#7F95AD;margin-top:14px">{w('Chiffres de démonstration. Investir comporte un risque de perte en capital.', 'Demonstration figures. Investing carries a risk of capital loss.')}</p>
    </div>
    <div class="kscreen" aria-hidden="true">
      <div class="bar"><i></i><i></i><i></i></div>
      <div class="row between"><b style="font-family:var(--display);color:#fff">{w('Score Investor Ready', 'Investor Ready score')}</b><span class="tag gold">Manioc+</span></div>
      <div style="font-family:var(--display);font-size:3rem;color:#E7BD62;font-weight:800;line-height:1.1;margin:8px 0">78<span style="font-size:1.2rem;color:#9DB0C5">/100</span></div>
      <div class="progress" style="background:#103152"><span style="width:78%"></span></div>
      <div class="grid" style="grid-template-columns:1fr 1fr;gap:8px;margin-top:14px">
        {score.map(([k, n]) => <div style="background:#103152;border-radius:8px;padding:10px"><div class="xs" style="color:#9DB0C5">{k}</div><div style="color:#fff;font-weight:700">{'●'.repeat(n)}<span style="color:#1D4268">{'●'.repeat(5 - n)}</span></div></div>)}
      </div>
      <div style="margin-top:14px;border-top:1px solid #1D4268;padding-top:12px" class="small">
        <div class="row between" style="color:#C9D6E5"><span>{w('Data room consultée par', 'Data room viewed by')}</span><b style="color:#fff">{w('7 investisseurs', '7 investors')}</b></div>
        <div class="row between" style="color:#C9D6E5;margin-top:4px"><span>{w('Prochaine étape', 'Next step')}</span><b style="color:#E7BD62">{w('Comité — 14 oct.', 'Committee — 14 Oct.')}</b></div>
      </div>
    </div>
  </div>
</section>

<!-- Nos domaines -->
<section class="block">
  <div class="wrap">
    <div class="row between"><h2>{w("Nos domaines d'intervention", 'Our areas of work')}</h2><a class="btn btn-ghost btn-sm" href={L('/domaines')}>{w('Tous nos domaines', 'All our areas')}</a></div>
    <div class="grid g4" style="margin-top:18px">{c.domains.map((d) => <DomainCard d={{ ...d, to: L(d.to) }} />)}</div>
  </div>
</section>

<!-- Appel à candidatures : le vrai appel ouvert (ou la prochaine ouverture), masqué s'il n'y en a aucun -->
{call && (
<section class="block" style="padding-top:0">
  <div class="wrap">
    <div class="call">
      <div>
        <span class="tag gold">{call.state === 'ouvert' ? w('Appel à candidatures ouvert', 'Call for applications open') : w('Prochain appel à candidatures', 'Next call for applications')}</span>
        <h2 style="margin-top:10px">{call.title}</h2>
        <p>{call.description}</p>
        {call.canApply ? <a class="btn btn-primary" href={L(call.href)}>{w('Postuler', 'Apply')}</a> : <a class="btn btn-primary" href={L('/programmes')}>{w('Voir les programmes', 'See programmes')}</a>}
      </div>
      {call.state === 'ouvert' && call.closesAt && <div><p class="small muted" style="margin-bottom:6px">{w('Clôture le ', 'Closes on ')}{callDate(call.closesAt)}</p><div class="cd" data-countdown={call.closesAt.toISOString()}></div></div>}
      {call.state === 'a_venir' && call.opensAt && <div><p class="small muted" style="margin-bottom:6px">{w('Ouverture le ', 'Opens on ')}{callDate(call.opensAt)}</p><div class="cd" data-countdown={call.opensAt.toISOString()}></div></div>}
    </div>
  </div>
</section>
)}

<!-- Histoires d'entrepreneurs -->
<section class="block" style="padding-top:0">
  <div class="wrap">
    <div class="row between"><h2>{w("Histoires d'entrepreneurs", 'Entrepreneur stories')}</h2><a class="small" href={L('/ressources')}>{w('Le média CEA', 'CEA media')}</a></div>
    <div class="grid g3">{c.articles.slice(0, 3).map((a) => <ArticleCard a={a} lang={lang} />)}</div>
  </div>
</section>

<!-- Agenda, Académie, Opportunités -->
<section class="block" style="padding-top:0">
  <div class="wrap grid g3">
    <div>
      <div class="row between"><h2>{w('Agenda', 'Calendar')}</h2><a href={L('/evenements')} class="small">{w("Tout l'agenda", 'Full calendar')}</a></div>
      {nextEv.map((e) => <EventRow e={e} lang={lang} />)}
    </div>
    <div>
      <div class="row between"><h2>{w('Académie', 'Academy')}</h2><a href={L('/academie')} class="small">{w('Catalogue', 'Catalogue')}</a></div>
      {freeCourses.map((x) => <a href={L(`/academie/${x.id}`)} class="panel" style="display:block;text-decoration:none;margin-top:12px"><span class="tag ok">{w('Gratuit', 'Free')}</span><b style="display:block;margin-top:6px">{x.t}</b><span class="small muted">{x.dur} · {x.by}</span></a>)}
    </div>
    <div>
      <div class="row between"><h2>{w('Opportunités', 'Opportunities')}</h2><a href={L('/opportunites')} class="small">{w('Toutes les offres', 'All offers')}</a></div>
      {c.jobs.slice(0, 3).map((j) => <a href={L('/opportunites')} class="panel" style="display:block;text-decoration:none;margin-top:12px"><b>{j.t}</b><div class="small muted">{j.co} · {country(j.c)} · {j.type}</div></a>)}
    </div>
  </div>
</section>

<!-- Voix, partenaires, lettre d'information -->
<section class="block" style="padding-top:0">
  <div class="wrap grid g2">
    <div><h2>{w('Votre voix compte', 'Your voice matters')}</h2><VoteBox v={c.consults[0]} lang={lang} /></div>
    <div>
      <h2>{w('Partenaires', 'Partners')}</h2>
      <div class="grid g3" style="grid-template-columns:repeat(3,1fr);gap:10px">{partners.map((p) => <div class="panel small muted" style="text-align:center;padding:18px 8px">{p}<br /><span class="xs">(logo)</span></div>)}</div>
      <form class="panel" style="margin-top:16px;position:relative" data-api="/api/newsletter" data-reset>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px" />
        <h3>{w("Lettre d'information", 'Newsletter')}</h3>
        <p class="small muted">{w('Choisissez vos sujets et votre pays.', 'Choose your topics and your country.')}</p>
        <div class="row" style="margin-bottom:10px">{topics.map((x, i) => <label class="chip"><input type="checkbox" name="topics" value={x} checked={i === 3} /> {x}</label>)}</div>
        <input type="hidden" name="lang" value={lang} />
        <select class="in" name="country" aria-label={w('Pays', 'Country')} style="margin:0 0 10px;max-width:320px"><option value="">{w('Tous les pays', 'All countries')}</option>{HUBS.map((h) => <option value={h.c}>{country(h.c)}</option>)}</select>
        <div class="row"><input class="in" name="email" type="email" required placeholder={w('votre@email.com', 'your@email.com')} aria-label="E-mail" style="flex:1;margin:0;min-width:200px" /><button class="btn btn-primary" type="submit">{w("S'abonner", 'Subscribe')}</button></div>
      </form>
    </div>
  </div>
</section>
