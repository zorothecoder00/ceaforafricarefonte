---
import Icon from './Icon.astro';
import LocalePicker from './LocalePicker.astro';
import { megaOf } from '../data/nav';
import { megaLive } from '../lib/calls';
import { tr } from '../i18n/content-en';
import { getLang, lp, stripLang, useT } from '../i18n/ui';
import { allDomains } from '../lib/domains';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const L = (p: string) => lp(lang, p);
const mega = await megaLive();
const cur = megaOf(stripLang(Astro.url.pathname));
const en = lang === 'en';
const path = stripLang(Astro.url.pathname);
const DOMAINS = await allDomains({ lang: lang === 'en' ? 'en' : 'fr' });

// Barre de navigation sur une seule ligne, dans l'ordre du prototype
const NAV: [string, string, string, string][] = [
  ['/', en ? 'Home' : 'Accueil', en ? 'Home' : 'Accueil', '/'],
  ['/a-propos', en ? 'About' : 'À propos', en ? 'About CEA FOR AFRICA' : 'À propos de CEA FOR AFRICA', '/a-propos'],
  ['/domaines', en ? 'Areas' : 'Domaines', en ? 'Our areas of work' : "Nos domaines d'intervention", '/domaines'],
  ['/programmes', 'Accelerator', en ? 'CEA Accelerator — support programmes' : "CEA Accelerator — programmes d'accompagnement", '/programmes'],
  ['/academie', 'Academy', en ? 'CEA Academy — training' : 'CEA Academy — formation', '/academie'],
  ['/projets', 'Project Studio', en ? 'CEA Project Studio — project development' : 'CEA Project Studio — développement de projets', '/projets'],
  ['/evenements', 'Events', en ? 'CEA Events — events' : 'CEA Events — événements', '/evenements'],
  ['/opportunites', 'Talents', en ? 'CEA Talents — job creation' : "CEA Talents — création d'emplois", '/opportunites'],
  ['/communaute', 'Network', en ? 'CEA Network and Mastermind Circles' : 'CEA Network et Mastermind Circles', '/communaute'],
  ['/voix', en ? 'Voice' : 'Voix', en ? 'CEA Entrepreneurs’ Voice — advocacy' : 'CEA Voix des Entrepreneurs — action syndicale', '/voix'],
  ['/ressources', en ? 'Resources' : 'Ressources', en ? 'Resources and CEA Impact Lab' : 'Ressources et CEA Impact Lab', '/ressources'],
];
const isCur = (base: string) => (base === '/' ? path === '/' : path === base || path.startsWith(base + '/'));
const chev = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
---
<header class="top" id="top">
  <div class="wrap top-row">
    <a class="brand" href={L('/')} aria-label={t('brandHome')}><img class="logo" src="/logo.png" alt="CEA FOR AFRICA" width="101" height="56" /></a>
    <nav class="nav" id="nav" aria-label={t('mainNav')}>
      {NAV.map(([href, label, title, base]) => base === '/domaines' ? (
        <span class="dd">
          <a href={L(href)} aria-haspopup="true" aria-current={isCur(base) ? 'page' : 'false'}>{label} <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></a>
          <span class="ddmenu" role="menu">
            <b class="xs muted" style="display:block;padding:4px 10px 6px">{en ? 'OUR AREAS OF WORK' : "NOS DOMAINES D'INTERVENTION"}</b>
            {DOMAINS.map((d) => <a role="menuitem" href={L(`/domaines/${d.id}`)}><span class="mi"><Icon name={d.ic} size={16} /></span><span><b>{d.dom}</b><span class="d">{d.n}</span></span></a>)}
            <a role="menuitem" href={L('/domaines')} style="justify-content:center;font-weight:700;color:var(--gold-ink)">{en ? 'See all areas' : 'Voir tous les domaines'}</a>
          </span>
        </span>
      ) : (
        <a href={L(href)} title={title} aria-current={isCur(base) ? 'page' : 'false'}>{label}</a>
      ))}
    </nav>
    <div class="top-actions">
      <span class="prefs-h"><LocalePicker id="locPop" /></span>
      <button class="icon-btn" id="searchBtn" type="button" aria-label={t('search')}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg></button>
      <a class="icon-btn" href="/espace/notifications" data-auth="in" hidden aria-label={t('notifs')}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10 21a2 2 0 0 0 4 0" /></svg><span class="dotn" data-unread hidden></span></a>
      <a class="btn btn-gold btn-sm" href={L('/kapital')} aria-label="CEA Kapital Invest"><span class="kfull">Kapital Invest</span><span class="kshort">Kapital</span></a>
      <a class="btn btn-primary btn-sm" id="loginBtn" href={L('/connexion')} data-auth="out">{t('login')}</a>
      <div class="umenu" data-auth="in" hidden>
        <button class="btn btn-primary btn-sm um-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="umPanel" title={en ? 'My account' : 'Mon compte'}><span class="um-av" data-userinit aria-hidden="true"></span><span data-username>{t('mySpace')}</span><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></button>
        <div class="um-panel" id="umPanel" hidden>
          <div class="um-id"><span class="um-av lg" data-userinit aria-hidden="true"></span><div style="min-width:0"><b data-userfull></b><div class="xs muted um-mail" data-useremail></div><div class="xs" data-userroles></div></div></div>
          <a href="/espace">{en ? 'My dashboard' : 'Mon tableau de bord'}</a>
          <a href="/espace/profil">{en ? 'My profile' : 'Mon profil'}</a>
          <a href="/espace/carte">{en ? 'Membership card' : 'Carte de membre'}</a>
          <a href="/espace/demandes">{en ? 'My requests' : 'Mes demandes'}</a>
          <a href="/espace/notifications">{en ? 'Notifications' : 'Notifications'}</a>
          <hr />
          <a href="/espace/securite">{en ? 'Security and password' : 'Sécurité et mot de passe'}</a>
          <a href="/espace/confidentialite">{en ? 'Privacy and my data' : 'Confidentialité et mes données'}</a>
          <a href="/admin" data-staff hidden>{en ? 'CEA OS back office' : 'Back-office CEA OS'}</a>
          <hr />
          <button type="button" data-logout>{t('logout')}</button>
        </div>
      </div>
      <button class="icon-btn menu-btn" id="menuBtn" type="button" aria-label={t('menu')} aria-expanded="false" aria-controls="drawer"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18" /></svg></button>
    </div>
  </div>
</header>
<div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label={t('mainNav')}>
  <div class="drawer-h">
    <a class="brand" href={L('/')} aria-label={t('brandHome')}><img class="logo" src="/logo.png" alt="CEA FOR AFRICA" width="101" height="56" /></a>
    <button class="icon-btn" type="button" id="drawerClose" aria-label={t('close')}>✕</button>
  </div>
  <div class="drawer-b">
    <div class="drawer-actions">
      <a class="btn btn-primary" href={L('/adherer')} style="flex:1" data-auth="out">{t('join')}</a>
      <a class="btn btn-ghost" href={L('/connexion')} style="flex:1" data-auth="out">{t('login')}</a>
      <a class="btn btn-primary" href="/espace" style="flex:1" data-auth="in" hidden>{t('mySpace')}</a>
      <button class="btn btn-ghost" type="button" style="flex:1" data-auth="in" data-logout hidden>{t('logout')}</button>
    </div>
    {mega.map((m) => (
      <details open={m.k === cur}>
        <summary>{m.label[lang]} <Fragment set:html={chev} /></summary>
        {m.cols.flatMap((c) => c.items).map((it) => (
          <a class="mlink" href={L(it.href)}><span class="mi"><Icon name={it.ic} size={18} /></span><span><b>{it.t[lang]}</b><span class="d">{it.d[lang]}</span></span></a>
        ))}
      </details>
    ))}
    <a class="kbtn" href={L('/kapital')} style="margin:18px 0 8px">CEA Kapital Invest</a>
    <div class="drawer-loc"><LocalePicker inline /></div>
  </div>
</div>
