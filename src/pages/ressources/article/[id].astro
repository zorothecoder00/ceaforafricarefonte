---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import KapitalAd from '../../../components/KapitalAd.astro';
import { ARTICLES, dateFr } from '../../../data/site';

export function getStaticPaths() {
  return ARTICLES.map((a) => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props;
const others = ARTICLES.filter((x) => x.id !== a.id).slice(0, 2);
---
<BaseLayout title={a.t} description={a.x}>
  <PageHead title={a.t} lead={`${a.cat} · ${a.c} · ${dateFr(a.d)} · ${a.r} de lecture`} crumbs={[['/ressources', 'Ressources'], ['', a.cat]]} />
  <section class="block">
    <div class="wrap split">
      <article>
        <p style="font-size:1.15rem">{a.x}</p>
        <p>Ce texte est un contenu de démonstration. Dans la plateforme, chaque article est rédigé dans le respect de la charte éditoriale de CEA FOR AFRICA, relu par un expert du sujet, et disponible en français et en anglais.</p>
        <p>Les chiffres cités proviennent de sources publiques référencées en fin d'article. Les témoignages sont recueillis avec l'accord des personnes concernées.</p>
        <div class="row" style="margin-top:20px"><button class="btn btn-ghost btn-sm" data-toast="Lien copié.">Partager</button><button class="btn btn-ghost btn-sm" data-toast="Article enregistré.">Enregistrer</button></div>
        <h2 style="margin-top:40px">À lire aussi</h2>
        <div class="grid g2">{others.map((o) => <ArticleCard a={o} />)}</div>
      </article>
      <aside><KapitalAd variant={a.k ? 0 : 1} /></aside>
    </div>
  </section>
</BaseLayout>
