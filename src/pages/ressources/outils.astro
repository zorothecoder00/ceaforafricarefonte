---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { TOOLS, SUBS } from '../../data/site';
---
<BaseLayout title="Boîte à outils">
  <PageHead title="Boîte à outils" lead="Modèles prêts à l'emploi, à adapter à votre entreprise." crumbs={[['/ressources', 'Ressources'], ['', 'Boîte à outils']]} subnav={SUBS.ressources} />
  <section class="block">
    <div class="wrap grid g3">
      {TOOLS.map((t) => (
        <div class="panel row between"><span class="row"><Icon name="doc" /> <b>{t.t}</b></span><button class="btn btn-ghost btn-sm" data-toast={`Téléchargement : ${t.t} (simulation).`}>{t.f}</button></div>
      ))}
    </div>
  </section>
</BaseLayout>
