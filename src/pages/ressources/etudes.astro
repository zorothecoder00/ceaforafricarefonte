---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { STUDIES, SUBS } from '../../data/site';
---
<BaseLayout title="Études et rapports">
  <PageHead title="Études et rapports" lead="Baromètres, rapports d'impact et études de suivi." crumbs={[['/ressources', 'Ressources'], ['', 'Études']]} subnav={SUBS.ressources} />
  <section class="block">
    <div class="wrap grid g3">
      {STUDIES.map((s) => (
        <div class="panel"><span class="tag info">{s.y}</span><h3 style="margin-top:10px">{s.t}</h3><button class="btn btn-primary btn-sm" data-toast="Téléchargement du PDF (simulation).">Télécharger le PDF</button></div>
      ))}
    </div>
  </section>
</BaseLayout>
