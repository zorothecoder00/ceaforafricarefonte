---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocButton from '../../components/DocButton.astro';
import PageHead from '../../components/PageHead.astro';
import { STUDIES, SUBS } from '../../data/site';

export const prerender = false;
---
<BaseLayout title="Études et rapports">
  <PageHead title="Études et rapports" lead="Baromètres, rapports d'impact et études sectorielles." crumbs={[['/ressources', 'Ressources'], ['', 'Études']]} subnav={SUBS.ressources} />
  <section class="block">
    <div class="wrap grid g3">
      {STUDIES.map((s) => (
        <div class="panel"><span class="tag info">{s.y}</span><h3 style="margin-top:10px">{s.t}</h3><DocButton kind="etude" title={s.t} label="Télécharger le PDF" primary /></div>
      ))}
    </div>
  </section>
</BaseLayout>
