---
import BaseLayout from '../layouts/BaseLayout.astro';
import AfricaMap from '../components/AfricaMap.astro';
import Ticker from '../components/Ticker.astro';
import Icon from '../components/Icon.astro';
import DomainCard from '../components/DomainCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EventRow from '../components/EventRow.astro';
import VoteBox from '../components/VoteBox.astro';
import { HUBS, DOMAINS, ARTICLES, EVENTS, COURSES, JOBS, CONSULTS, fmt, country } from '../data/site';

const members = HUBS.reduce((a, h) => a + h.m, 0);
const projects = HUBS.reduce((a, h) => a + h.p, 0);
const nextEv = [...EVENTS].sort((a, b) => a.date.localeCompare(b.date)).slice(0, 3);
const score: [string, number][] = [['Équipe', 5], ['Traction', 4], ['Finances', 4], ['Gouvernance', 3]];
---
<BaseLayout>
  <section class="hero">
    <div class="wrap hg">
      <div>
        <h1>Les entrepreneurs africains,<span class="l2">ensemble.</span></h1>
        <p class="lead">Apprendre, se structurer, se financer, recruter et peser collectivement : tout l'écosystème de CEA FOR AFRICA, dans 16 pays.</p>
        <div class="persona">
          <a href="/programmes"><span>Je suis entrepreneur<small>Formation, accompagnement, financement</small></span><span aria-hidden="true">›</span></a>
          <a href="/kapital" class="kp"><span>Je suis investisseur<small>CEA Kapital Invest : opportunités vérifiées et marchés africains</small></span><span aria-hidden="true" style="color:var(--gold)">›</span></a>
          <a href="/communaute"><span>Je suis partenaire ou mentor<small>Co-construire et transmettre</small></span><span aria-hidden="true">›</span></a>
        </div>
      </div>
      <AfricaMap />
    </div>
    <div class="stats-band">
      <div class="wrap">
        <div class="stat"><b>{fmt(members)}</b><span>membres inscrits</span></div>
        <div class="stat"><b>{projects}</b><span>projets accompagnés</span></div>
        <div class="stat"><b>2 340</b><span>emplois créés et vérifiés</span></div>
        <div class="stat"><b>{HUBS.length}</b><span>pays actifs</span></div>
      </div>
      <div class="wrap demo-note" style="color:#8FA6BF;padding-bottom:14px">Chiffres de démonstration, au 30 septembre 2026. <a href="/impact" style="color:#C9D6E5">Méthodologie</a></div>
    </div>
  </section>

  <Ticker />

  <section class="kpromo" aria-label="CEA Kapital Invest">
    <div class="wrap">
      <div>
        <span class="eyebrow"><Icon name="cap" size={18} /> CEA KAPITAL INVEST — le portail financier panafricain</span>
        <h2 style="margin-top:12px">Votre entreprise mérite des investisseurs. Nous vous y préparons.</h2>
        <p style="color:#B9C9DA;font-size:1.1rem;max-width:52ch">Un diagnostic gratuit, un analyste dédié, une data room sécurisée et un comité qui présente les meilleurs dossiers à des investisseurs vérifiés, dans 16 pays.</p>
        <div class="kpills"><span>Levée de fonds</span><span>Capital-risque</span><span>Vente d'actions</span><span>Bourses africaines</span><span>Marché des capitaux</span></div>
        <div class="row"><a class="kbtn" href="/kapital/diagnostic" style="padding:13px 22px;font-size:1rem">Faire le diagnostic gratuit</a><a class="btn btn-ghost" style="color:#fff;border-color:#2A5079" href="/kapital/opportunites">Je suis investisseur</a></div>
        <div class="kstats">
          <div><b>9,8 Md</b><span>FCFA levés par les entreprises accompagnées</span></div>
          <div><b>150</b><span>dossiers prêts pour les investisseurs</span></div>
          <div><b>40</b><span>investisseurs au Demo Day 2026</span></div>
        </div>
        <p class="xs" style="color:#7F95AD;margin-top:14px">Chiffres de démonstration. Investir comporte un risque de perte en capital.</p>
      </div>
      <div class="kscreen" aria-hidden="true">
        <div class="bar"><i></i><i></i><i></i></div>
        <div class="row between"><b style="font-family:var(--display);color:#fff">Score Investor Ready</b><span class="tag gold">Manioc+</span></div>
        <div style="font-family:var(--display);font-size:3rem;color:#E7BD62;font-weight:800;line-height:1.1;margin:8px 0">78<span style="font-size:1.2rem;color:#9DB0C5">/100</span></div>
        <div class="progress" style="background:#103152"><span style="width:78%"></span></div>
        <div class="grid" style="grid-template-columns:1fr 1fr;gap:8px;margin-top:14px">
          {score.map(([l, n]) => (
            <div style="background:#103152;border-radius:8px;padding:10px"><div class="xs" style="color:#9DB0C5">{l}</div><div style="color:#fff;font-weight:700">{'●'.repeat(n)}<span style="color:#1D4268">{'●'.repeat(5 - n)}</span></div></div>
          ))}
        </div>
        <div style="margin-top:14px;border-top:1px solid #1D4268;padding-top:12px" class="small">
          <div class="row between" style="color:#C9D6E5"><span>Data room consultée par</span><b style="color:#fff">7 investisseurs</b></div>
          <div class="row between" style="color:#C9D6E5;margin-top:4px"><span>Prochaine étape</span><b style="color:#E7BD62">Comité — 14 oct.</b></div>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="row between"><h2>Huit façons d'avancer avec CEA</h2><a class="btn btn-ghost btn-sm" href="/domaines">Tous les domaines</a></div>
      <div class="grid g4" style="margin-top:18px">{DOMAINS.map((d) => <DomainCard d={d} />)}</div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="call">
        <div>
          <span class="tag gold">Appel à candidatures ouvert</span>
          <h2 style="margin-top:10px">Accélérateur CEA — Cohorte 4</h2>
          <p>Six mois d'accompagnement, un mentor dédié, l'accès au Demo Day de CEA Kapital Invest devant 40 investisseurs. Pour les entreprises de 1 à 5 ans, dans les 16 pays CEA.</p>
          <a class="btn btn-primary" href="/programmes/candidature">Postuler</a>
        </div>
        <div><p class="small muted" style="margin-bottom:6px">Clôture le 15 novembre 2026</p><div class="cd" data-countdown="2026-11-15T23:59:00"></div></div>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="row between"><h2>Histoires d'entrepreneurs</h2><a class="small" href="/ressources">Le média CEA</a></div>
      <div class="grid g3">{ARTICLES.slice(0, 3).map((a) => <ArticleCard a={a} />)}</div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap grid g3">
      <div>
        <div class="row between"><h2>Agenda</h2><a href="/evenements" class="small">Tout l'agenda</a></div>
        {nextEv.map((e) => <EventRow e={e} />)}
      </div>
      <div>
        <div class="row between"><h2>Académie</h2><a href="/academie" class="small">Catalogue</a></div>
        {COURSES.filter((c) => !c.price).slice(0, 3).map((c) => (
          <a href={`/academie/${c.id}`} class="panel" style="display:block;text-decoration:none;margin-top:12px"><span class="tag ok">Gratuit</span><b style="display:block;margin-top:6px">{c.t}</b><span class="small muted">{c.dur} · {c.by}</span></a>
        ))}
      </div>
      <div>
        <div class="row between"><h2>Opportunités</h2><a href="/opportunites" class="small">Toutes les offres</a></div>
        {JOBS.slice(0, 3).map((j) => (
          <a href="/opportunites" class="panel" style="display:block;text-decoration:none;margin-top:12px"><b>{j.t}</b><div class="small muted">{j.co} · {country(j.c)} · {j.type}</div></a>
        ))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap grid g2">
      <div><h2>Votre voix compte</h2><VoteBox v={CONSULTS[0]} /></div>
      <div>
        <h2>Partenaires</h2>
        <div class="grid" style="grid-template-columns:repeat(3,1fr);gap:10px">
          {['Banque partenaire', 'Fondation', 'Bailleur', 'Université', 'Incubateur', 'Opérateur mobile'].map((p) => (
            <div class="panel small muted" style="text-align:center;padding:18px 8px">{p}<br /><span class="xs">(logo)</span></div>
          ))}
        </div>
        <form class="panel" style="margin-top:16px" data-demo="Inscription confirmée. Un e-mail de vérification vous a été envoyé.">
          <h3>Lettre d'information</h3>
          <p class="small muted">Choisissez vos sujets et votre pays.</p>
          <div class="row" style="margin-bottom:10px">
            {['Financement', 'Formation', 'Événements', 'Kapital Invest'].map((t, i) => <label class="chip"><input type="checkbox" checked={i === 3} /> {t}</label>)}
          </div>
          <div class="row"><input class="in" type="email" required placeholder="votre@email.com" aria-label="E-mail" style="flex:1;margin:0;min-width:200px" /><button class="btn btn-primary" type="submit">S'abonner</button></div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
