---
/* CEA OS — Accueil (prototype CEA OS › pHome) : salutation, actions rapides (congé, note de frais, achat, dépense, réunion,
   temps, poste), chiffres clés, mes tâches, approbations attendues, prochaines réunions, demandes en cours, messagerie.
   Sans fiche personnel (direction), un renvoi vers le back-office du site. */
import { typeName } from '../../lib/os/workflow-defaults';
import AdminLayout from '../../layouts/AdminLayout.astro';
import RequestDialogs from '../../components/os/RequestDialogs.astro';
import MeetingDialog from '../../components/os/MeetingDialog.astro';
import Steps from '../../components/os/Steps.astro';
import Tags from '../../components/os/Tags.astro';
import { and, asc, desc, eq, gte, ne, sql } from 'drizzle-orm';
import { db } from '../../lib/db';
import { osRequest, osTask, osMeeting, osDecision } from '../../db/schema/os';
import { osContext, allStaff, scopeState, canUse, MANAGERS, type Person } from '../../lib/os/core';
import { pendingFor, thresholds, budgets, activeDelegations } from '../../lib/os/approvals';
import { myChannels } from '../../lib/os/collab';
import { escalatedFor } from '../../lib/os/relations';
import { DK, PK, pn, refT, fcfa, dstr, type ReqType } from '../../lib/os/ref';
import { priorityScore, ymd } from '../../lib/os/workspace-core';

export const prerender = false;
const os = await osContext(Astro.locals.user!);
const me = os.me;
const hour = Number(new Intl.DateTimeFormat('en-GB', { hour: 'numeric', hour12: false, timeZone: 'Africa/Lome' }).format(new Date()));
const first = (me?.name ?? Astro.locals.user!.name).split(' ')[0];
const title = `${hour < 12 ? 'Bonjour' : hour < 18 ? 'Bon après-midi' : 'Bonsoir'} ${first}`;
const today = new Date().toLocaleDateString('fr-FR', { timeZone: 'Africa/Lome' });

let people: Person[] = [];
let data: null | {
  pend: Awaited<ReturnType<typeof pendingFor>>; mine: (typeof osRequest.$inferSelect)[]; manager: string;
  thr: Awaited<ReturnType<typeof thresholds>>; bud: Awaited<ReturnType<typeof budgets>>; countries: string[]; domains: string[];
  tasks: (typeof osTask.$inferSelect)[]; decs: (typeof osDecision.$inferSelect)[]; esc: Awaited<ReturnType<typeof escalatedFor>>; meet: (typeof osMeeting.$inferSelect)[]; chans: Awaited<ReturnType<typeof myChannels>>;
} = null;
if (me) {
  const [ps, delegs] = await Promise.all([allStaff(), activeDelegations()]);
  people = ps;
  const sc = scopeState(os, Astro.cookies);
  const [pend, mine, thr, bud, tasks, meet, chans, decs, esc] = await Promise.all([
    pendingFor(me.id, { people, delegs }),
    db.select().from(osRequest).where(eq(osRequest.byStaff, me.id)).orderBy(desc(osRequest.createdAt)),
    thresholds(), budgets(),
    db.select().from(osTask).where(and(eq(osTask.owner, me.id), ne(osTask.status, 'Terminé'))).orderBy(asc(osTask.due)),
    db.select().from(osMeeting).where(and(sql`${osMeeting.participants} @> ${JSON.stringify([me.id])}::jsonb`, gte(osMeeting.at, new Date(Date.now() - 864e5)))).orderBy(asc(osMeeting.at)).limit(4),
    myChannels(me, people),
    me.prof === 'dg' ? db.select().from(osDecision).where(eq(osDecision.status, 'En attente')) : Promise.resolve([]),
    escalatedFor(me).catch(() => []),
  ]);
  data = {
    pend, mine, thr, bud, tasks, meet, chans, decs, esc, manager: people.find((s) => s.id === me.managerId)?.name ?? 'votre responsable',
    countries: PK.filter((p) => sc.inScope({ country: p })), domains: DK.filter((d) => sc.inScope({ domain: d })),
  };
}
const nowD = new Date();
const canDep = me && ['rep', 'dirreg', 'chef', 'dg', 'agent', 'cond'].includes(me.prof);
const name = (id: string) => people.find((s) => s.id === id)?.name ?? '—';
const RTYPES: Record<ReqType, string> = { dep: 'Dépenses', ndf: 'Notes de frais', conge: 'Congés', achat: "Demandes d'achat", contrat: 'Contrats', recrut: 'Recrutements', offre: 'Offres hors fourchette' };
// Ce qui attend la décision de l'utilisateur, détaillé par nature (même total que le compteur « Approbations » du menu)
const toApprove = data ? data.pend.length + data.decs.length + data.esc.length : 0;
const approveDetail = data ? [
  ...Object.entries(data.pend.reduce<Record<string, number>>((a, p) => ({ ...a, [p.r.type]: (a[p.r.type] ?? 0) + 1 }), {})).map(([t, n]) => `${n} ${((n > 1 ? RTYPES[t as ReqType] : undefined) ?? typeName(t)).toLowerCase()}`),
  data.decs.length ? `${data.decs.length} décision${data.decs.length > 1 ? 's' : ''} de réunion` : '',
  data.esc.length ? `${data.esc.length} inscription${data.esc.length > 1 ? 's' : ''} en retard` : '',
].filter(Boolean).join(' · ') : '';
---
<AdminLayout title={title} lead={me ? `${refT(me.poste)} · ${pn(me.country)} · ${today}` : `${today} · vos files de travail selon vos droits ; toutes les actions sont tracées dans le journal d'audit.`}>
  <Fragment slot="actions">{canUse(MANAGERS, os) && <a class="btn ghost" href="/os/cockpit">Ouvrir le cockpit</a>}</Fragment>
  {me && data ? (
    <>
      <div class="quick grid" style="margin-bottom:16px">
        <button type="button" data-dlg="dlg-conge">Demander un congé<small>Solde : {me.leaveDays} jours</small></button>
        <button type="button" data-dlg="dlg-ndf">Note de frais<small>Avec photo du justificatif</small></button>
        <button type="button" data-dlg="dlg-achat">Demande d'achat<small>Fournitures, matériel, prestations</small></button>
        {canDep && <button type="button" data-dlg="dlg-dep">Dépense<small>Circuit selon le montant</small></button>}
        <button type="button" data-dlg="dlg-meet">Planifier une réunion<small>Avec compte rendu</small></button>
        <a href="/os/moi/temps">Feuille de temps<small>Heures de la semaine en cours</small></a>
        <a href="/os/poste">Mon poste<small>Fiche {me.poste} et indicateurs</small></a>
      </div>
      <div class="grid g4">
        <a class="card kpi kpi-link" href="/os/approbations" title="Demandes de vos collègues (congés, notes de frais, achats, dépenses…) qui attendent votre visa"><div class="l">Demandes à approuver par vous</div><div class="v num">{toApprove}</div><div class:list={['d', { down: toApprove > 0, muted: !toApprove }]}>{toApprove ? approveDetail : 'Aucune demande en attente de votre visa'}</div></a>
        <a class="card kpi kpi-link" href="/os/taches?boite=retard"><div class="l">Mes tâches ouvertes</div><div class="v num">{data.tasks.length}</div><div class:list={['d', { down: data.tasks.some((t) => t.due < nowD), muted: !data.tasks.some((t) => t.due < nowD) }]}>{data.tasks.filter((t) => t.due < nowD).length} en retard · {data.tasks.filter((t) => ymd(t.due) === ymd(nowD)).length} pour aujourd'hui</div></a>
        <div class="card kpi"><div class="l">Mes demandes en cours</div><div class="v num">{data.mine.filter((r) => r.status === 'En approbation').length}</div></div>
        <div class="card kpi"><div class="l">Solde de congés</div><div class="v num">{me.leaveDays} j</div></div>
      </div>
      <div class="grid g3" style="margin-top:14px">
        <div class="card">
          <div class="row between"><h2>Mes priorités du jour</h2><a class="small" href="/os/moi/planning?vue=jour">Planifier</a></div>
          {[...data.tasks].sort((a, b) => priorityScore(b, nowD) - priorityScore(a, nowD)).slice(0, 6).map((t) => <div class="row between small" style="padding:6px 0;border-bottom:1px solid var(--line)"><span><b class="num" title="Score de priorité" style="color:var(--gold-ink);margin-right:6px">{priorityScore(t, nowD)}</b>{t.title}</span><span class:list={['muted', { down: t.due < nowD }]}>{t.start ? `${t.start.toISOString().slice(11, 16)}` : dstr(t.due)}</span></div>)}
          {!data.tasks.length && <p class="small muted">Aucune tâche ouverte.</p>}
        </div>
        <div class="card">
          <div class="row between"><h2>Demandes à approuver</h2><a class="small" href="/os/approbations">Tout voir</a></div>
          {data.pend.slice(0, 6).map((p) => <a href={`/os/flux/${p.r.id}`} class="small" style="display:block;text-decoration:none;color:inherit;padding:6px 0;border-bottom:1px solid var(--line)">{typeName(p.r.type)} {p.r.id} — {p.r.title}{p.r.amount > 0 && <> · <b>{fcfa(p.r.amount)}</b></>}</a>)}
          {data.decs.slice(0, 3).map((d) => <div class="small" style="padding:6px 0;border-bottom:1px solid var(--line)">Décision : {d.text}</div>)}
          {data.esc.slice(0, 3).map((x) => <div class="small" style="padding:6px 0;border-bottom:1px solid var(--line)">Inscription en retard (plus de 48 h) : {x.name}</div>)}
          {!toApprove && <p class="small muted">Rien en attente.</p>}
        </div>
        <div class="card">
          <div class="row between"><h2>Prochaines réunions</h2><a class="small" href="/os/agenda">Agenda</a></div>
          {data.meet.map((m) => <div class="small" style="padding:6px 0;border-bottom:1px solid var(--line)"><b>{m.title}</b><br /><span class="muted">{dstr(m.at)} à {m.hour} · {m.place}</span></div>)}
          {!data.meet.length && <p class="small muted">Aucune réunion prévue.</p>}
        </div>
      </div>
      <div class="grid g2" style="margin-top:14px">
        <div class="card">
          <div class="row between"><h2>Mes demandes</h2><a class="small" href="/os/moi">Historique</a></div>
          {data.mine.slice(0, 5).map((r) => (
            <div style="padding:7px 0;border-bottom:1px solid var(--line)">
              <div class="row between small"><b>{typeName(r.type)} {r.id}</b><Tags st={r.status} /></div>
              <div class="small">{r.title}{r.amount > 0 && ' · ' + fcfa(r.amount)}</div>
              <Steps steps={r.steps} cur={r.cur} status={r.status} />
            </div>
          ))}
          {!data.mine.length && <p class="small muted">Aucune demande.</p>}
        </div>
        <div class="card">
          <div class="row between"><h2>Messagerie</h2><a class="small" href="/os/messagerie">Ouvrir</a></div>
          {data.chans.slice(0, 4).map((c) => (
            <a href={`/os/messagerie?c=${c.id}`} style="display:block;text-decoration:none;padding:6px 0;border-bottom:1px solid var(--line)" class="small">
              <b>{c.scope.startsWith('dm:') ? name(c.scope.slice(3).split(',').find((x) => x !== me.id) ?? '') : c.name}</b><br />
              <span class="muted">{c.last ? `${name(c.last.staff_id).split(' ')[0]} : ${c.last.body.slice(0, 70)}` : 'Aucun message'}</span>
            </a>
          ))}
        </div>
      </div>
      <RequestDialogs me={me} managerName={data.manager} thr={data.thr} budgets={data.bud} countries={data.countries} domains={data.domains} />
      <MeetingDialog me={me} people={people} />
    </>
  ) : (
    <>
      {os.superuser && <div class="watch" style="margin-bottom:14px">Votre compte n'est rattaché à aucune fiche du personnel : demandes, approbations et indicateurs personnels apparaissent dès que les ressources humaines créent votre fiche (Ressources humaines › Effectifs).</div>}
      <div class="empty">Les files de travail du site (messages, modération, offres, candidatures…) sont dans le <a href="/admin">back-office du site</a>.</div>
    </>
  )}
</AdminLayout>
