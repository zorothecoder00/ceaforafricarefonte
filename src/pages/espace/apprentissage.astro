---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { COURSES, PATHS, SUBS } from '../../data/site';
---
<BaseLayout title="Mon apprentissage">
  <PageHead title="Mon apprentissage" lead="Vos cours en cours, vos parcours et vos certificats." crumbs={[['/academie', 'Académie'], ['', 'Mon apprentissage']]} subnav={SUBS.espace} />
  <section class="block">
    <div class="wrap split">
      <div>
        <h2>Mes cours</h2>
        <div id="myCourses" data-courses={JSON.stringify(COURSES.map((c) => ({ id: c.id, t: c.t, n: c.ls.length, ls: c.ls })))}></div>
        <div class="empty" id="noCourse" hidden>Vous n'avez encore commencé aucun cours. <a href="/academie">Parcourir le catalogue</a></div>
        <h2 style="margin-top:30px">Parcours certifiants</h2>
        <div class="grid g2">
          {PATHS.map((p) => (
            <div class="panel" data-path={p.c.join(',')}>
              <h3>{p.t}</h3>
              <p class="small muted">{p.d}</p>
              <div class="progress"><span style="width:0"></span></div>
              <p class="xs muted" style="margin:6px 0 0" data-path-txt>0 / {p.c.length} cours terminés</p>
            </div>
          ))}
        </div>
      </div>
      <aside>
        <div class="panel"><h3>Mes certificats</h3><div id="certs"><p class="small muted">Terminez un cours pour obtenir votre premier certificat vérifiable.</p></div></div>
        <div class="panel" style="margin-top:16px"><h3>Hors ligne</h3><p class="small muted">Les leçons téléchargées restent lisibles sans connexion, sur ce téléphone.</p></div>
      </aside>
    </div>
  </section>
</BaseLayout>
<script>
  // Progression enregistrée par les fiches de cours (clé cea-enroll : { idCours: [indices des leçons terminées] }).
  type C = { id: string; t: string; n: number; ls: string[] };
  const box = document.getElementById('myCourses')!;
  const courses: C[] = JSON.parse(box.dataset.courses!);
  let en: Record<string, number[]> = {};
  try { en = JSON.parse(localStorage.getItem('cea-enroll') || '{}'); } catch {}
  const pct = (c: C) => Math.round(((en[c.id] || []).length / c.n) * 100);
  const mine = courses.filter((c) => en[c.id]);
  document.getElementById('noCourse')!.hidden = mine.length > 0;
  box.innerHTML = mine.map((c) => `<a class="panel" href="/academie/${c.id}" style="display:block;text-decoration:none;margin-bottom:10px"><div class="row between"><b>${c.t}</b><span class="small">${pct(c)} %</span></div><div class="progress" style="margin-top:8px"><span style="width:${pct(c)}%"></span></div></a>`).join('');
  const done = courses.filter((c) => pct(c) === 100);
  if (done.length) document.getElementById('certs')!.innerHTML = done.map((c) => `<div class="row small" style="padding:6px 0;border-bottom:1px solid var(--line)">🎓 ${c.t}</div>`).join('');
  document.querySelectorAll<HTMLElement>('[data-path]').forEach((p) => {
    const ids = p.dataset.path!.split(',');
    const n = ids.filter((id) => done.some((c) => c.id === id)).length;
    p.querySelector<HTMLElement>('.progress span')!.style.width = (n / ids.length) * 100 + '%';
    p.querySelector('[data-path-txt]')!.textContent = `${n} / ${ids.length} cours terminés`;
  });
</script>
