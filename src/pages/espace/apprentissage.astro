---
/* Mon apprentissage (CDC §7.6) : cours en cours, parcours, certificats vérifiables, recommandations. */
import EspaceLayout from '../../layouts/EspaceLayout.astro';
import { desc, eq } from 'drizzle-orm';
import { db } from '../../lib/db';
import { enrollment, certificate, diagnostic, academyCohort, academyCohortMember } from '../../db/schema';
import { userStreak, MILESTONES } from '../../lib/streaks';
import { PATHS } from '../../data/site';
import { allCourses } from '../../lib/catalog';

export const prerender = false;
const COURSES = await allCourses({ hidden: true });
const user = Astro.locals.user!;
const enrolls = await db.select().from(enrollment).where(eq(enrollment.userId, user.id)).orderBy(desc(enrollment.startedAt));
const certs = await db.select().from(certificate).where(eq(certificate.userId, user.id)).orderBy(desc(certificate.issuedAt));
// Série de jours d'apprentissage et cohortes du membre
const streak = await userStreak(user.id);
const nextMilestone = MILESTONES.find((m) => m > streak.current);
const cohorts = await db.select({ c: academyCohort }).from(academyCohortMember).innerJoin(academyCohort, eq(academyCohort.id, academyCohortMember.cohortId)).where(eq(academyCohortMember.userId, user.id)).orderBy(desc(academyCohort.startsOn));
const [diag] = await db.select().from(diagnostic).where(eq(diagnostic.userId, user.id)).orderBy(desc(diagnostic.createdAt)).limit(1);
const pct = (id: string, done: number[]) => Math.round((done.length / (COURSES.find((c) => c.id === id)?.ls.length ?? 1)) * 100);
const finished = new Set(enrolls.filter((e) => e.completedAt).map((e) => e.courseId));
// Parcours adaptatif : recommandations selon le diagnostic Investor Ready (CDC §7.6)
const AXES_COURSE: Record<number, string> = { 0: 'c7', 1: 'c4', 2: 'c5', 3: 'c5', 4: 'c2', 5: 'c2', 6: 'c6', 7: 'c1' };
const weak = diag ? diag.answers.map((v, i) => [v, i] as const).filter(([v]) => v < 5).map(([, i]) => AXES_COURSE[i]) : ['c1', 'c5'];
const reco = [...new Set(weak)].filter((id) => !enrolls.some((e) => e.courseId === id)).slice(0, 3).map((id) => COURSES.find((c) => c.id === id)!).filter(Boolean);
---
<EspaceLayout title="Mon apprentissage" lead="Vos cours, vos parcours et vos certificats vérifiables.">
  <div class="split">
    <div>
      <h2 style="font-size:1.2rem">Mes cours</h2>
      {enrolls.length ? enrolls.map((e) => {
        const c = COURSES.find((x) => x.id === e.courseId);
        const p = pct(e.courseId, e.completedLessons);
        return (
          <a class="panel" href={`/academie/${e.courseId}`} style="display:block;text-decoration:none;margin-bottom:10px">
            <div class="row between"><b>{c?.t ?? e.courseId}</b><span class="small">{p} %</span></div>
            <div class="progress" style="margin-top:8px"><span style={`width:${p}%`}></span></div>
          </a>
        );
      }) : <div class="empty">Vous n'avez encore commencé aucun cours. <a href="/academie">Parcourir le catalogue</a></div>}

      <h2 style="font-size:1.2rem;margin-top:28px">Parcours certifiants</h2>
      <div class="grid g2">
        {PATHS.map((p) => {
          const n = p.c.filter((id) => finished.has(id)).length;
          return (
            <div class="panel">
              <h3>{p.t}</h3>
              <p class="small muted">{p.d}</p>
              <div class="progress"><span style={`width:${(n / p.c.length) * 100}%`}></span></div>
              <p class="xs muted" style="margin:6px 0 0">{n} / {p.c.length} cours terminés</p>
            </div>
          );
        })}
      </div>
    </div>
    <aside>
      <div class="panel streak">
        <h3>Série d'apprentissage</h3>
        <div class="row" style="gap:14px;align-items:baseline"><b style="font-family:var(--display);font-size:2.4rem;line-height:1">{streak.current}</b><span class="small">jour{streak.current > 1 ? 's' : ''} d'affilée{streak.current > 0 ? (streak.today ? ' · aujourd’hui validé' : ' · à prolonger aujourd’hui') : ''}</span></div>
        <p class="xs muted" style="margin:8px 0 0">Record : {streak.best} jour{streak.best > 1 ? 's' : ''} · {streak.total} jour{streak.total > 1 ? 's' : ''} d'apprentissage au total{nextMilestone ? ` · prochain palier : ${nextMilestone} jours` : ''}.</p>
        <p class="xs muted" style="margin:4px 0 0">Une leçon validée ou un quiz suffit pour compter la journée.</p>
      </div>
      <div class="panel" style="margin-top:16px">
        <h3>Mes cohortes</h3>
        {cohorts.length ? cohorts.map(({ c }) => <a class="small" href={`/academie/cohorte/${c.id}`} style="display:block;padding:4px 0">{c.name}</a>) : <p class="small muted" style="margin:0">Apprenez avec une promotion : <a href="/academie/cohortes">voir les cohortes</a>.</p>}
      </div>
      <div class="panel" style="margin-top:16px">
        <h3>Mes certificats</h3>
        {certs.length ? certs.map((c) => <div class="list-row"><span>{c.subject.startsWith('test:') ? '✓' : '🎓'} {c.title}</span><a class="small" href={`/verifier/certificat/${c.number}`}>Vérifier</a></div>) : <p class="small muted" style="margin:0">Terminez un cours pour obtenir votre premier certificat vérifiable.</p>}
      </div>
      <div class="panel" style="margin-top:16px">
        <h3>Recommandés pour vous</h3>
        <p class="small muted">{diag ? `D'après votre diagnostic (${diag.score}/100).` : 'Pour bien démarrer.'}</p>
        {reco.map((c) => <a class="small" href={`/academie/${c.id}`} style="display:block;padding:4px 0">{c.t}</a>)}
      </div>
    </aside>
  </div>
</EspaceLayout>
