---
/* Mes projets (CDC §7.2, MVP) : liste, statut, maturité, prochaines échéances. */
import EspaceLayout from '../../../layouts/EspaceLayout.astro';
import { and, asc, eq, gte, inArray, ne, or, sql } from 'drizzle-orm';
import { db } from '../../../lib/db';
import { project, projectMember, projectTask } from '../../../db/schema/app';
import { maturityScore } from '../../../lib/projects';

export const prerender = false;
const me = Astro.locals.user!;
const memberOf = (await db.select({ id: projectMember.projectId }).from(projectMember).where(eq(projectMember.userId, me.id))).map((r) => r.id);
const rows = await db.select().from(project).where(or(eq(project.ownerId, me.id), memberOf.length ? inArray(project.id, memberOf) : sql`false`));
const ids = rows.map((r) => r.id);
const next = ids.length ? await db.select().from(projectTask).where(and(inArray(projectTask.projectId, ids), ne(projectTask.status, 'termine'), gte(projectTask.dueOn, new Date().toISOString().slice(0, 10)))).orderBy(asc(projectTask.dueOn)).limit(8) : [];
const ST: Record<string, string> = { brouillon: 'Brouillon', soumis: 'Soumis', en_structuration: 'En structuration', pret_investissement: "Prêt pour l'investissement", transmis_kapital: 'Transmis à Kapital', finance: 'Financé', archive: 'Archivé' };
---
<EspaceLayout title="Mes projets" lead="Structurez, pilotez et faites financer vos projets.">
  <a class="btn btn-primary btn-sm" href="/projets/nouveau" style="margin-bottom:14px">Proposer un projet</a>
  {rows.length ? (
    <div class="split">
      <div class="grid g2">
        {rows.map((p) => { const sc = maturityScore(p.maturity as Record<string, number>); return (
          <a class="panel" href={`/espace/projets/${p.id}`} style="text-decoration:none">
            <div class="row between"><b>{p.name}</b><span class="tag info">{ST[p.status]}</span></div>
            <div class="small muted">{[p.sector, p.stage].filter(Boolean).join(' · ')}{p.ownerId !== me.id ? ' · membre' : ''}</div>
            <div class="small" style="margin-top:10px">Maturité : <b>{sc}/100</b></div>
            <div class="progress" style="margin-top:4px"><span style={`width:${sc}%`}></span></div>
          </a>
        ); })}
      </div>
      <aside class="panel"><h3>Prochaines échéances</h3>{next.length ? next.map((t) => <div class="list-row"><span class="small">{t.milestone ? '◆ ' : ''}{t.title}</span><span class="muted small">{t.dueOn}</span></div>) : <p class="small muted" style="margin:0">Aucune échéance planifiée.</p>}</aside>
    </div>
  ) : <div class="empty">Aucun projet. <a href="/projets/nouveau">Proposer mon premier projet</a></div>}
</EspaceLayout>
