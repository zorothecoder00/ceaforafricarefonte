---
/* Suivi des candidatures (programmes, Mastermind, emplois) — CDC §7.4 et §7.6. */
import EspaceLayout from '../../layouts/EspaceLayout.astro';
import { and, asc, desc, eq, gt, inArray, isNull } from 'drizzle-orm';
import { db } from '../../lib/db';
import { programmeApplication, jobApplication, job, jobInterview } from '../../db/schema/app';
import { INTERVIEW_MODES, interviewPlace } from '../../lib/recruiting';
import { programmeCall } from '../../db/schema/programmes';
import { LEGACY } from '../../lib/calls';

export const prerender = false;
const user = Astro.locals.user!;
const progs = await db.select({ p: programmeApplication, call: programmeCall.title }).from(programmeApplication).leftJoin(programmeCall, eq(programmeCall.slug, programmeApplication.programme)).where(eq(programmeApplication.userId, user.id)).orderBy(desc(programmeApplication.updatedAt));
const jobs = await db.select({ a: jobApplication, title: job.title, company: job.company }).from(jobApplication).innerJoin(job, eq(job.id, jobApplication.jobId)).where(eq(jobApplication.userId, user.id)).orderBy(desc(jobApplication.updatedAt));
// Entretiens à venir planifiés par les recruteurs (CDC §7.4)
const ivs = jobs.length ? await db.select().from(jobInterview).where(and(inArray(jobInterview.applicationId, jobs.map((j) => j.a.id)), isNull(jobInterview.cancelledAt), gt(jobInterview.startsAt, new Date()))).orderBy(asc(jobInterview.startsAt)) : [];
const STATUS: Record<string, string> = { brouillon: 'Brouillon', recue: 'Reçue', en_evaluation: 'En évaluation', entretien: 'Entretien', admise: 'Admise', liste_attente: "Liste d'attente", refusee: 'Non retenue', retiree: 'Retirée' };
const STEPS = ['recue', 'en_evaluation', 'entretien', 'admise'];
const JOB_COLS: [string, string][] = [['envoyee', 'Envoyée'], ['vue', 'Vue'], ['entretien', 'Entretien'], ['offre', 'Offre'], ['refus', 'Refus']];
---
<EspaceLayout title="Mes candidatures" lead="Suivez chaque étape. Vous êtes notifié par WhatsApp et e-mail à chaque changement.">
  <h2 style="font-size:1.2rem">Programmes</h2>
  {progs.length ? progs.map(({ p, call }) => {
    const i = STEPS.indexOf(p.status);
    return (
      <div class="panel" style="margin-bottom:12px">
        <div class="row between"><b>{call ?? LEGACY[p.programme]?.label ?? p.programme}</b><span class="small muted num">{p.reference}</span></div>
        {['refusee', 'retiree', 'liste_attente'].includes(p.status)
          ? <p class="small" style="margin:8px 0 0"><span class="tag">{STATUS[p.status]}</span></p>
          : <div class="steps" style="margin:12px 0 4px">{STEPS.map((_, k) => <span class={k <= i ? 'on' : ''}></span>)}</div>}
        <div class="xs muted">Statut : {STATUS[p.status] ?? p.status} · mis à jour le {p.updatedAt.toLocaleDateString('fr-FR')}</div>
      </div>
    );
  }) : <div class="empty">Aucune candidature. <a href="/programmes">Voir les programmes</a></div>}

  <h2 style="font-size:1.2rem;margin-top:28px">Emplois</h2>
  {jobs.length ? (
    <div class="kanban" style="grid-template-columns:repeat(5,minmax(160px,1fr))">
      {JOB_COLS.map(([k, l]) => (
        <div class="col"><h4><span>{l}</span><span>{jobs.filter((j) => j.a.status === k).length}</span></h4>
          {jobs.filter((j) => j.a.status === k).map((j) => <div class="kcard"><b>{j.title}</b><div class="xs muted">{j.company}</div>{ivs.filter((i) => i.applicationId === j.a.id).map((i) => { const where = interviewPlace(i.id, i.mode, i.place); return <p class="xs" style="margin:6px 0 0"><b>Entretien</b> · {i.startsAt.toLocaleString('fr-FR', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Lome' })} (GMT) · {INTERVIEW_MODES[i.mode]} · {i.minutes} min{where && (/^https?:/.test(where) ? <><br /><a href={where} target="_blank" rel="noopener">Rejoindre la visio</a></> : <><br />{where}</>)}</p>; })}</div>)}
        </div>
      ))}
    </div>
  ) : <div class="empty">Aucune candidature à une offre. <a href="/opportunites">Voir les offres</a></div>}
</EspaceLayout>
