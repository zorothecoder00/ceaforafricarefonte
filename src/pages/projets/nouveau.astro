---
/* Proposer un projet (CDC §7.2, MVP) : formulaire guidé en étapes, sauvegarde automatique. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Wizard from '../../components/Wizard.astro';
import { COUNTRIES, SUBS } from '../../data/site';
import { SHEET_FIELDS } from '../../lib/projects';

export const prerender = false;

const fs = 'border:0;padding:0;margin:0';
const steps: [string, string[]][] = [['Problème et solution', ['probleme', 'solution']], ['Marché et équipe', ['marche', 'equipe']], ['Modèle et traction', ['modele', 'traction']], ['Besoins et impact', ['besoins', 'impact']]];
const field = (k: string) => SHEET_FIELDS.find(([f]) => f === k)!;
---
<BaseLayout title="Proposer un projet">
  <PageHead title="Proposer un projet" lead="Une fiche normalisée, sauvegardée automatiquement. Votre projet reste privé tant que vous ne décidez pas de le publier." crumbs={[['/projets', 'Project Studio'], ['', 'Proposer']]} subnav={SUBS.projets} />
  <section class="block">
    <div class="wrap" style="max-width:760px">
      <Wizard id="projet" prefix="PRJ" api="/api/projets" submitLabel="Créer mon projet" success="Votre espace de travail est prêt : canvas, plan d'action, modèle financier.">
        <fieldset data-step="Le projet" style={fs}>
          <label class="f" for="p1">Nom du projet</label><input class="in" id="p1" name="nom" required minlength="2" />
          <div class="grid g3" style="gap:0 12px">
            <div><label class="f" for="p2">Secteur</label><select class="in" id="p2" name="secteur">{['Agriculture', 'Agro-industrie', 'Énergie', 'Santé', 'Éducation', 'Numérique', 'Fintech', 'BTP', 'Industrie', 'Commerce', 'Autre'].map((s) => <option>{s}</option>)}</select></div>
            <div><label class="f" for="p3">Pays</label><select class="in" id="p3" name="pays">{Object.entries(COUNTRIES).map(([k, v]) => <option value={k}>{v}</option>)}</select></div>
            <div><label class="f" for="p4">Stade</label><select class="in" id="p4" name="stade">{['Idée', 'Pré-amorçage', 'Amorçage', 'Croissance', 'Série A'].map((s) => <option>{s}</option>)}</select></div>
          </div>
        </fieldset>
        {steps.map(([title, keys]) => (
          <fieldset data-step={title} style={fs}>
            {keys.map((k) => { const [, l, help] = field(k); return <><label class="f" for={`s-${k}`}>{l}</label><p class="xs muted" style="margin:-4px 0 6px">{help}</p><textarea class="in" id={`s-${k}`} name={k} maxlength="5000" data-ai="projet"></textarea></>; })}
          </fieldset>
        ))}
      </Wizard>
    </div>
  </section>
</BaseLayout>
