---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { SUBS } from '../../data/site';
import { desc, eq } from 'drizzle-orm';
import { db } from '../../lib/db';
import { capTable } from '../../db/schema/app';

export const prerender = false;
// Tables de capitalisation du membre (studio complet : opérations, BSPCE, scénarios comparés)
const me = Astro.locals.user;
const tables = me ? await db.select({ id: capTable.id, company: capTable.company, updatedAt: capTable.updatedAt }).from(capTable).where(eq(capTable.ownerId, me.id)).orderBy(desc(capTable.updatedAt)) : [];
---
<BaseLayout title="Studio de capital">
  <PageHead title="Studio de capital" lead="Simulez une levée et voyez son effet sur la répartition du capital. Outil pédagogique : il ne remplace pas un conseil professionnel." crumbs={[['/actionnariat', 'Actionnariat'], ['', 'Studio de capital']]} subnav={SUBS.actionnariat} />
  <section class="block" style="padding-top:28px">
    <div class="wrap grid g2">
      <div class="panel" id="cap">
        <label class="f" for="pre">Valorisation avant levée : <span data-v="pre"></span></label><input type="range" id="pre" min="50" max="3000" step="10" value="500" />
        <label class="f" for="raise">Montant levé : <span data-v="raise"></span></label><input type="range" id="raise" min="10" max="1500" step="10" value="150" />
        <label class="f" for="pool">Réserve pour les salariés (ESOP) : <span data-v="pool"></span></label><input type="range" id="pool" min="0" max="20" step="1" value="10" />
        <label class="f" for="r2">Simuler une 2e levée (série A) : <span data-v="r2"></span></label><input type="range" id="r2" min="0" max="3000" step="50" value="0" />
        <p class="demo-note">Montants en millions de FCFA. Hypothèses : réserve salariés créée avant la levée ; série A à valorisation triple.</p>
        <div class="row" style="gap:6px"><button class="btn btn-ghost btn-sm" type="button" id="exportCsv">Exporter la table (Excel, CSV)</button><button class="btn btn-ghost btn-sm" type="button" onclick="window.print()">Imprimer / PDF</button></div>
      </div>
      <div class="panel">
        <h3>Répartition après la levée</h3>
        <div class="row" style="gap:20px;align-items:center">
          <svg id="donut" viewBox="0 0 42 42" width="200" height="200" role="img" aria-label="Répartition du capital"></svg>
          <div id="capt" style="flex:1;min-width:200px"></div>
        </div>
      </div>
    </div>
  </section>
  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="panel">
        <h2 style="font-size:1.2rem;margin-top:0">Ma table de capitalisation</h2>
        <p class="small muted">Tenez la table réelle de votre entreprise : associés, catégories d'actions, émissions et cessions, réserve et attributions de BSPCE avec acquisition progressive, historique, et jusqu'à trois scénarios de levée comparés côte à côte.</p>
        {me ? (
          <>
            {tables.map((t) => <a class="list-row" href={`/actionnariat/studio/${t.id}`}><b>{t.company}</b><span class="xs muted">modifiée le {t.updatedAt.toLocaleDateString('fr-FR', { timeZone: 'UTC' })}</span></a>)}
            <form class="row" data-api="/api/actionnariat/tables" style="gap:8px;margin-top:10px;align-items:flex-end;flex-wrap:wrap">
              <div><label class="f" for="nco">Entreprise</label><input class="in" id="nco" name="company" required minlength="2" maxlength="120" style="margin:0" /></div>
              <button class="btn btn-primary btn-sm" type="submit">Créer une table</button>
            </form>
          </>
        ) : <a class="btn btn-primary btn-sm" href="/connexion?retour=/actionnariat/studio">Se connecter pour créer sa table</a>}
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const v = (id: string) => Number((document.getElementById(id) as HTMLInputElement).value);
  const fmt = (n: number) => n.toLocaleString('fr-FR');
  let last: { pre: number; raise: number; pool: number; r2: number; post: number; parts: [string, number, string][] } | null = null;
  function r() {
    const pre = v('pre'), raise = v('raise'), pool = v('pool') / 100, r2 = v('r2');
    const post = pre + raise, inv = raise / post;
    let founders = (1 - inv) * (1 - pool), esop = (1 - inv) * pool, inv1 = inv, invA = 0;
    if (r2) { const d = r2 / (post * 3 + r2); founders *= 1 - d; esop *= 1 - d; inv1 *= 1 - d; invA = d; }
    const set = (k: string, t: string) => (document.querySelector(`[data-v="${k}"]`)!.textContent = t);
    set('pre', fmt(pre) + ' M'); set('raise', fmt(raise) + ' M'); set('pool', Math.round(pool * 100) + ' %'); set('r2', r2 ? fmt(r2) + ' M' : 'aucune');
    const parts = ([['Fondateurs', founders, '#082B4C'], ['Salariés (ESOP)', esop, '#5B8DB8'], ['Investisseurs amorçage', inv1, '#C9962B'], ['Investisseurs série A', invA, '#7A5A12']] as [string, number, string][]).filter((p) => p[1] > 0);
    last = { pre, raise, pool, r2, post, parts };
    // Anneau SVG : cercle de circonférence 100 (r = 15,915)
    let off = 25;
    document.getElementById('donut')!.innerHTML = parts.map(([, x, c]) => {
      const s = `<circle cx="21" cy="21" r="15.915" fill="none" stroke="${c}" stroke-width="6" stroke-dasharray="${(x * 100).toFixed(2)} ${(100 - x * 100).toFixed(2)}" stroke-dashoffset="${off.toFixed(2)}"/>`;
      off -= x * 100;
      return s;
    }).join('');
    document.getElementById('capt')!.innerHTML = parts.map(([n, x, c]) => `<div class="row between" style="padding:6px 0;border-bottom:1px solid var(--line)"><span class="row"><span style="width:12px;height:12px;border-radius:3px;background:${c}"></span>${n}</span><b class="num">${(x * 100).toFixed(1)} %</b></div>`).join('') +
      `<p class="small" style="margin-top:10px">Valorisation après levée : <b>${fmt(post)} M FCFA</b>. Les fondateurs conservent <b>${(founders * 100).toFixed(1)} %</b>${founders < 0.5 ? ' — attention : ils perdent la majorité.' : '.'}</p>`;
  }
  // Export CSV (séparateur « ; », UTF-8 avec BOM : s'ouvre directement dans Excel en français)
  document.getElementById('exportCsv')!.addEventListener('click', () => {
    if (!last) return;
    const n = (x: number) => String(x).replace('.', ',');
    const rows = [
      ['Table de capitalisation simulée — CEA Studio de capital', ''], ['Date', new Date().toLocaleDateString('fr-FR')], [''],
      ['Hypothèse', 'Valeur'], ['Valorisation pré-money (M FCFA)', n(last.pre)], ['Montant levé (M FCFA)', n(last.raise)], ['Réserve salariés (ESOP)', n(Math.round(last.pool * 100)) + ' %'], ['Série A (M FCFA)', n(last.r2)], ['Valorisation post-money (M FCFA)', n(last.post)], [''],
      ['Actionnaire', 'Part du capital (%)'], ...last.parts.map(([name, x]) => [name, n(Math.round(x * 1000) / 10)]), [''],
      ['Simulation pédagogique : ne constitue pas un conseil en investissement.'],
    ];
    const csv = '﻿' + rows.map((r) => r.map((c) => (/[;"]/.test(c) ? `"${c.replace(/"/g, '""')}"` : c)).join(';')).join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
    a.download = 'table-de-capitalisation-cea.csv';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  ['pre', 'raise', 'pool', 'r2'].forEach((id) => document.getElementById(id)!.addEventListener('input', r));
  r();
</script>
