---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { SUBS } from '../../data/site';
import { QUIZ, QUIZ_PASS } from '../../data/quiz-actionnaire';

export const prerender = false;
---
<BaseLayout title="Quiz Actionnaire averti">
  <PageHead title="Quiz « Actionnaire averti »" lead={`${QUIZ.length} questions. ${QUIZ_PASS} bonnes réponses pour obtenir un certificat vérifiable et partageable sur LinkedIn.`} crumbs={[['/actionnariat', 'Actionnariat'], ['', 'Quiz']]} subnav={SUBS.actionnariat} />
  <section class="block">
    <div class="wrap" style="max-width:720px">
      <form class="panel" id="qa">
        {QUIZ.map(({ q, opts }, i) => (
          <fieldset style="border:0;padding:0;margin:0 0 16px">
            <legend style="font-weight:600;margin-bottom:6px">{i + 1}. {q}</legend>
            {opts.map((o, j) => <label class="row small" style="margin:4px 0"><input type="radio" name={`q${i}`} value={j} required /> {o}</label>)}
          </fieldset>
        ))}
        <p class="xs muted">Connexion requise : le certificat est délivré à votre nom.</p>
        <button class="btn btn-primary" type="submit">Valider</button>
      </form>
      <div class="panel" id="cert" hidden style="border:2px solid var(--gold);text-align:center;padding:30px">
        <div class="brand-sub" style="font-size:.8rem">CEA ACADEMY</div>
        <h2 style="margin:10px 0">Certificat « Actionnaire averti »</h2>
        <p>Délivré le <span id="certDate"></span> · n° <b class="num" id="certNo"></b></p>
        <p class="small muted">Toute personne peut vérifier son authenticité en ligne.</p>
        <div class="row" style="justify-content:center;gap:8px">
          <a class="btn btn-ghost btn-sm" id="certVerify" href="#">Vérifier / QR code</a>
          <a class="btn btn-primary btn-sm" id="certLi" href="#" target="_blank" rel="noopener">Ajouter à mon profil LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const form = document.getElementById('qa') as HTMLFormElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const n = form.querySelectorAll('fieldset').length;
    const answers = Array.from({ length: n }, (_, i) => Number(form.querySelector<HTMLInputElement>(`input[name="q${i}"]:checked`)?.value ?? -1));
    const btn = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
    btn.disabled = true;
    const r = await fetch('/api/actionnariat/quiz', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ answers }) }).catch(() => null);
    btn.disabled = false;
    if (r?.status === 401) { location.href = '/connexion?retour=' + encodeURIComponent(location.pathname); return; }
    const d = r ? await r.json().catch(() => ({})) : { error: 'Erreur réseau.' };
    (window as any).toast(d.message ?? d.error ?? 'Une erreur est survenue.');
    if (!d.passed) return;
    document.getElementById('certDate')!.textContent = new Date(d.issuedAt).toLocaleDateString('fr-FR');
    document.getElementById('certNo')!.textContent = d.number;
    (document.getElementById('certVerify') as HTMLAnchorElement).href = d.verify;
    (document.getElementById('certLi') as HTMLAnchorElement).href = d.linkedin;
    form.hidden = true;
    document.getElementById('cert')!.hidden = false;
  });
</script>
