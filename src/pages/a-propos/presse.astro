---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { ARTICLES, SUBS, dateFr } from '../../data/site';

const kit = ['Logos (SVG, PNG)', 'Photos officielles', 'Biographies', "Fiche d'identité"];
---
<BaseLayout title="Presse">
  <PageHead title="Espace presse" lead="Communiqués, kit média et demandes d'interview." crumbs={[['/a-propos', 'À propos'], ['', 'Presse']]} subnav={SUBS.apropos} />
  <section class="block">
    <div class="wrap split">
      <div>
        <h2>Communiqués</h2>
        {ARTICLES.filter((a) => a.cat === 'Communiqué' || a.k).map((a) => (
          <a class="panel" style="display:block;text-decoration:none;margin-bottom:10px" href={`/ressources/article/${a.id}`}><span class="xs muted">{dateFr(a.d)}</span><b style="display:block">{a.t}</b></a>
        ))}
        <h2 style="margin-top:24px">Kit média</h2>
        <div class="row">{kit.map((k) => <button class="btn btn-ghost btn-sm" type="button" data-toast={`Téléchargement : ${k} (simulation).`}>{k}</button>)}</div>
      </div>
      <aside>
        <form class="panel" data-demo="Demande transmise à l'équipe communication.">
          <h3>Demande d'interview</h3>
          <label class="f" for="pm">Média</label><input class="in" id="pm" required />
          <label class="f" for="ps">Sujet</label><input class="in" id="ps" />
          <label class="f" for="pd">Date souhaitée</label><input class="in" id="pd" type="date" />
          <button class="btn btn-primary" type="submit" style="width:100%">Envoyer</button>
        </form>
      </aside>
    </div>
  </section>
</BaseLayout>
