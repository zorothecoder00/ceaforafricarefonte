---
import MediaPlayer from '../../components/MediaPlayer.astro';
import { MEDIA, PRESIDENT_VIDEO } from '../../data/media';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { SUBS } from '../../data/site';

const pillars = [
  ['Vision', 'Des entrepreneurs africains qui créent les emplois du continent, connectés de Dakar à Nairobi.'],
  ['Mission', "Donner à chaque entrepreneur l'accès au savoir, au réseau, au capital et à une voix collective."],
  ['Valeurs', 'Excellence, intégrité, solidarité panafricaine, impact mesurable, neutralité politique.'],
];
const history = [
  ['2024', 'Fondation de CEA FOR AFRICA à Lomé', 'done'],
  ['2025', "Premières cohortes d'accompagnement dans 6 pays", 'done'],
  ['2026', 'Lancement de CEA Kapital Invest et de la plateforme numérique', 'cur'],
  ['2027', 'Ouverture de 10 nouveaux pays et des langues portugaise et arabe', ''],
];
---
<BaseLayout title="À propos">
  <PageHead title="Connecter, entreprendre, accélérer" lead="CEA FOR AFRICA réunit les entrepreneurs du continent pour apprendre, se financer, recruter et peser ensemble." crumbs={[['', 'À propos']]} subnav={SUBS.apropos} />
  <section class="block">
    <div class="wrap">
      <div class="grid g3">{pillars.map(([t, d]) => <div class="panel"><h3>{t}</h3><p style="margin:0">{d}</p></div>)}</div>
      <h2 style="margin-top:40px">Notre histoire</h2>
      <ol class="timeline">{history.map(([y, t, c]) => <li class={c}><b>{y}</b> — {t}</li>)}</ol>
      {MEDIA[PRESIDENT_VIDEO] ? (
        <details class="panel" style="margin-top:30px">
          <summary class="row between" style="list-style:none"><div><h3 style="margin:0">Le mot du Président</h3><p class="muted small" style="margin:0">Vidéo de 2 minutes, sous-titrée en français et en anglais.</p></div><span class="btn btn-primary">Regarder</span></summary>
          <div style="margin-top:14px"><MediaPlayer title={PRESIDENT_VIDEO} ratio="16/9" /></div>
        </details>
      ) : (
        <div class="panel row between" style="margin-top:30px"><div><h3 style="margin:0">Le mot du Président</h3><p class="muted small" style="margin:0">Vidéo de 2 minutes, sous-titrée en français et en anglais. Publication prochaine.</p></div><span class="btn btn-primary" aria-disabled="true" style="opacity:.6">Regarder</span></div>
      )}
    </div>
  </section>
</BaseLayout>
