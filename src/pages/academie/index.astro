---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import CourseCard from '../../components/CourseCard.astro';
import KapitalAd from '../../components/KapitalAd.astro';
import { COURSES, SUBS } from '../../data/site';
import { META } from '../../data/course-content';

// Thèmes du CDC §7.6 (création, finance, marketing, vente, numérique, gestion, juridique, export ZLECAf, leadership), puis les thèmes propres à CEA
const CDC_THEMES = ['Création', 'Finance', 'Marketing', 'Vente', 'Numérique', 'Gestion', 'Juridique', 'Export', 'Leadership'];
const themes = [...CDC_THEMES, ...new Set(COURSES.map((c) => c.th).filter((t) => !CDC_THEMES.includes(t)))];
const nTheme = (t: string) => COURSES.filter((c) => c.th === t).length;
const langs = [...new Set(COURSES.flatMap((c) => META[c.id]?.langs ?? ['Français']))];
---
<BaseLayout title="Académie">
  <PageHead title="CEA Academy" lead="Des cours courts, pratiques et certifiants, pensés pour le téléphone et les petits forfaits. Téléchargeables hors ligne." crumbs={[['', 'Académie']]} subnav={SUBS.academie} />
  <section class="block" style="padding-top:20px">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filtrer les cours" id="cf">
        <button class="chip" type="button" aria-pressed="true" data-th="Tous">Tous ({COURSES.length})</button>
        {themes.map((t) => <button class="chip" type="button" aria-pressed="false" data-th={t} disabled={nTheme(t) === 0} title={nTheme(t) === 0 ? 'Cours en préparation' : undefined}>{t === 'Export' ? 'Export ZLECAf' : t} ({nTheme(t)})</button>)}
        <select class="in" id="lvSel" aria-label="Niveau"><option value="">Tous niveaux</option><option>Débutant</option><option>Intermédiaire</option><option>Avancé</option></select>
        <select class="in" id="langSel" aria-label="Langue"><option value="">Toutes langues</option>{langs.map((l) => <option>{l}</option>)}</select>
        <select class="in" id="durSel" aria-label="Durée"><option value="">Toutes durées</option><option value="0-90">Moins d’1 h 30</option><option value="90-150">1 h 30 à 2 h 30</option><option value="150-9999">Plus de 2 h 30</option></select>
        <label class="chip"><input type="checkbox" id="free" /> Gratuits</label>
        <input class="in" id="cq" type="search" placeholder="Rechercher un cours, un formateur…" aria-label="Rechercher un cours" style="flex:1;min-width:200px" />
        <select class="in" id="sortSel" aria-label="Trier"><option value="">Ordre par défaut</option><option value="court">Plus courts d’abord</option><option value="prix">Prix croissant</option></select>
        <button class="btn btn-ghost btn-sm" type="button" id="cReset">Réinitialiser</button>
      </div>
      <p class="small muted" id="cCount" aria-live="polite" style="margin:0 0 12px"></p>
      <div class="split">
        <div>
          <div class="grid g2" id="cl">{COURSES.map((c) => <CourseCard c={c} />)}</div>
          <div class="empty" id="cEmpty" hidden>Aucun cours pour ces filtres. <button class="btn btn-ghost btn-sm" type="button" onclick="document.getElementById('cReset').click()">Voir tous les cours</button></div>
        </div>
        <aside>
          <KapitalAd variant={2} />
          <div class="panel" style="margin-top:16px">
            <h3>Recommandé pour vous</h3>
            <p class="small muted">Pour bien démarrer.</p>
            {[COURSES[0], COURSES[4]].map((c) => <a href={`/academie/${c.id}`} class="small" style="display:block;padding:6px 0">{c.t}</a>)}
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  let th = 'Tous';
  const chips = [...document.querySelectorAll<HTMLButtonElement>('#cf [data-th]')];
  const lv = document.getElementById('lvSel') as HTMLSelectElement;
  const free = document.getElementById('free') as HTMLInputElement;
  const lang = document.getElementById('langSel') as HTMLSelectElement, dur = document.getElementById('durSel') as HTMLSelectElement;
  const inDur = (el: HTMLElement) => { if (!dur.value) return true; const [a, b] = dur.value.split('-').map(Number); const m = Number(el.dataset.min); return m >= a && m < b; };
  const q = document.getElementById('cq') as HTMLInputElement;
  const sort = document.getElementById('sortSel') as HTMLSelectElement;
  const list = document.getElementById('cl')!;
  const cards = [...list.querySelectorAll<HTMLElement>(':scope > a')];
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  function apply() {
    let n = 0;
    document.querySelectorAll<HTMLElement>('#cl > a').forEach((el) => {
      const ok = (th === 'Tous' || el.dataset.th === th) && (!lv.value || el.dataset.lv === lv.value) && (!free.checked || el.dataset.free === '1') && norm(el.dataset.q ?? '').includes(norm(q.value.trim())) && (!lang.value || (el.dataset.lang ?? '').split('|').includes(lang.value)) && inDur(el);
      el.hidden = !ok;
      if (ok) n++;
    });
    document.getElementById('cEmpty')!.hidden = n > 0;
    document.getElementById('cCount')!.textContent = `${n} cours sur ${cards.length}`;
    // Filtres reflétés dans l'adresse : recherche partageable, retour arrière conservé
    const u = new URL(location.href);
    const set = (k: string, v: string) => (v ? u.searchParams.set(k, v) : u.searchParams.delete(k));
    set('theme', th === 'Tous' ? '' : th); set('niveau', lv.value); set('langue', lang.value); set('duree', dur.value); set('gratuit', free.checked ? '1' : ''); set('q', q.value.trim()); set('tri', sort.value);
    history.replaceState(null, '', u);
    const key = sort.value === 'court' ? 'min' : sort.value === 'prix' ? 'price' : '';
    (key ? [...cards].sort((a, b) => Number(a.dataset[key]) - Number(b.dataset[key])) : cards).forEach((c) => list.appendChild(c));
  }
  chips.forEach((c) => c.addEventListener('click', () => {
    th = c.dataset.th!;
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    apply();
  }));
  // Restauration depuis l'adresse (?theme=Finance&langue=Anglais…)
  const sp = new URLSearchParams(location.search);
  const pick = (sel: HTMLSelectElement, v: string | null) => { if (v && [...sel.options].some((o) => o.value === v)) sel.value = v; };
  const t0 = sp.get('theme');
  if (t0 && chips.some((c) => c.dataset.th === t0 && !c.disabled)) { th = t0; chips.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.th === t0))); }
  pick(lv, sp.get('niveau')); pick(lang, sp.get('langue')); pick(dur, sp.get('duree')); pick(sort, sp.get('tri'));
  free.checked = sp.get('gratuit') === '1'; q.value = sp.get('q') ?? '';
  document.getElementById('cReset')!.addEventListener('click', () => {
    th = 'Tous'; chips.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.th === 'Tous')));
    lv.value = lang.value = dur.value = sort.value = q.value = ''; free.checked = false; apply();
  });
  apply();
  lv.addEventListener('change', apply);
  free.addEventListener('change', apply);
  lang.addEventListener('change', apply);
  dur.addEventListener('change', apply);
  q.addEventListener('input', apply);
  sort.addEventListener('change', apply);
</script>
