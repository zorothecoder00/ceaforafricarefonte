---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import MentorList from '../../components/MentorList.astro';
import { SUBS } from '../../data/site';

export const prerender = false;
---
<BaseLayout title="Experts à la demande">
  <PageHead title="Experts à la demande" lead="Des consultations courtes (45 minutes) avec des experts vérifiés : juridique, fiscal, financier, marketing. Paiement Mobile Money ou carte." crumbs={[['/academie', 'Académie'], ['', 'Experts']]} subnav={SUBS.academie} />
  <section class="block">
    <div class="wrap">
      <MentorList kind="expert" />
      <p class="small muted" style="margin-top:18px">Vous êtes expert ? <a href="/espace/mentor">Proposer vos consultations</a></p>
    </div>
  </section>
</BaseLayout>
