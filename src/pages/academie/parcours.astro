---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { PATHS, COURSES, SUBS } from '../../data/site';
---
<BaseLayout title="Parcours certifiants">
  <PageHead title="Parcours certifiants" lead="Des suites de cours cohérentes, validées par un certificat vérifiable par QR code." crumbs={[['/academie', 'Académie'], ['', 'Parcours']]} subnav={SUBS.academie} />
  <section class="block">
    <div class="wrap grid g3">
      {PATHS.map((p) => (
        <div class="panel">
          <h3>{p.t}</h3>
          <p class="small muted">{p.d}</p>
          <ol class="timeline">{p.c.map((id) => { const c = COURSES.find((x) => x.id === id)!; return <li><a href={`/academie/${c.id}`}>{c.t}</a></li>; })}</ol>
          <button class="btn btn-primary btn-sm" data-toast={`Inscription au ${p.t} enregistrée.`}>Suivre ce parcours</button>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
