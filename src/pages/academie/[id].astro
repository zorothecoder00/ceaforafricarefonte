---
/* Lecteur de cours CEA Academy (CDC §7.6) : leçons courtes, notes personnelles, progression en base, quiz final corrigé côté serveur,
   certificat vérifiable, lecture hors ligne (PWA). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import KapitalAd from '../../components/KapitalAd.astro';
import Money from '../../components/Money.astro';
import CmsBody from '../../components/CmsBody.astro';
import MediaPlayer from '../../components/MediaPlayer.astro';
import { PASS_MARK } from '../../data/course-content';
import { allCourses } from '../../lib/catalog';
import { getLang } from '../../i18n/ui';
import { initials } from '../../data/site';

export const prerender = false;
const COURSES = await allCourses({ lang: getLang(Astro.currentLocale) === 'en' ? 'en' : 'fr' });
const c = COURSES.find((x) => x.id === Astro.params.id);
if (!c) return Astro.rewrite('/404');
const content = c.content;
const meta = c.meta;
const finance = c.th === 'Finance' || c.th === 'Levée de fonds';
const last = c.ls.length - 1;
const related = COURSES.filter((x) => x.id !== c.id && (x.th === c.th || x.lv === c.lv)).slice(0, 3);
---
<BaseLayout title={c.t}>
  <PageHead listen=".lesson:not([hidden])" title={c.t} lead={`${c.th} · ${c.lv} · ${c.dur} · ${meta?.langs.join(', ') ?? 'Français'} · par ${c.by}`} crumbs={[['/academie', 'Académie'], ['', c.th]]} />
  <section class="block" style="padding-top:28px">
    <div class="wrap split" id="course" data-course={c.id} data-last={last}>
      <div>
        {meta?.trailer && <div style="margin-bottom:12px"><MediaPlayer title={`Présentation : ${c.t}`} url={meta.trailer} captions={meta.captions} ratio="16/9" /></div>}
        <div class="player" id="intro" style={meta?.trailer ? 'aspect-ratio:auto' : undefined}>
          <div style="text-align:center;padding:20px">
            <h2 style="color:#fff">{c.t}</h2>
            <p style="color:#C9D6E5">{c.ls.length - 1} leçons de moins de 15 minutes + quiz final · certificat vérifiable</p>
            <button class="btn btn-gold" type="button" id="enroll">S'inscrire — <Money xof={c.price} /></button>
          </div>
        </div>

        {c.body.length > 0 && <div class="panel" style="margin-top:18px"><CmsBody blocks={c.body} coverId={c.coverId} /></div>}
        {c.ls.slice(0, last).map((l, i) => (
          <article class="panel lesson" data-lesson={i} hidden={i !== 0} style="margin-top:18px">
            <span class="tag info">Leçon {i + 1} sur {last}</span>
            <h2 style="font-size:1.3rem;margin:10px 0">{l}</h2>
            {content?.lessons[i]?.video && <div style="margin:0 0 14px"><MediaPlayer title={`Leçon ${i + 1} : ${l}`} url={content.lessons[i].video} ratio="16/9" /></div>}
            <p>{content?.lessons[i]?.s}</p>
            <h3 style="font-size:1rem">À retenir</h3>
            <ul>{content?.lessons[i]?.k.map((k) => <li>{k}</li>)}</ul>
            <label class="f" for={`note-${i}`}>Mes notes (enregistrées sur cet appareil)</label>
            <textarea class="in" id={`note-${i}`} data-note={i} placeholder="Vos idées pour votre entreprise…"></textarea>
            {content?.lessons[i] && (
              <div class="tutor" data-tutor={i} style="border:1px dashed var(--line);border-radius:10px;padding:10px 12px;margin-top:12px">
                <b class="small">Tuteur IA</b> <span class="xs muted">— réponses générées par IA à partir de cette leçon</span>
                <div class="row" style="gap:6px;flex-wrap:wrap;margin-top:8px">
                  <button class="btn btn-ghost btn-sm" type="button" data-act="expliquer">Expliquer simplement</button>
                  <button class="btn btn-ghost btn-sm" type="button" data-act="resumer">Résumer</button>
                  <button class="btn btn-ghost btn-sm" type="button" data-act="quiz">M'entraîner (quiz)</button>
                </div>
                <form class="row" style="gap:6px;margin-top:8px" data-act="question">
                  <input class="in" name="question" maxlength="600" placeholder="Posez une question sur cette leçon" aria-label="Question au tuteur" style="flex:1;min-width:180px" />
                  <button class="btn btn-ghost btn-sm" type="submit">Demander</button>
                </form>
                <div class="small" data-out aria-live="polite" style="margin-top:8px;white-space:pre-wrap"></div>
              </div>
            )}
            <div class="row between" style="margin-top:8px">
              <button class="btn btn-ghost btn-sm" type="button" data-go={i - 1} disabled={i === 0}>← Précédente</button>
              <button class="btn btn-primary btn-sm" type="button" data-done={i}>Marquer comme terminée</button>
              <button class="btn btn-ghost btn-sm" type="button" data-go={i + 1}>{i === last - 1 ? 'Quiz final →' : 'Suivante →'}</button>
            </div>
          </article>
        ))}

        <form class="panel lesson" data-lesson={last} id="quiz" hidden style="margin-top:18px">
          <span class="tag gold">Quiz final</span>
          <h2 style="font-size:1.3rem;margin:10px 0">Validez vos acquis</h2>
          <p class="small muted">{content?.quiz.length} questions · {Math.ceil(PASS_MARK * (content?.quiz.length ?? 0))} bonnes réponses requises · tentatives illimitées.</p>
          {content?.quiz.map((q, qi) => (
            <fieldset style="border:0;padding:0;margin:0 0 14px">
              <legend style="font-weight:600;margin-bottom:6px">{qi + 1}. {q.q}</legend>
              {q.o.map((o, oi) => <label class="row small" style="margin-bottom:4px"><input type="radio" name={`q${qi}`} value={oi} required /> {o}</label>)}
            </fieldset>
          ))}
          <button class="btn btn-primary" type="submit">Valider mes réponses</button>
          <p class="small" id="quizMsg" style="margin:10px 0 0" aria-live="polite"></p>
        </form>

        <div class="panel" style="margin-top:18px">
          <h3>Ce que vous allez apprendre</h3>
          <p>{c.ls.slice(0, -1).join(', ')}. Chaque leçon s'appuie sur des exemples d'entreprises africaines.</p>
          <button class="btn btn-ghost btn-sm" type="button" id="offline">Enregistrer pour lecture hors ligne</button>
        </div>

        {meta && (
          <div class="panel row" style="margin-top:18px;gap:14px;align-items:flex-start">
            <span class="avatar" aria-hidden="true">{initials(c.by)}</span>
            <div><h3 style="margin:0">Votre formateur : {c.by}</h3><p class="small muted" style="margin:2px 0 6px">{meta.trainer.role}</p><p class="small" style="margin:0">{meta.trainer.bio}</p></div>
          </div>
        )}

        <div class="panel" style="margin-top:18px" id="reviews" data-course={c.id}>
          <div class="row between"><h3 style="margin:0">Avis des apprenants</h3><b id="revAvg" class="small"></b></div>
          <div id="revList" class="small" style="margin-top:8px"><p class="muted">Chargement des avis…</p></div>
          <form id="revForm" hidden style="margin-top:12px;border-top:1px solid var(--line);padding-top:12px">
            <fieldset style="border:0;padding:0;margin:0 0 8px"><legend class="small" style="font-weight:600">Votre note</legend>
              <div class="row" style="gap:4px">{[1, 2, 3, 4, 5].map((n) => <label class="chip"><input type="radio" name="rating" value={n} required /> {n} ★</label>)}</div>
            </fieldset>
            <label class="f" for="revC">Votre commentaire (facultatif)</label>
            <textarea class="in" id="revC" name="comment" maxlength="1500" placeholder="Ce que ce cours vous a apporté…"></textarea>
            <button class="btn btn-primary btn-sm" type="submit">Publier mon avis</button>
          </form>
          <p class="xs muted" id="revHint" style="margin:10px 0 0">Seuls les inscrits au cours peuvent donner leur avis.</p>
        </div>
      </div>
      <aside>
        <div class="panel">
          <h3>Programme</h3>
          <ul class="lessons" id="lessons">{c.ls.map((l, i) => <li tabindex="0" role="button" aria-checked="false" data-i={i}><span class="check">{i + 1}</span>{l}</li>)}</ul>
          <div class="progress" style="margin-top:12px"><span id="bar" style="width:0"></span></div>
          <p class="small" id="prog" style="margin:8px 0 0"></p>
          <a class="btn btn-ghost btn-sm" href="/espace/apprentissage" style="margin-top:10px">Mon apprentissage</a>
        </div>
        {related.length > 0 && <div class="panel" style="margin-top:16px"><h3>Pour aller plus loin</h3>{related.map((r) => <a class="small" href={`/academie/${r.id}`} style="display:block;padding:4px 0">{r.t}</a>)}</div>}
        <div style="margin-top:16px"><KapitalAd variant={finance ? 0 : 2} /></div>
      </aside>
    </div>
  </section>
</BaseLayout>
<script>
  // Progression en base (compte connecté) ; certificat vérifiable délivré quand toutes les leçons et le quiz sont validés.
  const root = document.getElementById('course')!;
  const id = root.dataset.course!, last = Number(root.dataset.last);
  const items = [...document.querySelectorAll<HTMLLIElement>('#lessons li')];
  const lessons = [...document.querySelectorAll<HTMLElement>('.lesson')];
  const toast = (t: string) => (window as unknown as { toast: (t: string) => void }).toast(t);
  const enrollBtn = document.getElementById('enroll')!, prog = document.getElementById('prog')!, bar = document.getElementById('bar')!;
  const prefix = location.pathname.startsWith('/en/') ? '/en' : '';
  let enrolled = false, done: number[] = [], cert: string | null = null;

  function show(i: number, scroll = true) {
    if (i < 0 || i > last) return;
    lessons.forEach((l) => (l.hidden = Number(l.dataset.lesson) !== i));
    // La vidéo d'une leçon quittée s'arrête (fichier, YouTube ou Vimeo)
    lessons.filter((l) => l.hidden).forEach((l) => {
      l.querySelectorAll('video').forEach((v) => v.pause());
      l.querySelectorAll('iframe').forEach((f) => {
        const o = new URL(f.src).origin;
        f.contentWindow?.postMessage(o.includes('vimeo') ? { method: 'pause' } : JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] }), o);
      });
    });
    items.forEach((li, k) => li.classList.toggle('cur', k === i));
    try { localStorage.setItem(`cea-course-${id}-at`, String(i)); } catch { /* ignoré */ }
    if (scroll) lessons[i]?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function draw() {
    items.forEach((li, i) => {
      const ok = done.includes(i);
      li.setAttribute('aria-checked', String(ok));
      const c = li.querySelector('.check')!;
      c.classList.toggle('done', ok);
      c.textContent = ok ? '✓' : String(i + 1);
    });
    document.querySelectorAll<HTMLButtonElement>('[data-done]').forEach((b) => { const ok = done.includes(Number(b.dataset.done)); b.textContent = ok ? '✓ Terminée' : 'Marquer comme terminée'; b.classList.toggle('btn-primary', !ok); b.classList.toggle('btn-ghost', ok); });
    enrollBtn.hidden = enrolled;
    showReviewForm();
    const pct = Math.round((done.length / items.length) * 100);
    bar.style.width = (enrolled ? pct : 0) + '%';
    prog.innerHTML = enrolled
      ? `Progression : ${pct} %${cert ? ` — <a href="/verifier/certificat/${cert}">voir mon certificat</a>` : ''}`
      : 'Inscrivez-vous pour suivre votre progression et obtenir le certificat.';
  }
  async function post(body: Record<string, unknown>) {
    const res = await fetch('/api/academie/progression', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ courseId: id, ...body }) });
    if (res.status === 401) { location.href = prefix + '/connexion?retour=' + encodeURIComponent(location.pathname); return null; }
    const d = await res.json();
    if (res.status === 402 && d.pay) { location.href = `/paiement?objet=${d.pay.purpose}&ref=${d.pay.item}`; return null; }
    if (!d.ok) { toast(d.error || 'Erreur.'); return null; }
    return d;
  }
  fetch('/api/academie/progression?course=' + id).then((r) => r.json()).then((d) => { enrolled = d.enrolled; done = d.done; cert = d.certificate; draw(); }).catch(draw);
  enrollBtn.addEventListener('click', async () => { const d = await post({}); if (d) { enrolled = true; done = d.done; toast(d.message); draw(); } });

  items.forEach((li, i) => {
    li.addEventListener('click', () => show(i));
    li.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); show(i); } });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.go))));
  document.querySelectorAll<HTMLButtonElement>('[data-done]').forEach((b) => b.addEventListener('click', async () => {
    if (!enrolled) return toast("Inscrivez-vous d'abord au cours.");
    const i = Number(b.dataset.done);
    const d = await post({ lesson: i, done: !done.includes(i) });
    if (!d) return;
    done = d.done; cert = d.certificate; draw();
    if (d.done.includes(i) && i < last) show(i + 1);
  }));

  const quiz = document.getElementById('quiz') as HTMLFormElement;
  quiz.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!enrolled) return toast("Inscrivez-vous d'abord au cours.");
    const n = quiz.querySelectorAll('fieldset').length;
    const answers = Array.from({ length: n }, (_, i) => Number((quiz.querySelector<HTMLInputElement>(`input[name="q${i}"]:checked`)?.value) ?? -1));
    const d = await post({ quiz: answers });
    if (!d) return;
    done = d.done; cert = d.certificate; draw();
    document.getElementById('quizMsg')!.textContent = d.message;
    toast(d.message);
  });

  // Notes personnelles : stockées sur l'appareil uniquement
  document.querySelectorAll<HTMLTextAreaElement>('[data-note]').forEach((t) => {
    const k = `cea-note-${id}-${t.dataset.note}`;
    try { t.value = localStorage.getItem(k) ?? ''; } catch { /* ignoré */ }
    t.addEventListener('input', () => { try { localStorage.setItem(k, t.value); } catch { /* ignoré */ } });
  });
  document.getElementById('offline')!.addEventListener('click', async () => {
    try {
      if (!('caches' in window)) throw new Error();
      const c = await caches.open('cea-v1-pages');
      await c.add(location.pathname);
      toast('Cours enregistré : il restera lisible sans connexion.');
    } catch { toast('Lecture hors ligne indisponible sur ce navigateur.'); }
  });
  // Avis : chargés depuis l'API (la page est statique)
  const revList = document.getElementById('revList')!, revForm = document.getElementById('revForm') as HTMLFormElement;
  const escH = (t: string) => t.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);
  type Rev = { name: string; country: string | null; rating: number; comment: string | null; at: string };
  async function loadReviews() {
    const d = await fetch('/api/academie/avis?course=' + id).then((r) => r.json()).catch(() => null);
    if (!d?.ok) { revList.innerHTML = '<p class="muted">Avis indisponibles hors connexion.</p>'; return; }
    document.getElementById('revAvg')!.textContent = d.average ? `${String(d.average).replace('.', ',')} ★ · ${d.count} avis` : '';
    revList.innerHTML = d.reviews.length
      ? d.reviews.map((r: Rev) => `<div style="padding:8px 0;border-bottom:1px solid var(--line)"><b>${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}</b> <span class="muted">${escH(r.name)} · ${new Date(r.at).toLocaleDateString('fr-FR')}</span>${r.comment ? `<p style="margin:4px 0 0;white-space:pre-wrap">${escH(r.comment)}</p>` : ''}</div>`).join('')
      : '<p class="muted">Pas encore d’avis : soyez le premier à partager votre expérience.</p>';
    if (d.mine) {
      revForm.querySelector<HTMLInputElement>(`input[name="rating"][value="${d.mine.rating}"]`)!.checked = true;
      (revForm.elements.namedItem('comment') as HTMLTextAreaElement).value = d.mine.comment ?? '';
      revForm.querySelector('button')!.textContent = 'Mettre à jour mon avis';
      pending = d.mine.hidden;
      if (pending) document.getElementById('revHint')!.textContent = 'Votre avis est en attente de vérification par la modération.';
      showReviewForm();
    }
  }
  let pending = false;
  function showReviewForm() { revForm.hidden = !enrolled; document.getElementById('revHint')!.hidden = enrolled && !pending; }
  revForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(revForm);
    const r = await fetch('/api/academie/avis', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ courseId: id, rating: Number(fd.get('rating')), comment: fd.get('comment') }) });
    const d = await r.json().catch(() => ({ error: 'Erreur réseau.' }));
    toast(d.message ?? d.error);
    if (d.ok) loadReviews();
  });
  loadReviews();
  let start = 0;
  try { start = Number(localStorage.getItem(`cea-course-${id}-at`) ?? 0); } catch { /* ignoré */ }
  show(Math.min(Math.max(start, 0), last), false);

  /* Tuteur IA (CDC §11) : explication, résumé, quiz d'entraînement (sans effet sur le certificat) ou question libre */
  const escT = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  document.querySelectorAll<HTMLElement>('[data-tutor]').forEach((box) => {
    const out = box.querySelector<HTMLElement>('[data-out]')!;
    const ask = async (action: string, question?: string) => {
      out.innerHTML = '<span class="muted">Le tuteur réfléchit…</span>';
      const r = await fetch('/api/academie/tuteur', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ course: id, lesson: Number(box.dataset.tutor), action, question, lang: prefix ? 'en' : 'fr' }) }).catch(() => null);
      const d = r ? await r.json().catch(() => ({})) : {};
      if (r?.status === 401) { out.innerHTML = `<a href="/connexion?retour=${encodeURIComponent(location.pathname)}">Connectez-vous</a> pour utiliser le tuteur.`; return; }
      if (!d.ok) { out.textContent = d.error ?? 'Erreur réseau.'; return; }
      if (d.text) { out.textContent = d.text; return; }
      // Quiz d'entraînement : correction immédiate, côté navigateur
      out.innerHTML = '<p class="xs muted" style="margin:0 0 6px">Quiz d\'entraînement généré par IA — il ne compte pas pour le certificat.</p>' + d.quiz.map((q: { q: string; o: string[]; a: number; why: string }, qi: number) =>
        `<fieldset style="border:0;padding:0;margin:0 0 10px" data-a="${q.a}"><legend><b>${qi + 1}. ${escT(q.q)}</b></legend>${q.o.map((o, oi) => `<label class="row small" style="gap:6px"><input type="radio" name="tq-${box.dataset.tutor}-${qi}" value="${oi}" /> ${escT(o)}</label>`).join('')}<p class="xs" data-why hidden>${escT(q.why)}</p></fieldset>`).join('');
      out.querySelectorAll<HTMLFieldSetElement>('fieldset').forEach((fs) => fs.addEventListener('change', (e) => {
        const ok = (e.target as HTMLInputElement).value === fs.dataset.a;
        const why = fs.querySelector<HTMLElement>('[data-why]')!;
        why.hidden = false;
        why.innerHTML = `<b style="color:var(${ok ? '--ok' : '--bad'})">${ok ? 'Bonne réponse.' : 'Pas tout à fait.'}</b> ${escT(why.dataset.t ??= why.textContent ?? '')}`;
      }));
    };
    box.querySelectorAll<HTMLButtonElement>('button[data-act]').forEach((b) => b.addEventListener('click', () => ask(b.dataset.act!)));
    box.querySelector<HTMLFormElement>('form')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const inp = (e.target as HTMLFormElement).question as HTMLInputElement;
      if (inp.value.trim()) ask('question', inp.value.trim());
    });
  });
</script>
