---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import KapitalAd from '../../components/KapitalAd.astro';
import Money from '../../components/Money.astro';
import { COURSES } from '../../data/site';

export function getStaticPaths() {
  return COURSES.map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props;
const finance = c.th === 'Finance' || c.th === 'Levée de fonds';
---
<BaseLayout title={c.t}>
  <PageHead title={c.t} lead={`${c.th} · ${c.lv} · ${c.dur} · par ${c.by}`} crumbs={[['/academie', 'Académie'], ['', c.th]]} />
  <section class="block" style="padding-top:28px">
    <div class="wrap split">
      <div>
        <div class="player">
          <div style="text-align:center;padding:20px">
            <h2 style="color:#fff">{c.t}</h2>
            <p style="color:#C9D6E5">{c.ls.length} leçons · certificat vérifiable à la fin</p>
            <button class="btn btn-gold" type="button" id="enroll">S'inscrire — <Money xof={c.price} /></button>
          </div>
        </div>
        <div class="panel" style="margin-top:18px">
          <h3>Ce que vous allez apprendre</h3>
          <p>{c.ls.slice(0, -1).join(', ')}. Chaque leçon dure moins de 15 minutes et s'appuie sur des exemples d'entreprises africaines.</p>
        </div>
      </div>
      <aside>
        <div class="panel">
          <h3>Programme</h3>
          <ul class="lessons" id="lessons" data-course={c.id}>{c.ls.map((l, i) => <li tabindex="0" role="checkbox" aria-checked="false" data-i={i}><span class="check">{i + 1}</span>{l}</li>)}</ul>
          <p class="small" id="prog" style="margin:12px 0 0"></p>
          <a class="btn btn-ghost btn-sm" href="/espace/apprentissage" style="margin-top:10px">Mon apprentissage</a>
        </div>
        <div style="margin-top:16px"><KapitalAd variant={finance ? 0 : 2} /></div>
      </aside>
    </div>
  </section>
</BaseLayout>
<script>
  // Progression enregistrée en base (compte connecté) ; certificat vérifiable délivré à 100 %.
  const ul = document.getElementById('lessons')!;
  const id = ul.dataset.course!;
  const items = [...ul.querySelectorAll<HTMLLIElement>('li')];
  const toast = (t: string) => (window as unknown as { toast: (t: string) => void }).toast(t);
  const enrollBtn = document.getElementById('enroll')!;
  const prog = document.getElementById('prog')!;
  const prefix = location.pathname.startsWith('/en/') ? '/en' : '';
  let enrolled = false, done: number[] = [], cert: string | null = null;
  function draw() {
    items.forEach((li, i) => {
      const ok = done.includes(i);
      li.setAttribute('aria-checked', String(ok));
      const c = li.querySelector('.check')!;
      c.classList.toggle('done', ok);
      c.textContent = ok ? '✓' : String(i + 1);
    });
    enrollBtn.hidden = enrolled;
    prog.innerHTML = enrolled
      ? `Progression : ${Math.round((done.length / items.length) * 100)} %${cert ? ` — <a href="/verifier/certificat/${cert}">voir mon certificat</a>` : ''}`
      : 'Inscrivez-vous pour suivre votre progression et obtenir le certificat.';
  }
  async function post(body: Record<string, unknown>) {
    const res = await fetch('/api/academie/progression', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ courseId: id, ...body }) });
    if (res.status === 401) { location.href = prefix + '/connexion?retour=' + encodeURIComponent(location.pathname); return null; }
    const d = await res.json();
    if (res.status === 402 && d.pay) { location.href = `/paiement?objet=${d.pay.purpose}&ref=${d.pay.item}`; return null; }
    if (!d.ok) { toast(d.error || 'Erreur.'); return null; }
    return d;
  }
  fetch('/api/academie/progression?course=' + id).then((r) => r.json()).then((d) => { enrolled = d.enrolled; done = d.done; cert = d.certificate; draw(); }).catch(draw);
  enrollBtn.addEventListener('click', async () => { const d = await post({}); if (d) { enrolled = true; done = d.done; toast(d.message); draw(); } });
  items.forEach((li, i) => {
    const flip = async () => {
      if (!enrolled) return toast("Inscrivez-vous d'abord au cours.");
      const d = await post({ lesson: i, done: !done.includes(i) });
      if (!d) return;
      done = d.done; cert = d.certificate; draw();
      if (d.complete) toast(d.message);
    };
    li.addEventListener('click', flip);
    li.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } });
  });
</script>
