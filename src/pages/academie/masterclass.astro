---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { MASTERCLASS, SUBS } from '../../data/site';
---
<BaseLayout title="Masterclass">
  <PageHead title="Masterclass" lead="Des leçons de grands dirigeants africains, en vidéo." crumbs={[['/academie', 'Académie'], ['', 'Masterclass']]} subnav={SUBS.academie} />
  <section class="block">
    <div class="wrap grid g3">
      {MASTERCLASS.map((m) => (
        <div class="panel">
          <div class="player" style="aspect-ratio:16/10">
            <button class="playbtn" aria-label={`Lire ${m.t}`} data-toast="Lecture de la masterclass (simulation)."><svg width="28" height="28" viewBox="0 0 24 24" fill="#1B1305"><path d="M8 5v14l11-7z" /></svg></button>
            <span class="cap">{m.dur}</span>
          </div>
          <h3 style="margin-top:14px">{m.t}</h3>
          <p class="small muted" style="margin:0">{m.by}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
