---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import AfricaMap from '../../components/AfricaMap.astro';
import { HUBS, REGIONS, SUBS, country, regionOf } from '../../data/site';

export const prerender = false;
---
<BaseLayout title="Présence en Afrique">
  <PageHead title="Présence en Afrique" lead={`${REGIONS.length} bureaux régionaux et ${HUBS.length} bureaux de représentation pays. Cliquez sur la carte ou dans la liste.`} crumbs={[['/a-propos', 'À propos'], ['', 'Présence en Afrique']]} subnav={SUBS.apropos} />
  <section class="block">
    <div class="wrap">
      <h2>Bureaux régionaux</h2>
      <div class="grid g3">{REGIONS.map((r) => <div class="panel"><span class="tag gold">Bureau régional</span><h3 style="margin:8px 0 4px">{r.n}</h3><p class="small muted" style="margin:0 0 8px">{r.city} · Directeur·rice régional·e : {r.lead}</p><div class="row" style="gap:6px">{r.cs.map((c) => (HUBS.some((h) => h.c === c) ? <a class="chip" href={`/pays/${c.toLowerCase()}`}>{country(c)}</a> : <span class="chip">{country(c)}</span>))}</div></div>)}</div>
      <h2 style="margin-top:36px">Bureaux de représentation</h2>
      <div class="split">
        <div class="panel" style="background:#082B4C;border:0"><AfricaMap /></div>
        <div class="grid" style="gap:8px;align-content:start">
          {HUBS.map((h) => <a class="panel row between" style="padding:12px 16px;text-decoration:none" href={`/pays/${h.c.toLowerCase()}`}><span><b>{country(h.c)}</b> <span class="small muted">· {h.city}{h.hq ? ' · siège' : ''}</span></span><span class="small muted">{regionOf(h.c)?.n ?? ''}</span></a>)}
        </div>
      </div>
      <div class="row" style="margin-top:20px"><a class="btn btn-primary" href="/representants">Rencontrer les représentants</a><a class="btn btn-ghost" href="/inscription">Inscrire mon entreprise dans mon pays</a></div>
    </div>
  </section>
</BaseLayout>
