---
/* Parrainage (CDC §7.8) : lien personnel à partager, suivi des filleuls, points gagnés. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { SUBS, dateFr } from '../../data/site';
import { codeFor, referralsOf } from '../../lib/referrals';
import { BAREME } from '../../lib/points';

export const prerender = false;
const me = Astro.locals.user;
if (!me) return Astro.redirect('/connexion?retour=/communaute/parrainage');
const code = await codeFor(me.id);
const link = new URL(`/inscription?parrain=${code}`, Astro.url.origin).href;
const refs = await referralsOf(me.id);
const active = refs.filter((r) => r.qualifiedAt).length;
const share = `Rejoignez CEA FOR AFRICA, la plateforme des entrepreneurs africains : ${link}`;
---
<BaseLayout title="Parrainage">
  <PageHead title="Parrainez des entrepreneurs" lead="Invitez les entrepreneurs de votre réseau : chaque filleul actif vous rapporte des points de contribution et compte pour devenir ambassadeur de votre pays." crumbs={[['/communaute', 'Communauté'], ['', 'Parrainage']]} subnav={SUBS.communaute} />
  <section class="block">
    <div class="wrap split">
      <div>
        <div class="panel">
          <h3>Votre lien de parrainage</h3>
          <div class="row" style="gap:6px;flex-wrap:wrap">
            <input class="in" id="refLink" readonly value={link} aria-label="Lien de parrainage" style="flex:1;min-width:240px;margin:0" />
            <button class="btn btn-primary btn-sm" type="button" id="copy">Copier</button>
            <a class="btn btn-ghost btn-sm" href={`https://wa.me/?text=${encodeURIComponent(share)}`} target="_blank" rel="noopener">Partager sur WhatsApp</a>
          </div>
          <p class="xs muted" style="margin:8px 0 0">Code : <b>{code}</b>. Le lien est retenu 30 jours par le navigateur de la personne invitée, le temps qu'elle crée son compte.</p>
        </div>
        <h2 style="font-size:1.2rem;margin-top:24px">Mes filleuls ({refs.length})</h2>
        {refs.length ? (
          <div class="panel">{refs.map((r) => <div class="list-row"><span class="small"><b>{r.name}</b> · inscrit·e le {dateFr(r.createdAt.toISOString())}</span>{r.qualifiedAt ? <span class="tag ok">Actif · +{BAREME.parrainage.pts} pts</span> : <span class="tag">En attente</span>}</div>)}</div>
        ) : <div class="empty">Aucun filleul pour le moment : partagez votre lien !</div>}
      </div>
      <aside>
        <div class="panel">
          <h3>Vos résultats</h3>
          <div class="grid g2"><div class="kpi"><span class="small muted">Filleuls</span><b>{refs.length}</b></div><div class="kpi"><span class="small muted">Actifs</span><b>{active}</b></div></div>
          <p class="small" style="margin:10px 0 0"><b>{active * BAREME.parrainage.pts}</b> points gagnés grâce au parrainage.</p>
        </div>
        <div class="panel" style="margin-top:14px">
          <h3>Comment ça marche</h3>
          <ol class="small" style="margin:0;padding-left:18px">
            <li>Partagez votre lien.</li>
            <li>La personne crée son compte dans les 30 jours.</li>
            <li>Elle devient <b>active</b> quand elle complète son profil (titre et pays) ou valide une première leçon.</li>
            <li>Vous gagnez {BAREME.parrainage.pts} points, elle en gagne {BAREME.filleul.pts}.</li>
          </ol>
          <a class="small" href="/communaute/classement" style="display:block;margin-top:8px">Voir le classement</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
<script>
  document.getElementById('copy')?.addEventListener('click', () => {
    const i = document.getElementById('refLink') as HTMLInputElement;
    i.select();
    navigator.clipboard?.writeText(i.value).then(() => (window as unknown as { toast: (t: string) => void }).toast('Lien copié.'), () => {});
  });
</script>
