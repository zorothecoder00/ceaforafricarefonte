---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import MentorList from '../../components/MentorList.astro';
import { SUBS } from '../../data/site';

export const prerender = false;
---
<BaseLayout title="Mentorat">
  <PageHead title="Mentorat" lead="Des mentors vérifiés, notés par les membres. Réservez un créneau dans leur agenda ; la visioconférence est envoyée à la confirmation." crumbs={[['/communaute', 'Communauté'], ['', 'Mentorat']]} subnav={SUBS.communaute} />
  <section class="block">
    <div class="wrap">
      <MentorList kind="mentorat" />
      <p class="small muted" style="margin-top:18px">Vous souhaitez transmettre votre expérience ? <a href="/espace/mentor">Devenir mentor</a></p>
    </div>
  </section>
</BaseLayout>
