---
/* Découvrir les Mastermind Circles et candidater (CDC §7.5) : principe, formats, témoignages, tarifs, FAQ, admission. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Money from '../../components/Money.astro';
import { SUBS } from '../../data/site';

const session = ['Tour de table et nouvelles (20 min)', "Sujet approfondi d'un membre — « hot seat » (45 min)", 'Engagements pour le mois suivant (15 min)'];
const quotes: [string, string][] = [
  ['« En un an, mon cercle m’a évité deux erreurs de recrutement et m’a aidée à négocier mon premier crédit bancaire. »', 'Dirigeante d’une PME agroalimentaire, Dakar'],
  ['« Le hot seat m’a forcé à clarifier ma stratégie export. Mes pairs posent les questions qu’aucun consultant n’ose poser. »', 'Fondateur d’une fintech, Accra'],
];
const faq: [string, string][] = [
  ['Comment sont composés les cercles ?', 'Par stade (démarrage, croissance, PME établie), langue et format. Un algorithme propose une composition sans concurrents directs ni conflits d’intérêts ; un facilitateur la valide.'],
  ['Quel engagement de temps ?', 'Une séance de 1 h 30 par mois, plus une retraite annuelle facultative. La présence régulière est une condition de maintien dans le cercle.'],
  ['La confidentialité est-elle garantie ?', 'Oui : charte signée par chaque membre, comptes rendus visibles du seul cercle, aucun enregistrement sans accord unanime.'],
  ['Comment se passe l’admission ?', 'Demande en ligne, entretien vidéo de 20 minutes avec un facilitateur, puis affectation à un cercle et paiement de la cotisation annuelle.'],
];
---
<BaseLayout title="Mastermind Circles">
  <PageHead title="Mastermind Circles" lead="8 à 12 dirigeants de même niveau, sans concurrents directs, chaque mois avec un facilitateur. Ce qui se dit dans le cercle reste dans le cercle." crumbs={[['/communaute', 'Communauté'], ['', 'Mastermind']]} subnav={SUBS.communaute} />
  <section class="block">
    <div class="wrap grid g2">
      <div class="panel">
        <h3>Comment se déroule une séance</h3>
        <ol class="timeline">{session.map((x) => <li><b>{x}</b></li>)}</ol>
        <p class="small muted">Formats : en ligne ou en présentiel (Lomé, Abidjan, Dakar, Lagos, Nairobi), retraites annuelles et visites d'entreprises sur le continent.</p>
        <p class="small">Déjà membre d’un cercle ? <a href="/espace/cercle">Ouvrir mon cercle</a></p>
      </div>
      <form class="panel" data-api="/api/candidatures" data-redirect="/espace/candidatures">
        <h3>Demander à rejoindre un cercle</h3>
        <input type="hidden" name="programme" value="mastermind" />
        <label class="f" for="mms">Votre stade</label><select class="in" id="mms" name="stade"><option>Démarrage (moins de 2 ans)</option><option>Croissance (2 à 5 ans)</option><option>PME établie (plus de 20 salariés)</option><option>Dirigeant confirmé</option></select>
        <label class="f" for="mmsec">Secteur</label><input class="in" id="mmsec" name="secteur" required />
        <label class="f" for="mml">Langue</label><select class="in" id="mml" name="langue"><option>Français</option><option>Anglais</option><option>Portugais</option></select>
        <label class="f" for="mmf">Format</label><select class="in" id="mmf" name="format"><option>En ligne</option><option>Présentiel (Lomé)</option><option>Présentiel (Abidjan)</option><option>Présentiel (Dakar)</option></select>
        <label class="f" for="mmc">Concurrents à éviter (facultatif)</label><input class="in" id="mmc" name="concurrents" placeholder="Entreprises avec lesquelles vous êtes en concurrence directe" />
        <p class="small">Cotisation annuelle : <b><Money xof={180000} /></b>, payable après l'entretien et l'affectation.</p>
        <button class="btn btn-primary" type="submit">Demander à rejoindre</button>
      </form>
    </div>
    <div class="wrap" style="margin-top:40px">
      <h2>Ils en parlent</h2>
      <div class="grid g2">{quotes.map(([q, a]) => <div class="panel"><p style="margin:0 0 8px">{q}</p><p class="small muted" style="margin:0">— {a} (témoignage de démonstration)</p></div>)}</div>
      <h2 style="margin-top:36px">Questions fréquentes</h2>
      <div class="grid g2">{faq.map(([q, a]) => <details class="panel"><summary><b>{q}</b></summary><p class="small" style="margin:10px 0 0">{a}</p></details>)}</div>
    </div>
  </section>
</BaseLayout>
