---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import Money from '../../components/Money.astro';
import { MEMBERS, SUBS, initials } from '../../data/site';

const session = ['Tour de table et nouvelles (20 min)', "Sujet approfondi d'un membre — « hot seat » (45 min)", 'Engagements pour le mois suivant (15 min)'];
const engagements: [string, string][] = [['Signer 2 nouveaux distributeurs', 'En cours'], ['Recruter un·e directeur·rice financier·e', 'En cours'], ['Clôturer les comptes 2025', 'Atteint'], ['Lancer la boutique en ligne', 'Reporté']];
---
<BaseLayout title="Mastermind Circles">
  <PageHead title="Mastermind Circles" lead="8 à 12 dirigeants de même niveau, sans concurrents directs, chaque mois avec un facilitateur. Ce qui se dit dans le cercle reste dans le cercle." crumbs={[['/communaute', 'Communauté'], ['', 'Mastermind']]} subnav={SUBS.communaute} />
  <section class="block">
    <div class="wrap grid g2">
      <div class="panel">
        <h3>Comment se déroule une séance</h3>
        <ol class="timeline">{session.map((x) => <li><b>{x}</b></li>)}</ol>
        <p class="small muted">Formats : en ligne ou en présentiel, retraites annuelles et visites d'entreprises sur le continent.</p>
      </div>
      <form class="panel" data-demo="Demande envoyée. Un facilitateur vous contactera pour un entretien.">
        <h3>Rejoindre un cercle</h3>
        <label class="f" for="mms">Votre stade</label><select class="in" id="mms"><option>Démarrage (moins de 2 ans)</option><option>Croissance (2 à 5 ans)</option><option>PME établie (plus de 20 salariés)</option></select>
        <label class="f" for="mml">Langue</label><select class="in" id="mml"><option>Français</option><option>Anglais</option><option>Portugais</option></select>
        <label class="f" for="mmf">Format</label><select class="in" id="mmf"><option>En ligne</option><option>Présentiel (Lomé)</option><option>Présentiel (Abidjan)</option></select>
        <p class="small">Cotisation annuelle : <b><Money xof={180000} /></b></p>
        <button class="btn btn-primary" type="submit">Demander à rejoindre</button>
      </form>
    </div>

    <div class="wrap" style="margin-top:44px">
      <h2>Aperçu de l'espace d'un cercle</h2>
      <p class="muted">Cercle « Croissance Afrique de l'Ouest » · 10 membres · facilitatrice : Awa Sarr · prochaine séance le jeudi 9 octobre à 18:00</p>
      <div class="lock" style="border-style:solid;margin-bottom:18px"><Icon name="lock" size={20} /><div><b>Charte de confidentialité</b> — Les comptes rendus ne sont visibles que par les membres du cercle. Aucun enregistrement sans accord unanime.</div></div>
      <div class="split">
        <div>
          <h3>Engagements du trimestre</h3>
          <div class="kanban" style="grid-template-columns:repeat(3,minmax(180px,1fr))">
            {['En cours', 'Atteint', 'Reporté'].map((c) => <div class="col"><h4><span>{c}</span></h4>{engagements.filter((e) => e[1] === c).map((e) => <div class="kcard">{e[0]}</div>)}</div>)}
          </div>
          <h3 style="margin-top:26px">Séance en cours (protocole guidé)</h3>
          <div class="panel" id="mmTimer">
            <div class="row between"><b data-phase>1. Tour de table</b><b class="num" data-clock style="font-family:var(--display);font-size:1.6rem">20:00</b></div>
            <div class="row" style="margin-top:10px">
              <button class="btn btn-primary btn-sm" type="button" data-start>Démarrer le minuteur</button>
              <button class="btn btn-ghost btn-sm" type="button" data-nextp>Étape suivante</button>
              <button class="btn btn-ghost btn-sm" type="button" data-toast="Salle de visioconférence ouverte (simulation).">Rejoindre la visio</button>
            </div>
          </div>
        </div>
        <aside>
          <div class="panel">
            <h3>Membres</h3>
            {MEMBERS.slice(0, 6).map((m) => <div class="row" style="padding:5px 0"><span class="avatar" style="width:32px;height:32px;font-size:.7rem">{initials(m.n)}</span><span class="small">{m.n}<br /><span class="xs muted">{m.s}</span></span></div>)}
          </div>
          <div class="panel" style="margin-top:16px">
            <h3>Évaluer la dernière séance</h3>
            <div class="row" data-slots>{[1, 2, 3, 4, 5].map((n) => <button class="slot" type="button" aria-pressed="false" data-toast="Merci pour votre évaluation.">{n} ★</button>)}</div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const box = document.getElementById('mmTimer')!;
  const phases: [string, number][] = [['1. Tour de table', 1200], ['2. Sujet approfondi', 2700], ['3. Engagements', 900]];
  let ph = 0, left = phases[0][1], iv: number | undefined;
  const start = box.querySelector<HTMLButtonElement>('[data-start]')!;
  const draw = () => {
    box.querySelector('[data-clock]')!.textContent = String(Math.floor(left / 60)).padStart(2, '0') + ':' + String(left % 60).padStart(2, '0');
    box.querySelector('[data-phase]')!.textContent = phases[ph][0];
  };
  start.addEventListener('click', () => {
    if (iv) { clearInterval(iv); iv = undefined; start.textContent = 'Reprendre'; return; }
    start.textContent = 'Pause';
    iv = window.setInterval(() => { left = Math.max(0, left - 1); draw(); }, 1000);
  });
  box.querySelector('[data-nextp]')!.addEventListener('click', () => { ph = (ph + 1) % 3; left = phases[ph][1]; draw(); });
</script>
