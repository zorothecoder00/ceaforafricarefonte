---
/* Espaces thématiques, pays, secteurs et profils (CDC §7.8). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { count, eq, sql } from 'drizzle-orm';
import { db } from '../../lib/db';
import { space, spaceMember } from '../../db/schema/app';
import { SUBS, fmt } from '../../data/site';

export const prerender = false;
const me = Astro.locals.user;
const spaces = await db.select({ s: space, n: sql<number>`(select count(*) from ${spaceMember} where ${spaceMember.spaceId} = ${space.id})::int` }).from(space).orderBy(space.kind, space.name);
const mine = me ? (await db.select({ id: spaceMember.spaceId }).from(spaceMember).where(eq(spaceMember.userId, me.id))).map((r) => r.id) : [];
const KIND: Record<string, string> = { theme: 'Thème', pays: 'Pays', secteur: 'Secteur', profil: 'Profil' };
---
<BaseLayout title="Espaces thématiques">
  <PageHead title="Espaces thématiques" lead="Rejoignez les espaces de votre pays, de votre secteur et de votre profil." crumbs={[['/communaute', 'Communauté'], ['', 'Espaces']]} subnav={SUBS.communaute} />
  <section class="block">
    <div class="wrap grid g3">
      {spaces.map(({ s, n }) => {
        const joined = mine.includes(s.id);
        return (
          <div class="panel">
            <span class="tag info">{KIND[s.kind] ?? s.kind}</span>
            <h3 style="margin:10px 0 4px">{s.name}</h3>
            <p class="small muted">{s.description}</p>
            <div class="row between"><span class="small">{fmt(n)} membre{n > 1 ? 's' : ''}</span>
              <span class="row">
                <a class="btn btn-ghost btn-sm" href={`/communaute/fil?espace=${s.id}`}>Voir</a>
                {me ? <button class={`btn btn-sm ${joined ? 'btn-ghost' : 'btn-primary'}`} type="button" data-post="/api/espaces" data-body={JSON.stringify({ spaceId: s.id, join: !joined })} data-reload>{joined ? 'Quitter' : 'Rejoindre'}</button> : <a class="btn btn-primary btn-sm" href="/connexion?retour=/communaute/espaces">Rejoindre</a>}
              </span>
            </div>
          </div>
        );
      })}
      {spaces.length === 0 && <div class="empty">Aucun espace pour le moment.</div>}
    </div>
  </section>
</BaseLayout>
