---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Wizard from '../../components/Wizard.astro';
import { COUNTRIES, SUBS } from '../../data/site';

const sectors = ['Agroalimentaire', 'Fintech', 'Énergie', 'Santé', 'Éducation', 'BTP', 'Commerce', 'Numérique'];
const recap: [string, string][] = [['Nom', 'nom'], ['Téléphone', 'tel'], ['Entreprise', 'entreprise'], ['Secteur', 'secteur'], ['Salariés', 'salaries']];
---
<BaseLayout title="Candidature">
  <PageHead title="Candidater à l'Accélérateur — Cohorte 4" lead="Environ 10 minutes. Vous pouvez interrompre et reprendre plus tard." crumbs={[['/programmes', 'Programmes'], ['', 'Candidature']]} subnav={SUBS.programmes} />
  <section class="block">
    <div class="wrap" style="max-width:740px">
      <Wizard id="accel" prefix="CAND" submitLabel="Envoyer ma candidature" success="Vous recevrez un message WhatsApp à chaque étape. Prochaine étape : le diagnostic de maturité.">
        <fieldset data-step="Vous" style="border:0;padding:0;margin:0">
          <label class="f" for="a1">Nom complet</label><input class="in" id="a1" name="nom" required />
          <label class="f" for="a2">Téléphone (WhatsApp)</label><input class="in" id="a2" name="tel" required placeholder="+228 90 00 00 00" inputmode="tel" />
          <label class="f" for="a3">Pays</label><select class="in" id="a3" name="pays">{Object.entries(COUNTRIES).map(([k, v]) => <option value={k}>{v}</option>)}</select>
          <label class="f" for="a4">Genre (statistiques d'impact, facultatif)</label><select class="in" id="a4" name="genre"><option value="">Je préfère ne pas répondre</option><option>Femme</option><option>Homme</option></select>
        </fieldset>
        <fieldset data-step="Votre entreprise" style="border:0;padding:0;margin:0">
          <label class="f" for="b1">Nom de l'entreprise</label><input class="in" id="b1" name="entreprise" required />
          <label class="f" for="b2">Secteur</label><select class="in" id="b2" name="secteur">{sectors.map((s) => <option>{s}</option>)}</select>
          <label class="f" for="b3">Nombre de salariés</label><input class="in" id="b3" name="salaries" type="number" min="0" />
          <label class="f" for="b4">L'entreprise est-elle immatriculée ?</label><select class="in" id="b4" name="immat"><option>Oui</option><option>Non</option></select>
          <p class="small" style="margin-top:-8px">Pas encore immatriculée ? Le programme de <a href="/programmes">pré-incubation</a> est peut-être plus adapté.</p>
        </fieldset>
        <fieldset data-step="Votre projet" style="border:0;padding:0;margin:0">
          <label class="f" for="c1">Quel problème résolvez-vous ?</label><textarea class="in" id="c1" name="probleme" required></textarea>
          <label class="f" for="c2">Qu'attendez-vous de l'accélérateur ?</label><textarea class="in" id="c2" name="attentes"></textarea>
        </fieldset>
        <fieldset data-step="Pièces jointes" style="border:0;padding:0;margin:0">
          <p class="small muted">Formats acceptés : PDF, DOCX, XLSX. Analyse antivirus automatique. Documents privés par défaut.</p>
          {['Pitch deck', 'Statuts ou RCCM', 'Derniers états financiers (si disponibles)'].map((x, i) => <><label class="f" for={`f${i}`}>{x}</label><input class="in" type="file" id={`f${i}`} accept=".pdf,.docx,.xlsx" /></>)}
          <div class="small" data-uploads></div>
        </fieldset>
        <fieldset data-step="Confirmation" style="border:0;padding:0;margin:0">
          <p>Vérifiez vos informations avant l'envoi.</p>
          <div class="panel small">{recap.map(([l, k]) => <div class="row between"><span class="muted">{l}</span><b data-recap={k}></b></div>)}</div>
          <label class="row small" style="margin-top:14px"><input type="checkbox" required /> J'accepte que CEA traite ces données pour étudier ma candidature.</label>
          <label class="row small"><input type="checkbox" required /> J'accepte que mon dossier soit partagé avec les jurys du programme.</label>
        </fieldset>
      </Wizard>
    </div>
  </section>
</BaseLayout>
