---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { SUBS } from '../../data/site';
import { programmeCatalogue } from '../../lib/calls';

export const prerender = false;
// Une ligne par programme ouvert (date de clôture) ou annoncé (date d'ouverture), du plus proche au plus lointain
const now = Date.now();
const list = (await programmeCatalogue()).filter((p) => p.state !== 'clos')
  .map((p) => ({ ...p, date: p.state === 'ouvert' ? p.closesAt : p.opensAt && p.opensAt.getTime() >= now ? p.opensAt : null }))
  .sort((a, b) => (a.date?.getTime() ?? Infinity) - (b.date?.getTime() ?? Infinity));
const day = (d: Date | null) => (d ? d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Lome' }) : 'À confirmer');
---
<BaseLayout title="Calendrier des appels">
  <PageHead title="Calendrier des appels" lead="Toutes les ouvertures et clôtures de candidature." crumbs={[['/programmes', 'Programmes'], ['', 'Calendrier']]} subnav={SUBS.programmes} />
  <section class="block">
    <div class="wrap">
      <p class="small">S'abonner à tout le calendrier : <a href="/programmes/appels.ics">flux iCalendar (.ics)</a>, compatible Google Agenda, Outlook et Apple Calendrier.</p>
      <div class="panel scroll-x">
        <table class="t">
          <thead><tr><th>Programme</th><th>Durée</th><th>Date</th><th>Statut</th><th></th></tr></thead>
          <tbody>
            {list.map((p) => (
              <tr><td>{p.canApply || p.source === 'appel' ? <a href={p.href}><b>{p.title}</b></a> : <b>{p.title}</b>}</td><td>{p.duration ?? p.programme}</td><td>{day(p.date)}</td>
                <td><span class={`tag ${p.state === 'ouvert' ? 'ok' : ''}`}>{p.state === 'ouvert' ? "Ouvert jusqu'au" : 'Ouverture le'}</span></td>
                <td>{p.date && <a class="btn btn-ghost btn-sm" href={`/programmes/appels.ics?programme=${p.slug}`} download>Ajouter à mon agenda</a>}</td></tr>
            ))}
          </tbody>
        </table>
        {list.length === 0 && <p class="small muted">Aucun appel ouvert ni annoncé pour le moment.</p>}
      </div>
    </div>
  </section>
</BaseLayout>
