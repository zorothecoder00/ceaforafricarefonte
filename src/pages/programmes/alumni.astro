---
/* Réseau des anciens (CDC §7.1). Dès que des cohortes comptent des anciens (diplômés, ou participants d'une cohorte terminée
   sans abandon), les chiffres viennent de leur suivi (dernier point déclaré ou saisi : emplois, fonds levés) et seuls les anciens
   au profil public sont présentés. Sans données, la page garde les chiffres et profils de démonstration du prototype. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import MemberCard from '../../components/MemberCard.astro';
import { sql } from 'drizzle-orm';
import { db } from '../../lib/db';
import { MEMBERS, SUBS } from '../../data/site';

export const prerender = false;

type Alum = { user_id: string; name: string; country: string | null; headline: string | null; sector: string | null; company: string | null; visibility: string; employees: number | null; funds: number | null };
const alumni = (await db.execute(sql`
  with a as (
    select distinct m.user_id from cohort_member m join cohort c on c.id = m.cohort_id
    where m.status = 'diplome' or (c.status = 'terminee' and m.status <> 'abandon')
  ), last as (
    select distinct on (f.user_id) f.user_id, f.employees, f.funds_raised_xof from alumni_followup f join a on a.user_id = f.user_id order by f.user_id, f.months_after desc
  )
  select a.user_id, u.name, p.country, p.headline, p.sector, p.company_name as company, coalesce(p.visibility::text, 'membres') as visibility, last.employees, last.funds_raised_xof as funds
  from a join "user" u on u.id = a.user_id left join profile p on p.user_id = a.user_id left join last on last.user_id = a.user_id
`).catch(() => ({ rows: [] }))).rows as Alum[];

const real = alumni.length > 0;
const kpis: [string, string][] = real
  ? [
      ['Anciens', alumni.length.toLocaleString('fr-FR')],
      ['Ont levé des fonds', alumni.filter((x) => (x.funds ?? 0) > 0).length.toLocaleString('fr-FR')],
      ['Emplois (dernier suivi)', alumni.reduce((n, x) => n + (x.employees ?? 0), 0).toLocaleString('fr-FR')],
      ['Pays', String(new Set(alumni.map((x) => x.country).filter(Boolean)).size)],
    ]
  : [['Anciens', '312'], ['Ont levé des fonds', '58'], ['Emplois créés', '2 340'], ['Pays', '16']];
const cards = real
  ? alumni.filter((x) => x.visibility === 'public').slice(0, 12).map((x) => ({ n: x.name, c: x.country ?? '', s: x.sector ?? '—', r: x.company || x.headline || 'Entrepreneur', b: ['Alumni'], need: '—', offer: '—' }))
  : MEMBERS.filter((m) => m.b.includes('Alumni')).concat(MEMBERS.slice(1, 3));
---
<BaseLayout title="Alumni">
  <PageHead title="Le réseau des anciens" lead={real ? `${alumni.length} entrepreneur${alumni.length > 1 ? 's' : ''} accompagné${alumni.length > 1 ? 's' : ''} par les programmes CEA. Des offres et événements réservés.` : 'Plus de 300 entreprises accompagnées depuis 2025. Des offres et événements réservés.'} crumbs={[['/programmes', 'Programmes'], ['', 'Alumni']]} subnav={SUBS.programmes} />
  <section class="block">
    <div class="wrap">
      <div class="grid g4">{kpis.map(([k, v]) => <div class="panel kpi"><span class="small muted">{k}</span><b>{v}</b></div>)}</div>
      {!real && <p class="xs muted" style="margin-top:8px">Chiffres de démonstration : ils seront calculés à partir des cohortes dès les premiers anciens.</p>}
      {cards.length > 0 && <h2 style="margin-top:28px">Quelques anciens</h2>}
      <div class="grid g3">{cards.map((m) => <MemberCard m={m} />)}</div>
    </div>
  </section>
</BaseLayout>
