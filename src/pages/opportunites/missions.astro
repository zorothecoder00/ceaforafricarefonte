---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import JobsBoard from '../../components/JobsBoard.astro';
import { SUBS } from '../../data/site';
import { listJobs } from '../../lib/jobs';

export const prerender = false;
const uid = Astro.locals.user?.id;
const jobs = await listJobs({ userId: uid, types: ['Freelance', 'Mission'] });
---
<BaseLayout title="Missions et consultants">
  <PageHead title="Missions et appels à consultants" lead="Missions freelance et expertises courtes proposées par les entreprises et programmes du réseau." crumbs={[['/opportunites', 'Opportunités'], ['', 'Missions']]} subnav={SUBS.opps} />
  <JobsBoard jobs={jobs} />
</BaseLayout>
