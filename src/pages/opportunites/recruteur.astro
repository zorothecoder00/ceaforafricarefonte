---
/* Présentation de l'offre recruteur ; l'outil lui-même est dans l'espace connecté (/espace/recruteur). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Money from '../../components/Money.astro';
import { SUBS } from '../../data/site';

export const prerender = false;
if (Astro.locals.user) return Astro.redirect('/espace/recruteur');
const steps: [string, string][] = [['Publiez', 'Votre offre est vérifiée par notre équipe sous 24 heures (pas de critère discriminatoire).'], ['Recevez', 'Les candidats postulent en un clic avec leur profil CEA ; triez-les dans un tableau Kanban.'], ['Recrutez', 'Déclarez vos embauches : elles alimentent l’observatoire des emplois créés.']];
---
<BaseLayout title="Recruter avec CEA Talents">
  <PageHead title="Espace recruteur" lead="Publiez vos offres, suivez les candidatures, déclarez vos embauches." crumbs={[['/opportunites', 'Opportunités'], ['', 'Espace recruteur']]} subnav={SUBS.opps} />
  <section class="block">
    <div class="wrap">
      <div class="grid g3">{steps.map(([t, d], i) => <div class="panel"><span class="tag gold">{i + 1}</span><h3 style="margin:10px 0 6px">{t}</h3><p class="small" style="margin:0">{d}</p></div>)}</div>
      <div class="call" style="margin-top:30px"><div><h2>Publication gratuite</h2><p>Mise en avant de 30 jours en tête de liste : <Money xof={15000} />.</p></div><div><a class="btn btn-primary" href="/connexion?retour=/espace/recruteur">Se connecter pour publier</a></div></div>
    </div>
  </section>
</BaseLayout>
