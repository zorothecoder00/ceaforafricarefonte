---
/* Pages légales (CDC §15) : mentions légales, confidentialité, cookies, CGU, code de conduite, charte de modération, réclamations, accessibilité. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { LEGAL } from '../../data/legal';
import { dateFr } from '../../data/site';

export const prerender = false;

const doc = Object.hasOwn(LEGAL, Astro.params.slug ?? '') ? LEGAL[Astro.params.slug!] : undefined;
if (!doc) return Astro.rewrite('/404');
const others = Object.entries(LEGAL).filter(([k]) => k !== Astro.params.slug);
---
<BaseLayout title={doc.title}>
  <PageHead title={doc.title} lead={`Mise à jour le ${dateFr(doc.updated)}`} crumbs={[['', doc.title]]} />
  <section class="block">
    <div class="wrap split">
      <article class="panel prose">
        <p>{doc.intro}</p>
        {doc.sections.map(([h, paras]) => (
          <>
            <h2 style="font-size:1.2rem;margin-top:24px">{h}</h2>
            {paras.length > 1 ? <ul>{paras.map((p) => <li>{p}</li>)}</ul> : <p>{paras[0]}</p>}
          </>
        ))}
      </article>
      <aside class="panel">
        <h3>Autres documents</h3>
        {others.map(([k, d]) => <a class="small" href={`/legal/${k}`} style="display:block;margin-bottom:6px">{d.title}</a>)}
        {Astro.params.slug === 'cookies' && <button class="btn btn-ghost btn-sm" type="button" data-cookie-settings style="margin-top:10px">Gérer mes choix</button>}
      </aside>
    </div>
  </section>
</BaseLayout>
