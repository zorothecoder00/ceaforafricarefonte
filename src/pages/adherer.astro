---
/* Adhésion (CDC §7.7, §16) : formules, paiement Mobile Money / carte, carte de membre numérique. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Money from '../components/Money.astro';
import { SUBS } from '../data/site';

const plans: [string, string, number, string[]][] = [
  ['gratuit', 'Gratuit', 0, ['Annuaire et espaces', 'Cours gratuits', 'Événements gratuits']],
  ['membre', 'Membre', 30000, ['Tout Gratuit', "Tous les cours de l'Académie", 'Votes et consultations', 'Carte de membre']],
  ['premium', 'Premium', 90000, ['Tout Membre', 'Masterclass', '2 séances de mentorat', 'Priorité Kapital Invest']],
  ['entreprise', 'Entreprise', 250000, ['5 comptes salariés', 'Espace recruteur illimité', 'Pack événements', 'Visibilité partenaire']],
];
---
<BaseLayout title="Adhérer">
  <PageHead title="Adhérer à CEA FOR AFRICA" lead="Choisissez votre formule. Paiement annuel par Mobile Money ou carte, renouvellement avec rappel, carte de membre numérique avec QR code." crumbs={[['/communaute', 'Communauté'], ['', 'Adhérer']]} subnav={SUBS.communaute} />
  <section class="block">
    <div class="wrap">
      <div class="grid g4">
        {plans.map(([id, n, p, items], i) => (
          <div class="panel" style={i === 2 ? 'border:2px solid var(--gold)' : ''}>
            {i === 2 && <span class="tag gold">Le plus choisi</span>}
            <h3 style="margin-top:8px">{n}</h3>
            <b style="font-family:var(--display);font-size:1.6rem;color:var(--navy)"><Money xof={p} /></b>{p > 0 && <span class="small muted"> / an</span>}
            <ul class="small">{items.map((x) => <li>{x}</li>)}</ul>
            <button class={`btn ${i === 2 ? 'btn-gold' : 'btn-primary'}`} style="width:100%" type="button" data-post="/api/adhesion" data-body={JSON.stringify({ plan: id })}>Choisir</button>
          </div>
        ))}
      </div>
      <p class="small muted" style="margin-top:16px">Vous devez être connecté pour adhérer. Les paiements sont traités par un agrégateur agréé ; un reçu est disponible dans votre espace. <a href="/espace/carte">Voir ma carte de membre</a></p>
    </div>
  </section>
</BaseLayout>
