---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import AfricaMap from '../components/AfricaMap.astro';
import { HUBS, SUBS, country, fmt, dateFr } from '../data/site';
import { KPIS, JOBS_BY_QUARTER, DATASETS, IMPACT_ASOF, IMPACT_LICENSE } from '../data/impact';

export const prerender = false;

const kpis = KPIS;
const top = [...HUBS].sort((a, b) => b.m - a.m).slice(0, 8);
const maxM = top[0].m;
const jobs: [string, number][] = JOBS_BY_QUARTER.map(([q, n]) => [`${q.slice(5)} ${q.slice(2, 4)}`, n]);
const W = 320, H = 160, maxJ = 650;
const pts = jobs.map(([, v], i) => [20 + (i * (W - 40)) / (jobs.length - 1), H - 20 - (v / maxJ) * (H - 40)]);
const line = pts.map((p) => p.join(',')).join(' ');
const area = `20,${H - 20} ${line} ${W - 20},${H - 20}`;
---
<BaseLayout title="Observatoire d'impact">
  <PageHead title="CEA Impact Lab — observatoire d'impact" lead="Des chiffres agrégés, définis, sourcés et datés. Données de démonstration au 30 septembre 2026." crumbs={[['', 'CEA Impact Lab']]} subnav={SUBS.ressources} />
  <section class="block" style="padding-top:28px">
    <div class="wrap">
      <div class="grid g4">
        {kpis.map((k) => (
          <div class="panel">
            <div class="small muted">{k.label}</div>
            <b style="font-family:var(--display);font-size:1.9rem;color:var(--navy)">{k.display}</b>
            <details class="xs" style="margin-top:6px"><summary class="muted" style="cursor:pointer">Définition et source</summary><p style="margin:6px 0 0">{k.definition}</p><p class="muted" style="margin:4px 0 0">Source : {k.source} · arrêté au {dateFr(k.asOf)}</p></details>
          </div>
        ))}
      </div>
      <div class="grid g2" style="margin-top:20px">
        <div class="panel" style="background:#082B4C;border:0"><h3 style="color:#fff">Carte de l'impact</h3><AfricaMap /></div>
        <div class="grid">
          <div class="panel">
            <h3>Membres par pays</h3>
            {top.map((h) => (
              <div class="row" style="gap:10px;margin-bottom:6px;flex-wrap:nowrap">
                <span class="small" style="width:110px;flex-shrink:0">{country(h.c)}</span>
                <div class="progress" style="flex:1;height:14px"><span style={`width:${(h.m / maxM) * 100}%`}></span></div>
                <b class="small num" style="width:50px;text-align:right">{fmt(h.m)}</b>
              </div>
            ))}
          </div>
          <div class="panel">
            <h3>Emplois créés par trimestre</h3>
            <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Emplois créés par trimestre, de 120 au T1 2025 à 610 au T3 2026" style="width:100%;height:auto">
              <polygon points={area} fill="rgba(43,108,176,.15)" />
              <polyline points={line} fill="none" stroke="#2B6CB0" stroke-width="2.5" />
              {pts.map(([x, y], i) => <><circle cx={x} cy={y} r="3.5" fill="#2B6CB0" /><text x={x} y={H - 4} font-size="9" text-anchor="middle" fill="currentColor" opacity=".7">{jobs[i][0]}</text><text x={x} y={y - 8} font-size="9" text-anchor="middle" fill="currentColor">{jobs[i][1]}</text></>)}
            </svg>
          </div>
        </div>
      </div>
      <div class="grid g3" style="margin-top:20px">
        <div class="panel"><h3>Alignement</h3><p class="small" style="margin:0">Objectifs de développement durable 1, 5, 8 et 9 ; Agenda 2063 de l'Union africaine.</p></div>
        <div class="panel"><h3>Méthodologie</h3><p class="small" style="margin:0">Un emploi est compté comme « créé » s'il existe depuis au moins 6 mois, prouvé par un contrat ou une déclaration sociale, vérifié par échantillonnage. Aucune cellule de moins de 10 personnes n'est publiée.</p></div>
        <div class="panel"><h3>Données ouvertes</h3>
          <p class="small">Jeux de données agrégés et anonymisés, arrêtés au {dateFr(IMPACT_ASOF)}, sous licence {IMPACT_LICENSE} : réutilisation libre en citant la source.</p>
          {DATASETS.map((d) => <a class="small" href={d.file} download style="display:block;margin-bottom:4px">⬇ {d.title} (CSV)</a>)}
          <p class="small" style="margin:10px 0 4px"><b>API publique</b> (lecture seule, sans clé) :</p>
          <code class="xs" style="display:block;overflow-wrap:anywhere">GET /api/ouvert/impact</code>
          <code class="xs" style="display:block;overflow-wrap:anywhere">GET /api/ouvert/impact?pays=TG</code>
          <a class="small" href="/api/ouvert/impact" target="_blank" rel="noopener">Voir la réponse JSON</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
