---
/* Mon espace entreprise (CDC §8.3, §8.8) : statut du dossier en temps réel, jauge Investor Ready, data room, statistiques de consultation,
   accords de confidentialité révocables, intérêts reçus, mises à jour aux investisseurs, échanges avec l'analyste. */
import KapitalLayout from '../../layouts/KapitalLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Money from '../../components/Money.astro';
import Icon from '../../components/Icon.astro';
import { and, desc, eq, inArray, isNull, sql } from 'drizzle-orm';
import { db } from '../../lib/db';
import * as s from '../../db/schema';
import { PIPELINE, statusLabel, INSTRUMENT_LABEL } from '../../lib/kapital';
import { readPage, emptyPage } from '../../lib/opportunity-page';

export const prerender = false;
const me = Astro.locals.user;
if (!me) return Astro.redirect('/connexion?retour=/kapital/entreprise');
const dossiers = await db.select().from(s.dossier).where(eq(s.dossier.ownerId, me.id)).orderBy(desc(s.dossier.createdAt));
const d = dossiers.find((x) => x.id === Astro.url.searchParams.get('d')) ?? dossiers[0];
const [diag] = await db.select().from(s.diagnostic).where(eq(s.diagnostic.userId, me.id)).orderBy(desc(s.diagnostic.createdAt)).limit(1);
let events: (typeof s.dossierEvent.$inferSelect)[] = [], docs: { doc: typeof s.dataRoomDocument.$inferSelect; views: number; secs: number }[] = [];
let ndas: { investorId: string; name: string; signedAt: Date; until: Date | null }[] = [], interests: { name: string; amount: number | null; at: Date }[] = [], viewers: { name: string; docs: number; secs: number }[] = [];
let analyst: { id: string; name: string } | undefined;
if (d) {
  events = await db.select().from(s.dossierEvent).where(eq(s.dossierEvent.dossierId, d.id)).orderBy(desc(s.dossierEvent.at)).limit(20);
  docs = await db.select({ doc: s.dataRoomDocument, views: sql<number>`(select count(*) from ${s.dataRoomView} where ${s.dataRoomView.documentId} = ${s.dataRoomDocument.id})::int`, secs: sql<number>`(select coalesce(sum(${s.dataRoomView.seconds}),0) from ${s.dataRoomView} where ${s.dataRoomView.documentId} = ${s.dataRoomDocument.id})::int` }).from(s.dataRoomDocument).where(eq(s.dataRoomDocument.dossierId, d.id)).orderBy(s.dataRoomDocument.folder, s.dataRoomDocument.name);
  ndas = await db.select({ investorId: s.nda.investorId, name: s.user.name, signedAt: s.nda.signedAt, until: s.nda.expiresAt }).from(s.nda).innerJoin(s.user, eq(s.user.id, s.nda.investorId)).where(and(eq(s.nda.dossierId, d.id), isNull(s.nda.revokedAt)));
  interests = await db.select({ name: s.user.name, amount: s.interest.amountXof, at: s.interest.createdAt }).from(s.interest).innerJoin(s.user, eq(s.user.id, s.interest.investorId)).where(eq(s.interest.dossierId, d.id));
  const docIds = docs.map((x) => x.doc.id);
  viewers = docIds.length ? await db.select({ name: s.user.name, docs: sql<number>`count(distinct ${s.dataRoomView.documentId})::int`, secs: sql<number>`coalesce(sum(${s.dataRoomView.seconds}),0)::int` }).from(s.dataRoomView).innerJoin(s.user, eq(s.user.id, s.dataRoomView.investorId)).where(and(inArray(s.dataRoomView.documentId, docIds), sql`${s.dataRoomView.investorId} <> ${me.id}`)).groupBy(s.user.name) : [];
  if (d.analystId) [analyst] = await db.select({ id: s.user.id, name: s.user.name }).from(s.user).where(eq(s.user.id, d.analystId));
}
// Questions des investisseurs (data room) et page d'opportunité composée par l'entreprise
const questions = d ? await db.select({ q: s.dataRoomQuestion, name: s.user.name }).from(s.dataRoomQuestion).innerJoin(s.user, eq(s.user.id, s.dataRoomQuestion.investorId)).where(eq(s.dataRoomQuestion.dossierId, d.id)).orderBy(desc(s.dataRoomQuestion.createdAt)) : [];
const pending = questions.filter((x) => !x.q.answer).length;
const pageData = d ? readPage(d.page) ?? emptyPage() : emptyPage();
const dateUtc = (x: Date) => x.toLocaleDateString('fr-FR', { timeZone: 'UTC' });
const stepIdx = d ? PIPELINE.findIndex((p) => p.key === d.status) : -1;
const lastChange = events[0]?.at ?? d?.createdAt;
const daysIn = lastChange ? Math.floor((Date.now() - lastChange.getTime()) / 864e5) : 0;
const sla = d ? PIPELINE[stepIdx]?.sla ?? 0 : 0;
const FOLDERS: [string, string][] = [['juridique', 'Juridique'], ['financier', 'Financier'], ['commercial', 'Commercial'], ['technique', 'Technique'], ['rh', 'RH'], ['fiscal', 'Fiscal'], ['esg', 'ESG']];
const mins = (sec: number) => (sec < 60 ? `${sec} s` : `${Math.round(sec / 60)} min`);
const score = d?.investorReadyScore ?? diag?.score ?? null;
---
<KapitalLayout title="Mon espace entreprise" group="lever">
  <PageHead title="Mon espace entreprise" lead={d ? `${d.companyName} · dossier ${d.reference}` : 'Aucun dossier pour le moment.'} crumbs={[['/kapital', 'Kapital Invest'], ['', 'Mon espace entreprise']]} />
  <section class="block">
    <div class="wrap">
      {!d ? (
        <div class="empty">Commencez par <a href="/kapital/diagnostic">le diagnostic</a> puis <a href="/kapital/soumettre">soumettez votre dossier</a>.</div>
      ) : (
        <>
          {dossiers.length > 1 && <form class="filters" method="get" style="margin-top:0"><select class="in" name="d" onchange="this.form.submit()" aria-label="Dossier">{dossiers.map((x) => <option value={x.id} selected={x.id === d.id}>{x.companyName} — {x.reference}</option>)}</select></form>}
          <div class="grid g3">
            <div class="panel">
              <h3>Jauge Investor Ready</h3>
              <b style="font-family:var(--display);font-size:2.4rem;color:#E7BD62">{score ?? '—'}</b><span class="small muted">/100</span>
              <div class="progress" style="margin-top:8px"><span style={`width:${score ?? 0}%`}></span></div>
              <a class="small" href="/kapital/diagnostic">{score ? 'Refaire le diagnostic' : 'Faire le diagnostic'}</a>
            </div>
            <div class="panel">
              <h3>Statut du dossier</h3>
              <ol class="timeline">{PIPELINE.filter((p) => !['incomplet', 'cloture'].includes(p.key) || p.key === d.status).map((p) => {
                const i = PIPELINE.indexOf(p);
                return <li class={i < stepIdx ? 'done' : i === stepIdx ? 'cur' : ''}>{p.label}</li>;
              })}</ol>
              <p class="xs muted" style="margin:0">Étape actuelle depuis {daysIn} jour{daysIn > 1 ? 's' : ''}{sla ? ` · délai cible ${sla} jours ouvrés` : ''}{sla && daysIn > sla ? ' · en retard, l’analyste est relancé' : ''}.</p>
            </div>
            <div class="panel">
              <h3>Votre analyste</h3>
              {analyst ? (
                <>
                  <p style="margin:0 0 10px"><b>{analyst.name}</b></p>
                  <form data-api="/api/messages" data-reset>
                    <input type="hidden" name="to" value={analyst.id} />
                    <textarea class="in" name="body" required minlength="2" placeholder="Question, demande de rendez-vous…" aria-label="Message à l’analyste"></textarea>
                    <button class="btn btn-primary btn-sm" type="submit">Envoyer</button>
                  </form>
                </>
              ) : <p class="small muted" style="margin:0">Un analyste vous sera assigné sous 5 jours ouvrés.</p>}
            </div>
          </div>

          <div class="grid g2" style="margin-top:18px">
            <div class="panel">
              <h3>Data room</h3>
              {docs.length ? docs.map(({ doc, views, secs }) => <div class="list-row"><span class="row"><Icon name="doc" size={16} /> <span class="tag">{doc.folder}</span> <a href={`/kapital/dataroom/${doc.id}`}>{doc.name}</a> <span class="xs muted">v{doc.version}</span></span><span class="muted small">{views} vue{views > 1 ? 's' : ''} · {mins(secs)}</span></div>) : <p class="small muted">Aucun document. Arborescence standard de due diligence ci-dessous.</p>}
              <form id="drUp" data-dossier={d.id} style="margin-top:12px">
                <div class="row" style="gap:8px">
                  <select class="in" name="folder" aria-label="Dossier" style="width:auto;margin:0">{FOLDERS.map(([k, l]) => <option value={k}>{l}</option>)}</select>
                  <input class="in" type="file" name="file" required accept=".pdf,.docx,.xlsx,.pptx,.png,.jpg,.jpeg,.webp" style="flex:1;margin:0" />
                  <button class="btn btn-primary btn-sm" type="submit">Déposer</button>
                </div>
                <p class="xs muted" style="margin:6px 0 0">PDF, DOCX, XLSX, PPTX, images — 15 Mo maximum. Documents chiffrés, privés par défaut.</p>
              </form>
              <h4 style="margin-top:16px">Qui a consulté</h4>
              {viewers.length ? viewers.map((v) => <div class="small">{v.name} — {v.docs} document{v.docs > 1 ? 's' : ''}, {mins(v.secs)}</div>) : <p class="small muted" style="margin:0">Aucune consultation pour le moment.</p>}
            </div>
            <div class="panel">
              <div class="row between"><h3 style="margin:0">Partage avec les investisseurs</h3><button class="toggle" type="button" role="switch" aria-checked={d.shareConsent ? 'true' : 'false'} aria-label="Partage avec les investisseurs" data-post="/api/kapital/partage" data-body={JSON.stringify({ dossierId: d.id, share: !d.shareConsent })} data-reload></button></div>
              <p class="small muted">{d.published ? 'Votre résumé anonymisé est publié auprès des investisseurs vérifiés.' : 'Le résumé sera publié après validation par le comité.'}</p>
              <h4>Accords de confidentialité ({ndas.length})</h4>
              {ndas.length ? ndas.map((n) => {
                const expired = !!n.until && n.until.getTime() <= Date.now();
                return <div class="list-row"><span class="small">{n.name} · signé le {dateUtc(n.signedAt)}{n.until && <> · {expired ? <b style="color:var(--bad)">accès expiré le {dateUtc(n.until)}</b> : `accès jusqu'au ${dateUtc(n.until)}`}</>}</span><span class="row" style="gap:4px"><button class="btn btn-ghost btn-sm" type="button" data-post="/api/kapital/nda" data-method="PATCH" data-body={JSON.stringify({ dossierId: d.id, investorId: n.investorId, days: 30 })} data-reload>{expired ? 'Rouvrir 30 jours' : 'Prolonger de 30 jours'}</button><button class="btn btn-ghost btn-sm" type="button" data-post="/api/kapital/nda" data-method="DELETE" data-body={JSON.stringify({ dossierId: d.id, investorId: n.investorId })} data-confirm="Révoquer l’accès de cet investisseur ?" data-reload>Révoquer</button></span></div>;
              }) : <p class="small muted">Aucun.</p>}
              <form class="row" data-api="/api/kapital/nda" data-method="PATCH" data-reload style="gap:6px;margin-top:8px;align-items:flex-end">
                <input type="hidden" name="dossierId" value={d.id} />
                <div><label class="f" for="ad">Durée d'accès des prochaines signatures (jours)</label><input class="in" id="ad" name="accessDays" type="number" min="7" max="365" value={d.accessDays} style="width:110px;margin:0" /></div>
                <button class="btn btn-ghost btn-sm" type="submit">Enregistrer</button>
              </form>
              <h4 style="margin-top:12px">Intérêts manifestés ({interests.length})</h4>
              {interests.map((i) => <div class="small">{i.name}{i.amount ? <> — <Money xof={i.amount} /></> : ''}</div>)}
              <form data-api="/api/kapital/mises-a-jour" data-reset style="margin-top:14px">
                <input type="hidden" name="dossierId" value={d.id} />
                <label class="f" for="iu">Mise à jour aux investisseurs</label>
                <textarea class="in" id="iu" name="body" required minlength="10" placeholder="Chiffres du mois, jalons, besoins…"></textarea>
                <button class="btn btn-primary btn-sm" type="submit">Envoyer aux investisseurs intéressés</button>
              </form>
            </div>
          </div>

          <div class="panel" id="questions" style="margin-top:18px">
            <h3>Questions des investisseurs{pending ? ` (${pending} sans réponse)` : ''}</h3>
            {questions.length ? questions.map(({ q, name }) => (
              <div class="list-row" style="display:block">
                <div class="row between"><b class="small">{name}</b><span class="xs muted">{dateUtc(q.createdAt)}{q.shared ? ' · réponse partagée' : ''}</span></div>
                <p style="margin:4px 0">{q.question}</p>
                {q.answer ? <p class="small" style="margin:0;border-left:3px solid var(--gold);padding-left:10px">{q.answer}</p> : (
                  <form data-api="/api/kapital/questions" data-method="PATCH" data-reload>
                    <input type="hidden" name="id" value={q.id} />
                    <textarea class="in" name="answer" required minlength="2" maxlength="4000" aria-label={`Réponse à ${name}`} placeholder="Votre réponse"></textarea>
                    <label class="row small"><input type="checkbox" name="shared" /> Publier la réponse pour tous les investisseurs sous accord (sans le nom de l'auteur)</label>
                    <button class="btn btn-primary btn-sm" type="submit">Répondre</button>
                  </form>
                )}
              </div>
            )) : <p class="small muted" style="margin:0">Les investisseurs sous accord de confidentialité peuvent vous poser leurs questions depuis votre fiche ; elles apparaîtront ici.</p>}
          </div>

          <div class="panel" id="pageOp" style="margin-top:18px">
            <div class="row between"><h3 style="margin:0">Page d'opportunité</h3><a class="small" href={`/kapital/opportunites/${d.id}`}>Voir ma page</a></div>
            <p class="small muted">Composez la page que voient les investisseurs : vidéo de présentation, équipe, traction, utilisation des fonds, jalons. Ne publiez que des informations que vous acceptez de montrer avant tout accord de confidentialité.</p>
            <div id="opEd" data-dossier={d.id}></div>
            <button class="btn btn-primary btn-sm" type="button" id="opSave" style="margin-top:12px">Enregistrer la page</button>
          </div>
          <script type="application/json" id="opData" set:html={JSON.stringify(pageData)} />

          <div class="panel" style="margin-top:18px">
            <h3>Historique</h3>
            {events.map((e) => <div class="list-row"><span class="small">{statusLabel(e.toStatus)}{e.note ? ` — ${e.note}` : ''}</span><span class="muted small">{e.at.toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })}</span></div>)}
            <p class="xs muted" style="margin:8px 0 0">Montant recherché : <Money xof={d.amountXof ?? 0} /> · {d.instrument ? INSTRUMENT_LABEL[d.instrument] : 'instrument à préciser'}</p>
          </div>
        </>
      )}
    </div>
  </section>
</KapitalLayout>
<style is:global>
  .op-list{border:1px solid var(--line);border-radius:10px;padding:8px 12px 12px;margin:14px 0 0}
  .op-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px}
  .op-row .in{margin:0;min-width:120px}
</style>
<script>
  /* Constructeur de page d'opportunité : champs simples et listes (ajout / suppression de lignes), enregistrés par PUT /api/kapital/page */
  type Col = { k: string; label: string; type?: 'number' | 'textarea'; w?: string };
  type Page = Record<string, unknown> & { tagline: string; video: string; highlights: string[] };
  const ed = document.getElementById('opEd');
  if (ed) {
    const data = JSON.parse(document.getElementById('opData')!.textContent!) as Page;
    const LISTS: { k: string; title: string; add: string; cols: Col[]; max: number }[] = [
      { k: 'kpis', title: 'Indicateurs de traction', add: 'un indicateur', max: 8, cols: [{ k: 'label', label: 'Indicateur (ex. Clients actifs)' }, { k: 'value', label: 'Valeur (ex. 1 200)', w: '160px' }] },
      { k: 'team', title: "L'équipe", add: 'un membre', max: 8, cols: [{ k: 'name', label: 'Nom', w: '180px' }, { k: 'role', label: 'Fonction', w: '180px' }, { k: 'bio', label: 'Parcours en une phrase' }] },
      { k: 'funds', title: 'Utilisation des fonds (total 100 %)', add: 'un poste', max: 8, cols: [{ k: 'label', label: 'Poste (ex. Recrutement)' }, { k: 'pct', label: '%', type: 'number', w: '90px' }] },
      { k: 'milestones', title: 'Jalons', add: 'un jalon', max: 10, cols: [{ k: 'when', label: 'Date (ex. T2 2027)', w: '160px' }, { k: 'label', label: 'Jalon' }] },
    ];
    const esc = (v: unknown) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const rows = (k: string) => ((data[k] as Record<string, unknown>[]) ??= []);
    const total = () => rows('funds').reduce((a, r) => a + (Number(r.pct) || 0), 0);
    const render = () => {
      ed.innerHTML = `
        <label class="f" for="opTag">Accroche (une phrase)</label><input class="in" id="opTag" data-f="tagline" maxlength="160" value="${esc(data.tagline)}" />
        <label class="f" for="opVid">Vidéo de présentation (YouTube, Vimeo ou fichier .mp4 en https://)</label><input class="in" id="opVid" data-f="video" maxlength="500" value="${esc(data.video)}" placeholder="https://www.youtube.com/watch?v=…" />
        <label class="f" for="opHi">Points forts (un par ligne, 6 au plus)</label><textarea class="in" id="opHi" data-f="highlights" rows="3">${esc(data.highlights.join('\n'))}</textarea>
        ${LISTS.map((l) => `<fieldset class="op-list"><legend class="small"><b>${l.title}</b>${l.k === 'funds' ? ` <span class="xs ${total() === 100 || !rows('funds').length ? 'muted' : ''}" style="${total() !== 100 && rows('funds').length ? 'color:var(--bad)' : ''}">— total ${total()} %</span>` : ''}</legend>
          ${rows(l.k).map((r, i) => `<div class="op-row">${l.cols.map((c) => `<input class="in" ${c.type === 'number' ? 'type="number" min="1" max="100"' : ''} data-l="${l.k}" data-i="${i}" data-c="${c.k}" value="${esc(r[c.k])}" aria-label="${esc(c.label)}" placeholder="${esc(c.label)}" style="${c.w ? `flex:0 0 ${c.w}` : 'flex:1'}" />`).join('')}<button class="btn btn-ghost btn-sm" type="button" data-del="${l.k}" data-i="${i}" aria-label="Supprimer">✕</button></div>`).join('')}
          ${rows(l.k).length < l.max ? `<button class="btn btn-ghost btn-sm" type="button" data-add="${l.k}">+ Ajouter ${l.add}</button>` : ''}</fieldset>`).join('')}`;
    };
    ed.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.dataset.f === 'highlights') data.highlights = el.value.split('\n').map((x) => x.trim()).filter(Boolean).slice(0, 6);
      else if (el.dataset.f) data[el.dataset.f] = el.value;
      else if (el.dataset.l) {
        rows(el.dataset.l)[Number(el.dataset.i)][el.dataset.c!] = el.type === 'number' ? Number(el.value) || 0 : el.value;
        if (el.dataset.l === 'funds') { const lg = ed.querySelector('[data-l="funds"]')?.closest('fieldset')?.querySelector('legend span'); if (lg) { lg.textContent = `— total ${total()} %`; (lg as HTMLElement).style.color = total() === 100 ? '' : 'var(--bad)'; } }
      }
    });
    ed.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button');
      if (!b) return;
      if (b.dataset.add) { const l = LISTS.find((x) => x.k === b.dataset.add)!; rows(l.k).push(Object.fromEntries(l.cols.map((c) => [c.k, c.type === 'number' ? 0 : '']))); render(); }
      else if (b.dataset.del) { rows(b.dataset.del).splice(Number(b.dataset.i), 1); render(); }
    });
    render();
    document.getElementById('opSave')!.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      const res = await fetch('/api/kapital/page', { method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ dossierId: ed.dataset.dossier, page: data }) }).catch(() => null);
      const d = res ? await res.json().catch(() => ({})) : {};
      btn.disabled = false;
      (window as unknown as { toast: (t: string) => void }).toast(d.message || d.error || 'Erreur réseau.');
    });
  }

  const f = document.getElementById('drUp') as HTMLFormElement | null;
  const toast = (t: string) => (window as unknown as { toast: (t: string) => void }).toast(t);
  f?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!f.checkValidity()) return f.reportValidity();
    const fd = new FormData(f);
    fd.set('dossierId', f.dataset.dossier!);
    const res = await fetch('/api/kapital/documents', { method: 'POST', body: fd });
    const d = await res.json().catch(() => ({}));
    toast(d.message || d.error || 'Erreur.');
    if (d.ok) setTimeout(() => location.reload(), 700);
  });
</script>
