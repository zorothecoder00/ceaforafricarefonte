---
import KapitalLayout from '../../layouts/KapitalLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { BONDS } from '../../data/site';

export const prerender = false;

const kinds = [['Obligations vertes', 'Financer des projets environnementaux : énergie solaire, efficacité énergétique, eau.'], ['Obligations sociales', 'Financer des projets à impact social : santé, éducation, logement abordable.'], ['Obligations durables', 'Combiner les deux, avec un cadre de reporting annuel.']];
---
<KapitalLayout title="Finance verte et durable">
  <PageHead title="Finance verte et durable" lead="Obligations vertes, sociales et durables : comprendre, émettre, mesurer l'impact." crumbs={[['/kapital', 'Kapital Invest'], ['', 'Finance verte']]} />
  <section class="block">
    <div class="wrap">
      <div class="grid g3">{kinds.map(([t, d]) => <div class="panel"><h3>{t}</h3><p class="small" style="margin:0">{d}</p></div>)}</div>
      <h2 style="margin-top:30px">Émissions vertes et islamiques récentes (fictives)</h2>
      {BONDS.filter((b) => b.type === 'Obligation verte' || b.type === 'Sukuk').map((b) => (
        <div class="panel row between" style="margin-bottom:8px"><span><b>{b.e}</b> <span class="small muted">· {b.m} · échéance {b.mat}</span></span><span class={`tag ${b.type === 'Sukuk' ? 'gold' : 'ok'}`}>{b.type} · {b.r.toLocaleString('fr-FR')} %</span></div>
      ))}
      <div class="panel" style="margin-top:20px"><h3>Accompagnement des émetteurs</h3><p class="small">Cadre d'émission, revue externe, mesure d'impact alignée sur l'<a href="/impact">observatoire CEA</a>.</p><a class="btn btn-primary btn-sm" href="/kapital/ipo-ready">Commencer</a></div>
    </div>
  </section>
</KapitalLayout>
