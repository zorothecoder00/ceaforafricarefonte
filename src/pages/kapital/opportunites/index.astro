---
/* Opportunités publiées (CDC §8.3) : résumés anonymisés, filtres ; le dossier complet exige un profil vérifié et un NDA. */
import KapitalLayout from '../../../layouts/KapitalLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import OppCard from '../../../components/OppCard.astro';
import { sql } from 'drizzle-orm';
import { db } from '../../../lib/db';
import { dossier } from '../../../db/schema/kapital';
import { listOpportunities } from '../../../lib/kapital';
import { country } from '../../../data/site';

export const prerender = false;
const q = Astro.url.searchParams;
const f = { sector: q.get('secteur') ?? '', stage: q.get('stade') ?? '', country: q.get('pays') ?? '', verification: q.get('verif') ?? '' };
const opps = await listOpportunities(f);
const facets = await db.select({ s: sql<string[]>`array_agg(distinct ${dossier.sector})`, st: sql<string[]>`array_agg(distinct ${dossier.stage})`, c: sql<string[]>`array_agg(distinct ${dossier.country})` }).from(dossier).where(sql`${dossier.published} and ${dossier.shareConsent}`);
const clean = (a: string[] | null) => (a ?? []).filter(Boolean).sort();
---
<KapitalLayout title="Opportunités" group="investir">
  <PageHead title="Opportunités" lead="Résumés anonymisés. L'accès au dossier complet exige un profil investisseur vérifié et un accord de confidentialité." crumbs={[['/kapital', 'Kapital Invest'], ['', 'Opportunités']]} />
  <section class="block" style="padding-top:20px">
    <div class="wrap">
      <form class="filters" method="get">
        <select class="in" name="secteur" aria-label="Secteur"><option value="">Tous les secteurs</option>{clean(facets[0].s).map((x) => <option selected={x === f.sector}>{x}</option>)}</select>
        <select class="in" name="stade" aria-label="Stade"><option value="">Tous les stades</option>{clean(facets[0].st).map((x) => <option selected={x === f.stage}>{x}</option>)}</select>
        <select class="in" name="pays" aria-label="Pays"><option value="">Tous les pays</option>{clean(facets[0].c).map((x) => <option value={x} selected={x === f.country}>{country(x)}</option>)}</select>
        <select class="in" name="verif" aria-label="Vérification"><option value="">Toute vérification</option><option value="verifie" selected={f.verification === 'verifie'}>Vérifié par CEA</option><option value="diligence_en_cours" selected={f.verification === 'diligence_en_cours'}>Diligence en cours</option><option value="declaratif" selected={f.verification === 'declaratif'}>Déclaratif</option></select>
        <button class="btn btn-primary btn-sm" type="submit">Filtrer</button>
      </form>
      {opps.length ? <div class="grid g3">{opps.map((o) => <OppCard o={o} />)}</div> : <div class="empty">Aucune opportunité ne correspond à ces critères.</div>}
    </div>
  </section>
</KapitalLayout>
