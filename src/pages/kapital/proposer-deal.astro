---
import KapitalLayout from '../../layouts/KapitalLayout.astro';
import PageHead from '../../components/PageHead.astro';

export const prerender = false;
---
<KapitalLayout title="Proposer un deal">
  <PageHead title="Proposer un deal" lead="Fondateur, business angel ou fonds : présentez une entreprise à notre équipe d'investissement." crumbs={[['/kapital', 'Kapital Invest'], ['/kapital/capital-risque', 'Capital-risque'], ['', 'Proposer un deal']]} />
  <section class="block">
    <div class="wrap" style="max-width:700px">
      <form class="panel" data-api="/api/demande" data-reset>
          <input type="hidden" name="type" value="deal" /><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px" />
        <label class="f" for="pdn">Nom</label><input class="in" id="pdn" name="name" required minlength="2" autocomplete="name" />
          <label class="f" for="pdc">E-mail ou téléphone</label><input class="in" id="pdc" name="contact" required minlength="5" autocomplete="email" />
        <label class="f" for="pd1">Vous êtes</label><select class="in" id="pd1" name="Vous êtes"><option>Fondateur</option><option>Business angel</option><option>Fonds</option><option>Autre</option></select>
        <label class="f" for="pd2">Entreprise</label><input class="in" id="pd2" name="Entreprise" required />
        <label class="f" for="pd5">Site web ou deck (lien)</label><input class="in" id="pd5" name="Site ou deck" type="url" placeholder="https://" />
        <label class="f" for="pd3">Pourquoi cette entreprise ?</label><textarea class="in" id="pd3" name="message" required minlength="10"></textarea>
        <label class="row small"><input type="checkbox" required /> Je n'ai pas de conflit d'intérêts non déclaré avec cette entreprise.</label>
        <button class="btn btn-primary" type="submit" style="margin-top:12px">Envoyer</button>
      </form>
    </div>
  </section>
</KapitalLayout>
