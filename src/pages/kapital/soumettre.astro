---
import KapitalLayout from '../../layouts/KapitalLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Wizard from '../../components/Wizard.astro';
import { COUNTRIES } from '../../data/site';

export const prerender = false;

const instruments = ['Actions ordinaires', 'Actions de préférence', 'SAFE / BSA AIR', 'Obligations convertibles', 'Dette privée', 'Mezzanine', 'Financement islamique'];
const fs = 'border:0;padding:0;margin:0';
---
<KapitalLayout title="Soumettre mon dossier">
  <PageHead title="Soumettre mon dossier" lead="Environ 15 minutes. Brouillon enregistré automatiquement." crumbs={[['/kapital', 'Kapital Invest'], ['', 'Soumettre mon dossier']]} />
  <section class="block">
    <div class="wrap" style="max-width:740px">
      <Wizard id="kapital" prefix="D" api="/api/kapital/dossiers" attach="dossier" submitLabel="Soumettre le dossier" success="Un analyste vous contacte sous 5 jours ouvrés. Suivez l'avancement dans votre espace entreprise.">
        <fieldset data-step="Entreprise" style={fs}>
          <label class="f" for="k1">Nom de l'entreprise</label><input class="in" id="k1" name="entreprise" required />
          <label class="f" for="k2">Pays du siège</label><select class="in" id="k2" name="pays">{Object.entries(COUNTRIES).map(([k, v]) => <option value={k}>{v}</option>)}</select>
          <label class="f" for="k3">Numéro RCCM ou équivalent</label><input class="in" id="k3" name="rccm" />
          <label class="f" for="k4">Secteur</label><input class="in" id="k4" name="secteur" />
        </fieldset>
        <fieldset data-step="Levée" style={fs}>
          <label class="f" for="l1">Montant recherché (FCFA)</label><input class="in" id="l1" name="montant" type="number" min="1" required />
          <label class="f" for="l2">Instrument envisagé</label><select class="in" id="l2" name="instrument">{instruments.map((x) => <option>{x}</option>)}</select>
          <label class="f" for="l3">Utilisation des fonds</label><textarea class="in" id="l3" name="usage"></textarea>
        </fieldset>
        <fieldset data-step="Documents" style={fs}>
          <p class="small muted">PDF, DOCX, XLSX ou PPTX (15 Mo maximum par fichier). Ils rejoignent la data room privée de votre dossier.</p>
          {([['Pitch deck', 'commercial'], ['Modèle financier', 'financier'], ['États financiers', 'financier'], ['Statuts et pacte', 'juridique']] as const).map(([x, folder], i) => <><label class="f" for={`kd${i}`}>{x}</label><input class="in" type="file" id={`kd${i}`} accept=".pdf,.docx,.xlsx,.pptx" data-label={x} data-folder={folder} /></>)}
          <div class="small" data-uploads></div>
        </fieldset>
        <fieldset data-step="Partage et consentements" style={fs}>
          <p class="small">Votre dossier est <b>privé par défaut</b>. Rien n'est partagé avec un investisseur sans votre autorisation, que vous pouvez retirer à tout moment.</p>
          <label class="row small" style="margin:6px 0"><input type="checkbox" name="attest" required /> J'atteste l'exactitude des informations fournies.</label>
          <label class="row small" style="margin:6px 0"><input type="checkbox" name="kyb" required /> J'autorise CEA à vérifier l'entreprise et ses dirigeants (KYB).</label>
          <label class="row small" style="margin:6px 0"><input type="checkbox" name="partage" /> J'autorise la présentation d'un résumé anonymisé aux investisseurs vérifiés.</label>
        </fieldset>
      </Wizard>
      <p class="small" style="margin-top:14px">Pas encore fait le diagnostic ? <a href="/kapital/diagnostic">Suis-je prêt ?</a></p>
    </div>
  </section>
</KapitalLayout>
