---
/* Paramétrage (CDC §12) : identité légale, fiscalité et comptes comptables ; modèles de messages ; redirections ; consentements.
   Les interrupteurs par pays, les rôles et la matrice des droits ont leurs propres pages. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { desc, eq, sql } from 'drizzle-orm';
import { db } from '../../lib/db';
import { consent, auditLog } from '../../db/schema/app';
import { runRetention, RETENTION_LABEL } from '../../lib/retention';
import { getLocalisation, TIMEZONES, LANGUAGES, FIXED_RATES } from '../../lib/localisation';
import { messageTemplate, redirect } from '../../db/schema/finance';
import { can } from '../../lib/rbac';
import { getSetting } from '../../lib/settings';
import { TEMPLATES } from '../../lib/templates';

export const prerender = false;
const me = Astro.locals.user!;
const canM = can(me.roles, 'parametres', 'M');
const tab = Astro.url.searchParams.get('onglet') ?? 'reglages';
const loc = tab === 'localisation' ? await getLocalisation() : null;
// Conservation des données : réglages, aperçu de ce que le prochain passage traiterait, dernier passage
const keep = tab === 'conservation' ? await getSetting('conservation') : null;
const preview = tab === 'conservation' ? await runRetention(new Date(), { dryRun: true }).catch(() => null) : null;
const [lastRun] = tab === 'conservation' ? await db.select().from(auditLog).where(eq(auditLog.action, 'conservation.passage')).orderBy(desc(auditLog.at)).limit(1) : [];
const [org, fisc, acc] = await Promise.all([getSetting('organisation'), getSetting('fiscalite'), getSetting('comptabilite')]);
const custom = tab === 'modeles' ? await db.select().from(messageTemplate) : [];
const redirects = tab === 'redirections' ? await db.select().from(redirect).orderBy(desc(redirect.createdAt)) : [];
// Consentements : dernier choix connu de chaque membre, par type
const consents = tab === 'consentements' ? (await db.execute(sql`select kind, granted, count(*)::int as n from (select distinct on (${consent.userId}, ${consent.kind}) ${consent.kind} as kind, ${consent.granted} as granted from ${consent} order by ${consent.userId}, ${consent.kind}, ${consent.at} desc) t group by 1, 2 order by 1, 2`)).rows as { kind: string; granted: boolean; n: number }[] : [];
const CONSENT: Record<string, string> = { compte: 'Conditions du compte', profil_public: 'Profil visible publiquement', marketing: 'Communications marketing', partage_investisseurs: 'Partage du dossier aux investisseurs', cookies_mesure: "Cookies de mesure d'audience" };
const PURPOSE: Record<string, string> = { adhesion: 'Adhésions', billet: 'Billetterie', cours: 'Formations', programme: 'Programmes', mastermind: 'Mastermind', expert: 'Consultations d’experts', mise_en_avant: 'Mises en avant d’offres', recherche: 'Abonnements recherche', sponsoring: 'Sponsoring', autre: 'Autres ventes' };
---
<AdminLayout title="Paramétrage" lead="Réglages modifiables sans développeur. Chaque modification est inscrite au journal d'audit." obj="parametres">
  <nav class="subnav" style="margin:0 0 14px">{[['reglages', 'Identité, fiscalité, comptabilité'], ['modeles', 'Modèles de messages'], ['redirections', 'Redirections'], ['consentements', 'Consentements'], ['localisation', 'Pays, langues, devises'], ['conservation', 'Conservation des données']].map(([k, l]) => <a href={`?onglet=${k}`} aria-current={k === tab ? 'page' : undefined}>{l}</a>)}<a href="/admin/interrupteurs">Interrupteurs par pays</a><a href="/admin/droits">Rôles et droits</a></nav>

  {tab === 'reglages' && (
    <fieldset disabled={!canM} style="border:0;padding:0;margin:0">
      <form class="panel set" data-key="organisation">
        <h3 style="margin-top:0">Identité légale <span class="xs muted">(en-tête des factures et reçus)</span></h3>
        <div class="grid g2" style="gap:0 12px">
          {[['name', 'Raison sociale'], ['legalForm', 'Forme juridique'], ['rccm', 'RCCM'], ['taxId', 'NIF'], ['email', 'E-mail'], ['phone', 'Téléphone']].map(([k, l]) => <div><label class="f" for={`o-${k}`}>{l}</label><input class="in" id={`o-${k}`} name={k} value={(org as Record<string, string>)[k]} /></div>)}
          <div style="grid-column:1/-1"><label class="f" for="o-address">Adresse</label><input class="in" id="o-address" name="address" value={org.address} /></div>
          <div style="grid-column:1/-1"><label class="f" for="o-footer">Mention de bas de facture</label><input class="in" id="o-footer" name="footer" value={org.footer} /></div>
        </div>
        {canM && <button class="btn btn-primary btn-sm" type="submit" style="margin-top:10px">Enregistrer</button>}
      </form>
      <form class="panel set" data-key="fiscalite" style="margin-top:14px">
        <h3 style="margin-top:0">Fiscalité</h3>
        <div class="grid g2" style="gap:0 12px">
          <div><label class="f" for="f-rate">Taux de TVA (%)</label><input class="in" id="f-rate" name="rate" type="number" min="0" max="30" step="0.1" value={fisc.rate / 10} data-kind="permille" /></div>
          <div><label class="f" for="f-due">Échéance des factures manuelles (jours)</label><input class="in" id="f-due" name="dueDays" type="number" min="0" max="120" value={fisc.dueDays} data-kind="int" /></div>
          <div style="grid-column:1/-1"><label class="f" for="f-mention">Mention si taux nul</label><input class="in" id="f-mention" name="mention" value={fisc.mention} /></div>
        </div>
        <p class="xs muted">Le taux s'applique aux factures émises après la modification ; les factures déjà émises ne changent pas. Les prix affichés sur le site sont toutes taxes comprises.</p>
        {canM && <button class="btn btn-primary btn-sm" type="submit">Enregistrer</button>}
      </form>
      <form class="panel set" data-key="comptabilite" style="margin-top:14px">
        <h3 style="margin-top:0">Comptabilité (plan SYSCOHADA)</h3>
        <div class="grid g3" style="gap:0 12px">
          <div><label class="f" for="c-j">Code journal des ventes</label><input class="in" id="c-j" name="journal" value={acc.journal} /></div>
          <div><label class="f" for="c-c">Compte clients</label><input class="in" id="c-c" name="client" value={acc.client} pattern="\d{3,10}" /></div>
          <div><label class="f" for="c-t">Compte TVA collectée</label><input class="in" id="c-t" name="tva" value={acc.tva} pattern="\d{3,10}" /></div>
        </div>
        <h4 style="margin:12px 0 4px">Comptes de produits par objet</h4>
        <div class="grid g3" style="gap:0 12px">{Object.entries(PURPOSE).map(([k, l]) => <div><label class="f" for={`a-${k}`}>{l}</label><input class="in" id={`a-${k}`} name={`acc_${k}`} value={acc.accounts[k] ?? ''} pattern="\d{3,10}" /></div>)}</div>
        {canM && <button class="btn btn-primary btn-sm" type="submit" style="margin-top:10px">Enregistrer</button>}
      </form>
    </fieldset>
  )}

  {tab === 'modeles' && (
    <>
      <p class="small muted">Textes des notifications envoyées dans l'espace membre, par e-mail et WhatsApp. Utilisez les variables proposées entre accolades.</p>
      {Object.entries(TEMPLATES).map(([k, t]) => { const c = custom.find((x) => x.key === k); return (
        <form class="panel tpl" data-key={k} style="margin-bottom:10px">
          <div class="row between"><b class="small">{t.label}</b><span class="xs muted">{c ? `personnalisé le ${c.updatedAt.toLocaleDateString('fr-FR')}` : 'texte par défaut'} · variables : {t.vars.map((v) => `{${v}}`).join(', ')}</span></div>
          <textarea class="in" name="body" rows="2" maxlength="1000" disabled={!canM}>{c?.body ?? t.body}</textarea>
          {canM && <div class="row" style="gap:6px"><button class="btn btn-ghost btn-sm" type="submit">Enregistrer</button>{c && <button class="btn btn-ghost btn-sm" type="button" data-reset={k}>Rétablir le texte par défaut</button>}</div>}
        </form>
      ); })}
    </>
  )}

  {tab === 'redirections' && (
    <>
      <div class="panel scroll-x">
        {redirects.length === 0 ? <p class="small muted" style="margin:0">Aucune redirection.</p> : (
          <table class="t"><thead><tr><th>Depuis</th><th>Vers</th><th>Type</th><th>Passages</th><th></th></tr></thead>
            <tbody>{redirects.map((r) => <tr><td class="small"><code>{r.fromPath}</code></td><td class="small"><code>{r.toUrl}</code></td><td class="small">{r.code === 301 ? 'Définitive (301)' : 'Temporaire (302)'}</td><td class="small">{r.hits}</td><td>{canM && <button class="btn btn-ghost btn-sm" type="button" data-post="/api/admin/parametrage" data-body={JSON.stringify({ action: 'redirect.delete', id: r.id })} data-confirm="Supprimer cette redirection ?" data-reload aria-label="Supprimer">✕</button>}</td></tr>)}</tbody></table>
        )}
      </div>
      {canM && (
        <form class="panel row" data-api="/api/admin/parametrage" data-reload data-reset style="margin-top:12px;gap:8px;flex-wrap:wrap;align-items:flex-end">
          <input type="hidden" name="action" value="redirect.save" />
          <div style="flex:1;min-width:180px"><label class="f" for="rf">Depuis</label><input class="in" id="rf" name="fromPath" required placeholder="/ancienne-page" /></div>
          <div style="flex:1;min-width:180px"><label class="f" for="rt">Vers</label><input class="in" id="rt" name="toUrl" required placeholder="/nouvelle-page ou https://…" /></div>
          <div><label class="f" for="rc">Type</label><select class="in" id="rc" name="code" data-type="number"><option value="301">Définitive (301)</option><option value="302">Temporaire (302)</option></select></div>
          <button class="btn btn-primary btn-sm" type="submit">Ajouter</button>
        </form>
      )}
      <p class="xs muted">S'applique aux adresses qui n'existent plus sur le site. Les adresses de l'espace membre, du back-office et des API ne sont jamais redirigées.</p>
    </>
  )}

  {tab === 'consentements' && (
    <div class="panel scroll-x">
      <table class="t"><thead><tr><th>Consentement</th><th>Accordé</th><th>Refusé ou retiré</th></tr></thead>
        <tbody>{[...new Set(consents.map((c) => c.kind))].map((k) => <tr><td class="small">{CONSENT[k] ?? k}</td><td class="small">{consents.find((c) => c.kind === k && c.granted)?.n ?? 0}</td><td class="small">{consents.find((c) => c.kind === k && !c.granted)?.n ?? 0}</td></tr>)}</tbody></table>
      {consents.length === 0 && <p class="small muted">Aucun consentement enregistré.</p>}
      <p class="xs muted" style="margin:8px 0 0">Dernier choix connu de chaque membre. L'historique complet de chaque personne est dans sa fiche CRM ; les contacts externes portent la base légale de leur consentement.</p>
    </div>
  )}

  {tab === 'localisation' && loc && (
    <form class="panel" id="locF">
      <fieldset disabled={!canM} style="border:0;padding:0;margin:0">
        <h3 style="margin-top:0">Pays de présence</h3>
        <p class="small muted" style="margin-top:0">Un pays désactivé n'est plus proposé dans le sélecteur de pays de l'en-tête. Sa devise est proposée par défaut aux visiteurs qui le choisissent ; son fuseau sert aux heures données à ses membres (entretiens…).</p>
        <div class="scroll-x"><table class="t"><thead><tr><th>Actif</th><th>Pays</th><th>Devise</th><th>Fuseau horaire</th><th>Langue</th></tr></thead><tbody>
          {loc.countries.map((c) => <tr data-country={c.code}><td><input type="checkbox" data-k="active" checked={c.active} aria-label={`${c.name} actif`} /></td><td class="small">{c.name} <span class="xs muted">{c.code}</span></td>
            <td><select class="in" data-k="currency" aria-label={`Devise ${c.name}`} style="width:auto;padding:4px 8px;margin:0">{loc.currencies.map((x) => <option selected={x.code === c.currency}>{x.code}</option>)}</select></td>
            <td><select class="in" data-k="tz" aria-label={`Fuseau ${c.name}`} style="width:auto;padding:4px 8px;margin:0">{TIMEZONES.map((z) => <option selected={z === c.tz}>{z}</option>)}</select></td>
            <td><select class="in" data-k="lang" aria-label={`Langue ${c.name}`} style="width:auto;padding:4px 8px;margin:0"><option value="fr" selected={c.lang === 'fr'}>Français</option><option value="en" selected={c.lang === 'en'}>English</option></select></td></tr>)}
        </tbody></table></div>
        <h3>Langues de l'interface</h3>
        {LANGUAGES.map((l) => <label class="row small"><input type="checkbox" id={`lang-${l.code}`} checked={l.code === 'fr' || (l.code === 'en' && loc.english)} disabled={l.code !== 'en'} /> {l.name}{l.code === 'fr' ? ' (langue principale)' : !l.ready ? ` — traduction prévue en ${'phase' in l ? l.phase : 'V2'}` : ''}</label>)}
        <h3>Devises et taux indicatifs</h3>
        <p class="small muted" style="margin-top:0">Taux pour 1 euro, affichés avec leur date et leur source. Le franc CFA (XOF, XAF) a une parité fixe avec l'euro.</p>
        <div class="scroll-x"><table class="t"><thead><tr><th>Active</th><th>Devise</th><th class="num">Pour 1 €</th></tr></thead><tbody>
          {loc.currencies.map((c) => <tr data-currency={c.code}><td><input type="checkbox" data-k="active" checked={c.active} disabled={c.code === 'XOF'} aria-label={`${c.code} active`} /></td><td class="small">{c.code} <span class="xs muted">{c.name.fr}</span></td><td class="num"><input class="in" data-k="perEur" type="number" step="any" min="0" value={c.perEur} disabled={c.code in FIXED_RATES} aria-label={`Taux ${c.code}`} style="width:130px;margin:0;text-align:right" /></td></tr>)}
        </tbody></table></div>
        <div class="grid g2" style="gap:0 12px;margin-top:8px">
          <div><label class="f" for="rd">Date des taux</label><input class="in" id="rd" type="date" value={loc.ratesDate} /></div>
          <div><label class="f" for="rs">Source des taux</label><input class="in" id="rs" maxlength="200" value={loc.ratesSource} placeholder="Ex. BCEAO, cours indicatifs du jour" /></div>
        </div>
        {canM && <button class="btn btn-primary btn-sm" type="submit" style="margin-top:10px">Enregistrer</button>}
      </fieldset>
    </form>
  )}

  {tab === 'conservation' && keep && (
    <>
      <form class="panel set" data-key="conservation">
        <h3 style="margin-top:0">Durées de conservation</h3>
        <p class="small muted" style="margin-top:0">Appliquées automatiquement chaque jour, comme l'annonce la politique de confidentialité. Les données de paiement et factures (10 ans) et les pièces KYC (5 ans après la fin de la relation) relèvent d'obligations légales et sont traitées par la conformité.</p>
        <fieldset disabled={!canM} style="border:0;padding:0;margin:0">
          <label class="row small"><input type="checkbox" name="enabled" checked={keep.enabled} /> Appliquer automatiquement</label>
          <div class="grid g3" style="gap:0 12px;margin-top:8px">
            {([['inactiveMonths', 'Compte inactif supprimé après (mois)', 12, 120], ['noticeDays', 'Préavis avant suppression (jours)', 15, 90], ['contactMonths', 'Messages de contact anonymisés après (mois)', 6, 120], ['rejectedMonths', 'Candidatures non retenues effacées après (mois)', 6, 120], ['notificationsMonths', 'Notifications supprimées après (mois)', 1, 60], ['technicalDays', 'Mesures techniques supprimées après (jours)', 30, 730], ['newsletterPendingDays', 'Inscriptions non confirmées supprimées après (jours)', 7, 365], ['auditMonths', 'Journal d’audit conservé (mois, 60 minimum)', 60, 240]] as [keyof typeof keep, string, number, number][]).map(([k, l, min, max]) => <div><label class="f" for={`k-${k}`}>{l}</label><input class="in" id={`k-${k}`} name={k} type="number" min={min} max={max} value={String(keep[k])} data-kind="int" required /></div>)}
          </div>
          {canM && <button class="btn btn-primary btn-sm" type="submit" style="margin-top:10px">Enregistrer</button>}
        </fieldset>
      </form>
      <div class="grid g2" style="margin-top:14px">
        <div class="panel">
          <h3 style="margin-top:0">Prochain passage (aperçu)</h3>
          {preview && !('disabled' in preview) ? <table class="t"><tbody>{Object.entries(preview).map(([k, v]) => <tr><td class="small">{RETENTION_LABEL[k] ?? k}</td><td class="num">{v}</td></tr>)}</tbody></table> : <p class="small muted">Aperçu indisponible.</p>}
          {!keep.enabled && <p class="xs" style="margin:6px 0 0"><b>Application automatique désactivée :</b> rien n'est supprimé.</p>}
        </div>
        <div class="panel">
          <h3 style="margin-top:0">Dernier passage</h3>
          {lastRun ? <><p class="xs muted" style="margin-top:0">{lastRun.at.toLocaleString('fr-FR', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Lome' })}</p><table class="t"><tbody>{Object.entries(lastRun.meta as Record<string, number>).map(([k, v]) => <tr><td class="small">{RETENTION_LABEL[k] ?? k}</td><td class="num">{v}</td></tr>)}</tbody></table></> : <p class="small muted">Aucun passage pour l'instant (tâche quotidienne).</p>}
        </div>
      </div>
    </>
  )}
</AdminLayout>
<script>
  const toast = (t: string) => (window as unknown as { toast: (t: string) => void }).toast(t);
  const api = async (body: Record<string, unknown>, reload = false) => {
    const r = await fetch('/api/admin/parametrage', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : { error: 'Erreur réseau.' };
    toast(d.message ?? d.error ?? 'Erreur.');
    if (d.ok && reload) setTimeout(() => location.reload(), 600);
  };
  document.querySelectorAll<HTMLFormElement>('form.set').forEach((f) => f.addEventListener('submit', (e) => {
    e.preventDefault();
    const value: Record<string, unknown> = {}, accounts: Record<string, string> = {};
    f.querySelectorAll<HTMLInputElement>('input[name]').forEach((i) => {
      if (i.name.startsWith('acc_')) { if (i.value.trim()) accounts[i.name.slice(4)] = i.value.trim(); return; }
      if (i.type === 'checkbox') { value[i.name] = i.checked; return; }
      value[i.name] = i.dataset.kind === 'permille' ? Math.round(Number(i.value || 0) * 10) : i.dataset.kind === 'int' ? Number(i.value || 0) : i.value.trim();
    });
    if (f.dataset.key === 'comptabilite') value.accounts = accounts;
    api({ action: 'setting.save', key: f.dataset.key, value });
  }));
  // Pays, langues, devises : un seul réglage « localisation » construit à partir des tableaux
  document.getElementById('locF')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const countries: Record<string, unknown> = {}, currencies: Record<string, unknown> = {};
    document.querySelectorAll<HTMLTableRowElement>('tr[data-country]').forEach((tr) => {
      const v = (k: string) => tr.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-k="${k}"]`)!;
      countries[tr.dataset.country!] = { active: (v('active') as HTMLInputElement).checked, currency: v('currency').value, tz: v('tz').value, lang: v('lang').value };
    });
    document.querySelectorAll<HTMLTableRowElement>('tr[data-currency]').forEach((tr) => {
      const rate = tr.querySelector<HTMLInputElement>('[data-k="perEur"]')!;
      currencies[tr.dataset.currency!] = { active: tr.querySelector<HTMLInputElement>('[data-k="active"]')!.checked || tr.dataset.currency === 'XOF', perEur: Number(rate.value) };
    });
    api({ action: 'setting.save', key: 'localisation', value: { countries, currencies, english: (document.getElementById('lang-en') as HTMLInputElement).checked, ratesDate: (document.getElementById('rd') as HTMLInputElement).value, ratesSource: (document.getElementById('rs') as HTMLInputElement).value.trim() } }, true);
  });
  document.querySelectorAll<HTMLFormElement>('form.tpl').forEach((f) => f.addEventListener('submit', (e) => {
    e.preventDefault();
    api({ action: 'template.save', key: f.dataset.key, body: (f.querySelector('textarea') as HTMLTextAreaElement).value }, true);
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-reset]').forEach((b) => b.addEventListener('click', () => api({ action: 'template.reset', key: b.dataset.reset }, true)));
</script>
