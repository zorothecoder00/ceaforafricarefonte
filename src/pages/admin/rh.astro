---
/* CEA OS — Ressources humaines (prototype › pRH), profils dg et rh : effectifs (création des fiches et des comptes CEA OS,
   départs), congés et absences, temps passés par domaine, paie mensuelle (taux par devise, bulletins, livre de paie,
   écriture de paie), recrutement (module dédié), entretiens annuels. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import Dlg from '../../components/os/Dlg.astro';
import Steps from '../../components/os/Steps.astro';
import Tags from '../../components/os/Tags.astro';
import { and, desc, eq, sql } from 'drizzle-orm';
import { db } from '../../lib/db';
import { account } from '../../db/schema/auth';
import { osRequest, osTimesheet, osPayroll, osInterview } from '../../db/schema/os';
import { getSetting } from '../../lib/settings';
import { COMPS } from '../../lib/os/pilotage';
import { allStaff } from '../../lib/os/core';
import { DK, GRADES, PK, REF, pn, refT, dstr, fcfa, mfcfa, fmt, gradeOf, BANDS } from '../../lib/os/ref';

export const prerender = false;
const tab = Astro.url.searchParams.get('t') ?? 'eff';
const T: [string, string][] = [['eff', 'Effectifs'], ['abs', 'Congés et absences'], ['temps', 'Temps passés'], ['paie', 'Paie'], ['rec', 'Recrutement'], ['ent', 'Entretiens annuels']];
const monthAgo = (i: number) => { const d = new Date(); d.setDate(1); d.setMonth(d.getMonth() - i); return d.toISOString().slice(0, 7); };
const mParam = Astro.url.searchParams.get('m') ?? '';
const month = /^\d{4}-\d{2}$/.test(mParam) ? mParam : monthAgo(1);
const [pay] = tab === 'paie' ? await db.select().from(osPayroll).where(eq(osPayroll.month, month)) : [];
const rates = tab === 'paie' ? (await getSetting('paie')).rates : {};
const interviews = tab === 'ent' ? await db.select().from(osInterview).orderBy(desc(osInterview.at)) : [];
const year = new Date().getFullYear();
const sumP = (k: 'brut' | 'net' | 'cp') => (pay?.lines ?? []).reduce((a, l) => a + l[k], 0);
const pct = (x: number) => (x * 100).toLocaleString('fr-FR', { maximumFractionDigits: 2 });
const people = await allStaff();
const name = (id: string | null) => people.find((s) => s.id === id)?.name ?? '—';
// Comptes déjà activés (mot de passe choisi) : plus d'invitation à renvoyer
const activated = new Set(tab === 'eff' ? (await db.select({ u: account.userId }).from(account).where(and(eq(account.providerId, 'credential'), sql`${account.password} is not null`))).map((a) => a.u) : []);
const leaves = tab === 'abs' ? await db.select().from(osRequest).where(eq(osRequest.type, 'conge')).orderBy(desc(osRequest.createdAt)) : [];
const byDom = tab === 'temps' ? await db.select({ d: osTimesheet.domain, h: sql<number>`sum(${osTimesheet.hours})::float` }).from(osTimesheet).groupBy(osTimesheet.domain) : [];
const totH = byDom.reduce((a, x) => a + x.h, 0);
---
<AdminLayout title="Ressources humaines et paie" lead={`${people.filter((s) => s.active).length} collaborateurs · ${new Set(people.map((s) => s.country)).size} pays`}>
  <div class="tabs">{T.map(([k, l]) => <a href={`/admin/rh?t=${k}`} aria-selected={k === tab ? 'true' : 'false'}>{l}</a>)}</div>
  {tab === 'eff' && (
    <>
      <div class="toolbar"><button class="btn" type="button" data-dlg="dlg-new">Nouveau collaborateur</button><a class="btn ghost" href="/api/admin/os/export?quoi=effectifs">Exporter</a></div>
      <div class="tw">
        <table class="t">
          <thead><tr><th>Matricule</th><th>Nom</th><th>Poste</th><th>Grade</th><th>Pays</th><th>Responsable</th><th>Entrée</th><th>Salaire brut</th><th>Congés</th><th>Statut</th><th></th></tr></thead>
          <tbody>
            {people.map((s) => (
              <tr>
                <td class="small">{s.id}</td>
                <td><b>{s.name}</b>{s.suspended && <> <span class="tag bad">Suspendu</span></>}{!s.userId && <div class="xs muted">Sans compte</div>}</td>
                <td class="small"><span class="tag">{s.poste}</span> {refT(s.poste)}</td>
                <td class="small">{s.grade}</td>
                <td>{pn(s.country)}</td>
                <td class="small">{name(s.managerId)}</td>
                <td class="small">{dstr(s.hireDate)}</td>
                <td class="num">{fcfa(s.salary)}</td>
                <td class="num">{s.leaveDays} j</td>
                <td><button class="toggle" type="button" role="switch" aria-checked={s.active ? 'true' : 'false'} aria-label={`Compte actif de ${s.name}`} data-post="/api/admin/os/personnel" data-body={JSON.stringify({ action: 'toggle', id: s.id })} data-confirm={s.active ? `Désactiver ${s.name} (départ) ? Ses accès seront révoqués immédiatement.` : undefined} data-reload></button></td>
                <td style="white-space:nowrap">{s.userId && s.active && !activated.has(s.userId) && <button class="btn ghost sm" type="button" data-post="/api/admin/os/personnel" data-body={JSON.stringify({ action: 'invite', id: s.id })} title="Compte pas encore activé : renvoyer le lien pour choisir le mot de passe">Invitation</button>} <button class="btn ghost sm" type="button" data-dlg="dlg-edit" data-set-id={s.id} data-set-who={s.name} data-set-phone={s.phone} data-set-salary={String(s.salary)} data-set-leave-days={String(s.leaveDays)} data-set-manager-id={s.managerId ?? ''} data-set-grade={s.grade}>Modifier</button></td>
              </tr>
            ))}
            {!people.length && <tr><td colspan="11" class="muted">Aucun collaborateur : créez la première fiche avec « Nouveau collaborateur ».</td></tr>}
          </tbody>
        </table>
      </div>
      <Dlg id="dlg-new" title="Nouveau collaborateur" api="/api/admin/os/personnel" submit="Créer" wide>
        <input type="hidden" name="action" value="create" />
        <div class="fg">
          <div><label class="f" for="en">Nom complet</label><input class="in" id="en" name="name" required /></div>
          <div><label class="f" for="ee">E-mail professionnel</label><input class="in" id="ee" name="email" type="email" placeholder="prenom.nom@cea4africa.com" /></div>
          <div class="full"><label class="f" for="epc">Poste du référentiel (le profil d'accès en découle)</label><select class="in" id="epc" name="poste">{REF.filter((r) => r.c !== 'A1' || !people.some((p) => p.poste === 'A1' && p.active)).map((r) => <option value={r.c} data-grade={gradeOf(r.c)}>{r.c} — {r.t}</option>)}</select></div>
          <div><label class="f" for="epa">Pays</label><select class="in" id="epa" name="country">{PK.map((p) => <option value={p}>{pn(p)}</option>)}</select></div>
          <div><label class="f" for="eg">Grade</label><select class="in" id="eg" name="grade">{GRADES.map((g) => <option selected={g === 'Cadre'}>{g}</option>)}</select></div>
          <div><label class="f" for="em">Responsable</label><select class="in" id="em" name="managerId"><option value="">— Aucun (Direction générale)</option>{people.filter((s) => s.active).map((s) => <option value={s.id}>{s.name}</option>)}</select></div>
          <div><label class="f" for="es">Salaire brut mensuel</label><input class="in" type="number" id="es" name="salary" value="900000" min="0" /></div>
          <div><label class="f" for="el">Solde de congés (jours)</label><input class="in" type="number" id="el" name="leaveDays" value="0" min="0" step="0.5" /></div>
        </div>
        <p class="small muted" style="margin-top:8px">Le compte CEA OS est créé avec les droits du profil choisi ; l'intéressé reçoit ses accès par e-mail. Si l'e-mail ne part pas, le lien d'invitation s'affiche pour que vous le transmettiez vous-même.</p>
      </Dlg>
      <Dlg id="dlg-edit" title="Modifier la fiche" api="/api/admin/os/personnel" submit="Enregistrer" wide>
        <input type="hidden" name="action" value="update" /><input type="hidden" name="id" value="" />
        <p class="small"><b data-text="who"></b> — le poste se change dans « Organisation et postes ».</p>
        <div class="fg">
          <div><label class="f" for="xp">Téléphone</label><input class="in" id="xp" name="phone" /></div>
          <div><label class="f" for="xs">Salaire brut mensuel</label><input class="in" type="number" id="xs" name="salary" min="0" required /></div>
          <div><label class="f" for="xl">Solde de congés (jours)</label><input class="in" type="number" id="xl" name="leaveDays" min="0" step="0.5" required /></div>
          <div><label class="f" for="xg">Grade</label><select class="in" id="xg" name="grade">{GRADES.map((g) => <option>{g}</option>)}</select></div>
          <div><label class="f" for="xm">Responsable</label><select class="in" id="xm" name="managerId"><option value="">— Aucun (Direction générale)</option>{people.filter((s) => s.active).map((s) => <option value={s.id}>{s.name}</option>)}</select></div>
        </div>
      </Dlg>
      <script type="application/json" id="bands" set:html={JSON.stringify(BANDS)} />
      <script>
        // Grade et salaire proposés d'après le poste choisi (fourchette du grade)
        const b = JSON.parse(document.getElementById('bands')?.textContent || '{}');
        const pc = document.getElementById('epc') as HTMLSelectElement | null, g = document.getElementById('eg') as HTMLSelectElement | null, s = document.getElementById('es') as HTMLInputElement | null;
        const upd = () => { const gr = pc?.selectedOptions[0]?.dataset.grade; if (gr && g && s) { g.value = gr; s.value = String(b[gr]?.[0] ?? s.value); } };
        pc?.addEventListener('change', upd); upd();
      </script>
    </>
  )}
  {tab === 'abs' && (
    <div class="tw">
      <table class="t">
        <thead><tr><th>Demande</th><th>Collaborateur</th><th>Objet</th><th>Circuit</th><th>Statut</th></tr></thead>
        <tbody>
          {leaves.map((r) => <tr><td class="small">{r.id}</td><td>{name(r.byStaff)}</td><td>{r.title}</td><td><Steps steps={r.steps} cur={r.cur} status={r.status} /></td><td><Tags st={r.status} /></td></tr>)}
          {!leaves.length && <tr><td colspan="5" class="muted">Aucune demande de congé.</td></tr>}
        </tbody>
      </table>
    </div>
  )}
  {tab === 'temps' && (
    <div class="split">
      <div class="tw">
        <table class="t">
          <thead><tr><th>Domaine</th><th>Heures</th><th>Part</th><th>Coût estimé</th></tr></thead>
          <tbody>{DK.map((d) => { const h = byDom.find((x) => x.d === d)?.h ?? 0; return <tr><td><Tags dom={d} /></td><td class="num">{fmt(h)} h</td><td class="num">{Math.round((h / Math.max(1, totH)) * 100)} %</td><td class="num">{mfcfa(h * 7500)}</td></tr>; })}</tbody>
        </table>
      </div>
      <aside><div class="card"><h3>Utilité</h3><p class="small">Le temps passé par domaine et par projet sert à facturer les bailleurs (coûts de personnel éligibles) et à calculer le coût complet de chaque activité.</p></div></aside>
    </div>
  )}
  {tab === 'paie' && (
    <>
      <div class="toolbar">
        <label class="f" for="pm" style="margin:0">Mois</label>
        <select class="in" id="pm" data-go>{Array.from({ length: 12 }, (_, i) => monthAgo(i)).map((m) => <option value={`/admin/rh?t=paie&m=${m}`} selected={m === month}>{m}</option>)}</select>
        {pay
          ? <><button class="btn" type="button" disabled>Paie déjà calculée</button><a class="btn ghost" href={`/api/admin/os/export?quoi=paie&m=${month}`}>Exporter le livre de paie</a></>
          : <button class="btn" type="button" data-post="/api/admin/os/rh" data-body={JSON.stringify({ action: 'payroll.run', month })} data-confirm={`Calculer et valider la paie de ${month} pour ${people.filter((s) => s.active).length} collaborateurs ?`} data-reload>Calculer et valider la paie</button>}
      </div>
      {pay ? (
        <>
          <div class="grid g4">
            <div class="card kpi"><div class="l">Masse salariale brute</div><div class="v num">{mfcfa(sumP('brut'))}</div></div>
            <div class="card kpi"><div class="l">Net versé</div><div class="v num">{mfcfa(sumP('net'))}</div></div>
            <div class="card kpi"><div class="l">Charges patronales</div><div class="v num">{mfcfa(sumP('cp'))}</div></div>
            <div class="card kpi"><div class="l">Bulletins</div><div class="v num">{pay.lines.length}</div></div>
          </div>
          <div class="tw" style="margin-top:12px">
            <table class="t">
              <thead><tr><th>Collaborateur</th><th>Pays</th><th>Brut</th><th>Cotisations</th><th>Impôt</th><th>Net</th><th>Patronal</th></tr></thead>
              <tbody>{pay.lines.map((l) => <tr><td>{name(l.id)}</td><td>{pn(l.country)}</td><td class="num">{fmt(l.brut)}</td><td class="num">{fmt(l.cs)}</td><td class="num">{fmt(l.imp)}</td><td class="num"><b>{fmt(l.net)}</b></td><td class="num">{fmt(l.cp)}</td></tr>)}</tbody>
            </table>
          </div>
        </>
      ) : <div class="empty">Paie non calculée pour {month}. Le calcul applique les taux de la devise du pays de chaque collaborateur, publie les bulletins (visibles dans « Mes bulletins de paie ») et génère l'écriture de paie.</div>}
      <h3 style="margin-top:18px">Taux par devise</h3>
      <div class="tw">
        <table class="t">
          <thead><tr><th>Devise</th><th>Cotisations salariales</th><th>Charges patronales</th><th>Impôt retenu</th><th></th></tr></thead>
          <tbody>{Object.entries(rates).map(([cur, r]) => <tr><td><b>{cur}</b></td><td class="num">{pct(r[0])} %</td><td class="num">{pct(r[1])} %</td><td class="num">{pct(r[2])} %</td><td><button class="btn ghost sm" type="button" data-dlg="dlg-rate" data-set-currency={cur} data-set-cs={String(+(r[0] * 100).toFixed(2))} data-set-cp={String(+(r[1] * 100).toFixed(2))} data-set-imp={String(+(r[2] * 100).toFixed(2))} data-set-label={cur}>Modifier</button></td></tr>)}</tbody>
        </table>
      </div>
      <p class="xs muted" style="margin-top:8px">Taux de démonstration repris du prototype : à remplacer par les barèmes validés dans chaque pays (ou un connecteur de paie locale).</p>
      <Dlg id="dlg-rate" title="Taux de paie" api="/api/admin/os/rh">
        <input type="hidden" name="action" value="payroll.rates" /><input type="hidden" name="currency" value="" />
        <p class="small">Devise <b data-text="label"></b> (en % du brut)</p>
        <div class="fg">
          <div><label class="f" for="rcs">Cotisations salariales</label><input class="in" type="number" step="0.01" id="rcs" name="cs" /></div>
          <div><label class="f" for="rcp">Charges patronales</label><input class="in" type="number" step="0.01" id="rcp" name="cp" /></div>
          <div><label class="f" for="rim">Impôt retenu</label><input class="in" type="number" step="0.01" id="rim" name="imp" /></div>
        </div>
      </Dlg>
    </>
  )}
  {tab === 'rec' && <div class="watch">Le recrutement dispose de son propre module, relié au référentiel des postes. <a href="/admin/recrutement">Ouvrir le recrutement</a></div>}
  {tab === 'ent' && (
    <div class="tw">
      <table class="t">
        <thead><tr><th>Collaborateur</th><th>Responsable</th><th>Dernier entretien</th><th>Compétences (moyenne)</th><th>Statut {year}</th></tr></thead>
        <tbody>{people.filter((s) => s.active && s.prof !== 'dg').map((s) => {
          const i = interviews.find((x) => x.staffId === s.id);
          const avg = i ? i.competences.reduce((a, b) => a + b, 0) / COMPS.length : null;
          return <tr><td>{s.name}</td><td class="small">{name(s.managerId)}</td><td class="small">{i ? dstr(i.at) : '—'}</td><td>{avg !== null ? <><div class="bar" style="max-width:140px"><span style={`width:${(avg / 4) * 100}%`}></span></div><span class="xs">{avg.toFixed(1)}/4</span></> : '—'}</td><td>{i && i.at.getFullYear() === year ? <span class="tag ok">Réalisé</span> : <span class="tag warn">À planifier</span>}</td></tr>;
        })}</tbody>
      </table>
    </div>
  )}
</AdminLayout>
