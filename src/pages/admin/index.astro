---
/* Tableau de bord CEA OS (CDC §11) : files de travail selon les droits, indicateurs clés. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import Money from '../../components/Money.astro';
import { and, eq, gte, sql } from 'drizzle-orm';
import { db } from '../../lib/db';
import { contactMessage, report, post, job, programmeApplication, payment, membership, project } from '../../db/schema/app';
import { user } from '../../db/schema/auth';
import { dossier, kycCheck, investorProfile } from '../../db/schema/kapital';
import { can } from '../../lib/rbac';
import { PIPELINE } from '../../lib/kapital';
import { webVital } from '../../db/schema/ops';

export const prerender = false;
const r = Astro.locals.user!.roles;
const n = async (q: Promise<{ n: number }[]>) => (await q)[0]?.n ?? 0;
const cnt = sql<number>`count(*)::int`;
const since = new Date(Date.now() - 30 * 864e5);

const queues: [string, string, number][] = [];
if (can(r, 'messages_contact', 'L')) queues.push(['Messages de contact à traiter', '/admin/messages', await n(db.select({ n: cnt }).from(contactMessage).where(eq(contactMessage.status, 'nouveau')))]);
if (can(r, 'moderation', 'L')) {
  queues.push(['Signalements ouverts', '/admin/messages?onglet=signalements', await n(db.select({ n: cnt }).from(report).where(eq(report.status, 'nouveau')))]);
  queues.push(['Publications en modération', '/admin/moderation', await n(db.select({ n: cnt }).from(post).where(eq(post.status, 'en_moderation')))]);
}
if (can(r, 'offre_emploi', 'V')) queues.push(["Offres d'emploi à valider", '/admin/emplois', await n(db.select({ n: cnt }).from(job).where(eq(job.status, 'en_moderation')))]);
if (can(r, 'candidature', 'L')) queues.push(['Candidatures reçues', '/admin/candidatures', await n(db.select({ n: cnt }).from(programmeApplication).where(eq(programmeApplication.status, 'recue')))]);
if (can(r, 'fiche_projet', 'L')) queues.push(['Projets soumis', '/admin/projets', await n(db.select({ n: cnt }).from(project).where(eq(project.status, 'soumis')))]);
if (can(r, 'pieces_kyc', 'L')) {
  queues.push(['Contrôles KYC en cours', '/admin/conformite', await n(db.select({ n: cnt }).from(kycCheck).where(eq(kycCheck.status, 'en_cours')))]);
  queues.push(['Investisseurs à vérifier', '/admin/conformite', await n(db.select({ n: cnt }).from(investorProfile).where(eq(investorProfile.kycStatus, 'en_cours')))]);
}
const pipe = can(r, 'dossier_kapital', 'L') ? await db.select({ s: dossier.status, n: cnt }).from(dossier).groupBy(dossier.status) : [];
const members = can(r, 'membres', 'L') ? await n(db.select({ n: cnt }).from(user)) : null;
const newMembers = can(r, 'membres', 'L') ? await n(db.select({ n: cnt }).from(user).where(gte(user.createdAt, since))) : null;
const active = can(r, 'membres', 'L') ? await n(db.select({ n: cnt }).from(membership).where(eq(membership.status, 'active'))) : null;
const revenue = can(r, 'paiements', 'L') ? (await db.select({ s: sql<number>`coalesce(sum(${payment.amountXof}),0)::float` }).from(payment).where(and(eq(payment.status, 'reussi'), gte(payment.paidAt, since))))[0].s : null;
// Graphiques du tableau de bord (prototype) : inscriptions des 6 dernières semaines, revenus par source sur 30 jours
const weeks = members !== null ? await db.select({ w: sql<string>`to_char(date_trunc('week', ${user.createdAt}), 'YYYY-MM-DD')`, n: cnt }).from(user).where(gte(user.createdAt, new Date(Date.now() - 42 * 864e5))).groupBy(sql`1`).orderBy(sql`1`) : [];
const weekBars = Array.from({ length: 6 }, (_, i) => {
  const d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() - ((d.getDay() + 6) % 7) - (5 - i) * 7);
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const wk = Math.ceil(((d.getTime() - new Date(d.getFullYear(), 0, 1).getTime()) / 864e5 + 1) / 7);
  return { l: `S${wk}`, n: weeks.find((x) => x.w === key)?.n ?? 0 };
});
const maxW = Math.max(1, ...weekBars.map((b) => b.n));
const PURPOSE: Record<string, string> = { adhesion: 'Adhésions', cours: 'Formation', programme: 'Programmes', billet: 'Événements', sponsoring: 'Sponsoring', mastermind: 'Mastermind', expert: 'Experts', mise_en_avant: 'Recrutement', recherche: 'Kapital (recherche)' };
const COLORS = ['#082B4C', '#5B8DB8', '#C9962B', '#1E7A4C', '#E7BD62', '#B23A2E', '#7A5A12', '#2B6CB0', '#9DB0C5'];
const bySource = revenue !== null ? await db.select({ p: payment.purpose, s: sql<number>`coalesce(sum(${payment.amountXof}),0)::float` }).from(payment).where(and(eq(payment.status, 'reussi'), gte(payment.paidAt, since))).groupBy(payment.purpose) : [];
const totalSrc = bySource.reduce((a, b) => a + b.s, 0);
let acc = 0;
const arcs = bySource.filter((x) => x.s > 0).map((x, i) => {
  const a0 = (acc / totalSrc) * 2 * Math.PI; acc += x.s; const a1 = (acc / totalSrc) * 2 * Math.PI;
  const P = (a: number, r: number) => `${(60 + r * Math.sin(a)).toFixed(2)} ${(60 - r * Math.cos(a)).toFixed(2)}`;
  const big = a1 - a0 > Math.PI ? 1 : 0;
  const d = a1 - a0 >= 2 * Math.PI - 1e-6 ? 'M 60 10 A 50 50 0 1 1 59.99 10 L 59.99 30 A 30 30 0 1 0 60 30 Z' : `M ${P(a0, 50)} A 50 50 0 ${big} 1 ${P(a1, 50)} L ${P(a1, 30)} A 30 30 0 ${big} 0 ${P(a0, 30)} Z`;
  return { d, c: COLORS[i % COLORS.length], l: PURPOSE[x.p] ?? x.p, pc: Math.round((x.s / totalSrc) * 100) };
});
// Core Web Vitals de terrain (CDC §13.1) : 75e centile sur mobile, 28 derniers jours, comparé aux cibles
const VITALS: Record<string, { target: number; unit: string; fmt: (v: number) => string }> = {
  LCP: { target: 2500, unit: 's', fmt: (v) => `${(v / 1000).toLocaleString('fr-FR', { maximumFractionDigits: 2 })} s` },
  INP: { target: 200, unit: 'ms', fmt: (v) => `${Math.round(v)} ms` },
  CLS: { target: 0.1, unit: '', fmt: (v) => v.toLocaleString('fr-FR', { maximumFractionDigits: 3 }) },
};
const vitals = can(r, 'rapports', 'L') ? await db.select({ m: webVital.metric, p75: sql<number>`percentile_cont(0.75) within group (order by ${webVital.value})::float`, n: cnt }).from(webVital).where(and(eq(webVital.mobile, true), gte(webVital.at, new Date(Date.now() - 28 * 864e5)))).groupBy(webVital.metric).catch(() => []) : null;
const kpis: [string, string, string?][] = [];
if (members !== null) kpis.push(['Membres', members.toLocaleString('fr-FR')], ['Inscrits sur 30 jours', `+${newMembers}`], ['Adhésions actives', String(active)]);
for (const [l, h, v] of queues) kpis.push([l, String(v), h]);
---
<AdminLayout title="Tableau de bord — CEA OS" lead="Vos files de travail selon vos droits. Toutes les actions sont tracées dans le journal d'audit." obj="contenus">
  <div class="grid g4">
    {kpis.map(([l, v, h]) => h
      ? <a class="panel kpi" href={h} style="text-decoration:none"><span class="small muted">{l}</span><b>{v}</b></a>
      : <div class="panel kpi"><span class="small muted">{l}</span><b>{v}</b></div>)}
    {revenue !== null && <div class="panel kpi"><span class="small muted">Revenus du mois</span><b><Money xof={revenue} /></b></div>}
  </div>
  {(members !== null || revenue !== null) && (
    <div class="grid g2" style="margin-top:18px">
      {members !== null && (
        <div class="panel">
          <h3>Inscriptions par semaine</h3>
          <svg viewBox="0 0 300 170" role="img" aria-label={`Inscriptions par semaine : ${weekBars.map((b) => `${b.l} ${b.n}`).join(', ')}`} style="width:100%;height:auto">
            {weekBars.map((b, i) => { const h = (b.n / maxW) * 120; return <><rect x={14 + i * 48} y={140 - h} width="32" height={h} rx="4" fill="#C9962B" /><text x={30 + i * 48} y="158" font-size="10" text-anchor="middle" fill="currentColor" opacity=".7">{b.l}</text><text x={30 + i * 48} y={134 - h} font-size="10" text-anchor="middle" fill="currentColor">{b.n}</text></>; })}
          </svg>
        </div>
      )}
      {revenue !== null && (
        <div class="panel">
          <h3>Revenus par source</h3>
          {arcs.length ? (
            <div class="row" style="gap:18px;align-items:center">
              <svg viewBox="0 0 120 120" width="150" height="150" role="img" aria-label={arcs.map((a) => `${a.l} ${a.pc} %`).join(', ')}>{arcs.map((a) => <path d={a.d} fill={a.c} />)}</svg>
              <div class="small" style="flex:1;min-width:160px">{arcs.map((a) => <div class="row between" style="padding:3px 0"><span class="row" style="gap:6px"><span style={`width:10px;height:10px;border-radius:3px;background:${a.c}`}></span>{a.l}</span><b>{a.pc} %</b></div>)}</div>
            </div>
          ) : <p class="small muted">Aucun paiement encaissé sur les 30 derniers jours.</p>}
        </div>
      )}
    </div>
  )}
  <div class="row" style="margin-top:12px"><a class="btn btn-ghost btn-sm" href="/admin/rapports">Exporter (CSV)</a><a class="btn btn-ghost btn-sm" href="/admin/rapports">Exporter (XLSX)</a></div>
  {vitals !== null && (
    <>
      <h2 style="font-size:1.2rem;margin-top:26px">Performances mesurées chez les visiteurs</h2>
      <p class="small muted" style="margin:0 0 10px">Core Web Vitals, 75e centile sur mobile, 28 derniers jours (un visiteur sur quatre est mesuré, anonymement).</p>
      <div class="grid g3">
        {Object.entries(VITALS).map(([k, t]) => { const v = vitals.find((x) => x.m === k); const good = v ? v.p75 <= t.target : null; return (
          <div class="panel kpi"><span class="small muted">{k} · cible ≤ {t.fmt(t.target)}</span><b style={good === false ? 'color:var(--bad)' : ''}>{v ? t.fmt(v.p75) : '—'}</b><span class="xs muted">{v ? `${v.n.toLocaleString('fr-FR')} mesures${good ? ' · objectif atteint' : ' · objectif non atteint'}` : 'Pas encore de mesure'}</span></div>
        ); })}
      </div>
    </>
  )}
  {pipe.length > 0 && (
    <>
      <h2 style="font-size:1.2rem;margin-top:26px">Pipeline Kapital</h2>
      <div class="panel">{PIPELINE.map((s) => { const v = pipe.find((x) => x.s === s.key)?.n ?? 0; return <div class="list-row"><a class="small" href={`/admin/kapital?statut=${s.key}`}>{s.label}</a><b>{v}</b></div>; })}</div>
    </>
  )}
</AdminLayout>
