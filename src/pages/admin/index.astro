---
/* Back-office du site — tableau de bord : files de travail (messages, modération, offres, candidatures, projets, KYC…),
   raccourcis et indicateurs du site, selon les droits de la matrice. Le progiciel interne (RH, finance, CRM…) est dans CEA OS (/os). */
import AdminLayout from '../../layouts/AdminLayout.astro';
import LegacyBoard from '../../components/os/LegacyBoard.astro';

export const prerender = false;
const me = Astro.locals.user!;
const today = new Date().toLocaleDateString('fr-FR', { timeZone: 'Africa/Lome' });
---
<AdminLayout title={`Bonjour ${me.name.split(' ')[0]}`} lead={`${today} · administration du site et des services en ligne ; toutes les actions sont tracées dans le journal d'audit.`}>
  <LegacyBoard />
</AdminLayout>
