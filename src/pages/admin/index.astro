---
/* CEA OS — Accueil (prototype CEA OS › pHome) : salutation, actions rapides (congé, note de frais, achat, dépense, temps,
   poste), chiffres clés, approbations attendues et demandes en cours. Les équipes sans fiche personnel voient les files
   de travail du site. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import LegacyBoard from '../../components/os/LegacyBoard.astro';
import RequestDialogs from '../../components/os/RequestDialogs.astro';
import Steps from '../../components/os/Steps.astro';
import Tags from '../../components/os/Tags.astro';
import { desc, eq } from 'drizzle-orm';
import { db } from '../../lib/db';
import { osRequest } from '../../db/schema/os';
import { osContext, allStaff, scopeState } from '../../lib/os/core';
import { pendingFor, thresholds, budgets, activeDelegations } from '../../lib/os/approvals';
import { DK, PK, RTYPE, pn, refT, fcfa, type ReqType } from '../../lib/os/ref';

export const prerender = false;
const os = await osContext(Astro.locals.user!);
const me = os.me;
const hour = Number(new Intl.DateTimeFormat('en-GB', { hour: 'numeric', hour12: false, timeZone: 'Africa/Lome' }).format(new Date()));
const first = (me?.name ?? Astro.locals.user!.name).split(' ')[0];
const title = `${hour < 12 ? 'Bonjour' : hour < 18 ? 'Bon après-midi' : 'Bonsoir'} ${first}`;
const today = new Date().toLocaleDateString('fr-FR', { timeZone: 'Africa/Lome' });

let data: null | {
  pend: Awaited<ReturnType<typeof pendingFor>>; mine: (typeof osRequest.$inferSelect)[]; manager: string;
  thr: Awaited<ReturnType<typeof thresholds>>; bud: Awaited<ReturnType<typeof budgets>>; countries: string[]; domains: string[];
} = null;
if (me) {
  const [people, delegs] = await Promise.all([allStaff(), activeDelegations()]);
  const sc = scopeState(os, Astro.cookies);
  const [pend, mine, thr, bud] = await Promise.all([
    pendingFor(me.id, { people, delegs }),
    db.select().from(osRequest).where(eq(osRequest.byStaff, me.id)).orderBy(desc(osRequest.createdAt)),
    thresholds(), budgets(),
  ]);
  data = {
    pend, mine, thr, bud, manager: people.find((s) => s.id === me.managerId)?.name ?? 'votre responsable',
    countries: PK.filter((p) => sc.inScope({ country: p })), domains: DK.filter((d) => sc.inScope({ domain: d })),
  };
}
const canDep = me && ['rep', 'dirreg', 'chef', 'dg', 'agent', 'cond'].includes(me.prof);
---
<AdminLayout title={title} lead={me ? `${refT(me.poste)} · ${pn(me.country)} · ${today}` : `${today} · vos files de travail selon vos droits ; toutes les actions sont tracées dans le journal d'audit.`}>
  {me && data ? (
    <>
      <div class="quick grid" style="margin-bottom:16px">
        <button type="button" data-dlg="dlg-conge">Demander un congé<small>Solde : {me.leaveDays} jours</small></button>
        <button type="button" data-dlg="dlg-ndf">Note de frais<small>Avec photo du justificatif</small></button>
        <button type="button" data-dlg="dlg-achat">Demande d'achat<small>Fournitures, matériel, prestations</small></button>
        {canDep && <button type="button" data-dlg="dlg-dep">Dépense<small>Circuit selon le montant</small></button>}
        <a href="/admin/moi/temps">Saisir mes temps<small>Semaine en cours</small></a>
        <a href="/admin/poste">Mon poste<small>Fiche {me.poste} et indicateurs</small></a>
      </div>
      <div class="grid g4">
        <div class="card kpi"><div class="l">À approuver</div><div class="v num">{data.pend.length}</div>{data.pend.length > 0 && <div class="d down">Vous êtes attendu·e</div>}</div>
        <div class="card kpi"><div class="l">Mes demandes en cours</div><div class="v num">{data.mine.filter((r) => r.status === 'En approbation').length}</div></div>
        <div class="card kpi"><div class="l">Solde de congés</div><div class="v num">{me.leaveDays} j</div></div>
      </div>
      <div class="grid g2" style="margin-top:14px">
        <div class="card">
          <div class="row between"><h2>À approuver</h2><a class="small" href="/admin/approbations">Tout voir</a></div>
          {data.pend.slice(0, 6).map((p) => <div class="small" style="padding:6px 0;border-bottom:1px solid var(--line)">{RTYPE[p.r.type as ReqType]} {p.r.id} — {p.r.title}{p.r.amount > 0 && <> · <b>{fcfa(p.r.amount)}</b></>}</div>)}
          {!data.pend.length && <p class="small muted">Rien en attente.</p>}
        </div>
        <div class="card">
          <div class="row between"><h2>Mes demandes</h2><a class="small" href="/admin/moi">Historique</a></div>
          {data.mine.slice(0, 5).map((r) => (
            <div style="padding:7px 0;border-bottom:1px solid var(--line)">
              <div class="row between small"><b>{RTYPE[r.type as ReqType]} {r.id}</b><Tags st={r.status} /></div>
              <div class="small">{r.title}{r.amount > 0 && ' · ' + fcfa(r.amount)}</div>
              <Steps steps={r.steps} cur={r.cur} status={r.status} />
            </div>
          ))}
          {!data.mine.length && <p class="small muted">Aucune demande.</p>}
        </div>
      </div>
      <RequestDialogs me={me} managerName={data.manager} thr={data.thr} budgets={data.bud} countries={data.countries} domains={data.domains} />
    </>
  ) : (
    <>
      {os.superuser && <div class="watch" style="margin-bottom:14px">Votre compte n'est rattaché à aucune fiche du personnel : demandes, approbations et indicateurs personnels apparaissent dès que les ressources humaines créent votre fiche (Ressources humaines › Effectifs).</div>}
      <LegacyBoard />
    </>
  )}
</AdminLayout>
