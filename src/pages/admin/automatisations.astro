---
/* Workflows et automatisations (CDC §12) : règles « quand … si … alors … », journal des exécutions, relances et escalades des tickets. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { desc, eq } from 'drizzle-orm';
import { db } from '../../lib/db';
import { automation, automationRun } from '../../db/schema/workflows';
import { can, ROLES, ROLE_LABEL } from '../../lib/rbac';
import { EVENTS } from '../../lib/automations';
import { getSetting } from '../../lib/settings';

export const prerender = false;
const me = Astro.locals.user!;
const canV = can(me.roles, 'automatisations', 'V');
const list = await db.select().from(automation).orderBy(desc(automation.createdAt));
const sel = list.find((a) => a.id === Astro.url.searchParams.get('id'));
const runs = sel ? await db.select().from(automationRun).where(eq(automationRun.automationId, sel.id)).orderBy(desc(automationRun.at)).limit(30) : await db.select({ r: automationRun, name: automation.name }).from(automationRun).innerJoin(automation, eq(automation.id, automationRun.automationId)).orderBy(desc(automationRun.at)).limit(20).then((x) => x.map((y) => ({ ...y.r, name: y.name })));
const esc = await getSetting('escalade');
const state = { id: sel?.id ?? null, name: sel?.name ?? '', event: sel?.event ?? 'ticket.cree', conditions: sel?.conditions ?? [], actions: sel?.actions ?? [{ type: 'notifier_role', role: 'admin', message: '' }], active: sel?.active ?? true, events: EVENTS, roles: ROLES.map((r) => [r, ROLE_LABEL[r]]) };
---
<AdminLayout title="Automatisations" lead="Quand un événement survient, si ses données remplissent les conditions, alors les actions s'exécutent. Chaque exécution est journalisée." obj="automatisations">
  <div class="split">
    <div>
      <form class="panel" id="autoF">
        <h3 style="margin-top:0">{sel ? `Modifier « ${sel.name} »` : 'Nouvelle automatisation'}</h3>
        <fieldset disabled={!canV} style="border:0;padding:0;margin:0">
          <div class="grid g2" style="gap:0 12px">
            <div><label class="f" for="an">Nom</label><input class="in" id="an" name="name" required minlength="3" value={state.name} /></div>
            <div><label class="f" for="ae">Quand</label><select class="in" id="ae" name="event">{Object.entries(EVENTS).map(([k, e]) => <option value={k} selected={k === state.event}>{e.label}</option>)}</select></div>
          </div>
          <p class="xs muted" id="fieldsHelp"></p>
          <h4 style="margin:10px 0 4px">Si <span class="xs muted">(toutes les conditions ; aucune = toujours)</span></h4>
          <div id="conds"></div><button class="btn btn-ghost btn-sm" type="button" id="addCond">+ Condition</button>
          <h4 style="margin:12px 0 4px">Alors</h4>
          <div id="acts"></div><button class="btn btn-ghost btn-sm" type="button" id="addAct">+ Action</button>
          <label class="row small" style="margin-top:12px"><input type="checkbox" name="active" checked={state.active} /> Active</label>
        </fieldset>
        {canV && <div class="row" style="gap:6px;margin-top:10px;flex-wrap:wrap"><button class="btn btn-primary btn-sm" type="submit">Enregistrer</button>{sel && <button class="btn btn-ghost btn-sm" type="button" data-post="/api/admin/automatisations" data-body={JSON.stringify({ action: 'test', id: sel.id })} data-reload>Essayer avec des données fictives</button>}{sel && <button class="btn btn-ghost btn-sm" type="button" data-post="/api/admin/automatisations" data-body={JSON.stringify({ action: 'delete', id: sel.id })} data-confirm="Supprimer cette automatisation et son journal ?">Supprimer</button>}{sel && <a class="btn btn-ghost btn-sm" href="/admin/automatisations">Nouvelle</a>}</div>}
        {sel && (sel.actions as { type: string }[]).some((a) => a.type === 'webhook') && <p class="xs muted" style="margin:10px 0 0">Webhook : corps JSON <code>{'{ event, subject, data, at }'}</code>, en-tête <code>X-CEA-Signature: sha256=&lt;HMAC du corps&gt;</code> avec le secret <code>{canV ? sel.secret : '••••'}</code>.</p>}
      </form>
      <div class="panel" style="margin-top:14px">
        <h3 style="margin-top:0">Relances et escalades des tickets</h3>
        <p class="small" style="margin:0">Chaque jour, le responsable d'un ticket est relancé <b>{esc.remindHours} h</b> avant l'échéance ; un ticket en retard depuis <b>{esc.escalateHours} h</b> est escaladé : priorité relevée, rôle « {ROLE_LABEL[esc.role as keyof typeof ROLE_LABEL] ?? esc.role} » prévenu{esc.email ? `, copie à ${esc.email}` : ''}.</p>
        {can(me.roles, 'parametres', 'M') && <form class="row" id="escF" style="gap:6px;flex-wrap:wrap;margin-top:8px;align-items:flex-end">
          <div><label class="f" for="er">Relance (heures avant)</label><input class="in" id="er" name="remindHours" type="number" min="1" max="168" value={esc.remindHours} style="width:110px" /></div>
          <div><label class="f" for="ee">Escalade (heures après)</label><input class="in" id="ee" name="escalateHours" type="number" min="0" max="720" value={esc.escalateHours} style="width:110px" /></div>
          <div><label class="f" for="eo">Rôle prévenu</label><select class="in" id="eo" name="role" style="width:auto">{['admin', 'direction', 'responsable_pays', 'charge_programme', 'editeur'].map((r) => <option value={r} selected={r === esc.role}>{ROLE_LABEL[r as keyof typeof ROLE_LABEL]}</option>)}</select></div>
          <div><label class="f" for="em">Copie à (facultatif)</label><input class="in" id="em" name="email" type="email" value={esc.email} /></div>
          <button class="btn btn-ghost btn-sm" type="submit">Enregistrer</button>
        </form>}
      </div>
    </div>
    <aside>
      <div class="panel">
        <h3>Automatisations</h3>
        {list.length === 0 && <p class="small muted" style="margin:0">Aucune.</p>}
        {list.map((a) => <div class="list-row"><a class="small" href={`?id=${a.id}`}><b>{a.name}</b></a><span class={`tag ${a.active ? 'ok' : ''}`}>{a.active ? 'active' : 'inactive'}</span></div>)}
      </div>
      <div class="panel" style="margin-top:14px">
        <h3>Journal {sel ? '' : '(toutes)'}</h3>
        {runs.length === 0 && <p class="small muted" style="margin:0">Aucune exécution.</p>}
        {runs.map((r) => <div style="border-top:1px solid var(--line);padding:4px 0" class="xs"><span class={`tag ${r.ok ? 'ok' : 'bad'}`}>{r.ok ? 'ok' : 'échec'}</span> {r.at.toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })}{'name' in r ? ` · ${r.name}` : ''}{r.subject ? ` · ${r.subject}` : ''}<div class="muted">{r.detail}</div></div>)}
      </div>
    </aside>
  </div>
  <script type="application/json" id="autoState" set:html={JSON.stringify(state)} />
</AdminLayout>
<script>
  type C = { field: string; op: string; value: string };
  type A = { type: string; [k: string]: string };
  const S = JSON.parse(document.getElementById('autoState')!.textContent!) as { id: string | null; conditions: C[]; actions: A[]; events: Record<string, { label: string; fields: string[] }>; roles: [string, string][] };
  const form = document.getElementById('autoF') as HTMLFormElement;
  const ro = form.querySelector('fieldset')!.disabled;
  const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const toast = (t: string) => (window as unknown as { toast: (t: string) => void }).toast(t);
  const OPS = [['egal', 'vaut'], ['different', 'ne vaut pas'], ['contient', 'contient'], ['existe', 'est renseigné'], ['superieur', 'est supérieur à']];
  const TYPES = [['notifier_role', 'Notifier un rôle'], ['email', 'Envoyer un e-mail'], ['assigner', 'Assigner le ticket'], ['priorite', 'Changer la priorité du ticket'], ['webhook', 'Appeler un webhook (Zapier, Make…)']];
  const sel = (list: string[][], cur: string, attrs: string) => `<select class="in" ${attrs} style="width:auto">${list.map(([v, l]) => `<option value="${v}"${v === cur ? ' selected' : ''}>${l}</option>`).join('')}</select>`;
  const inp = (attrs: string, v: string, ph: string, w = '180px') => `<input class="in" ${attrs} value="${esc(v)}" placeholder="${ph}" style="width:${w}" />`;
  function render() {
    const ev = (form.elements.namedItem('event') as HTMLSelectElement).value;
    document.getElementById('fieldsHelp')!.textContent = `Champs disponibles : ${S.events[ev].fields.join(', ')}`;
    document.getElementById('conds')!.innerHTML = S.conditions.map((c, i) => `<div class="row" style="gap:6px;margin-bottom:6px;flex-wrap:wrap">${inp(`data-c="${i}" data-k="field" list="flds"`, c.field, 'champ')}${sel(OPS, c.op, `data-c="${i}" data-k="op"`)}${c.op === 'existe' ? '' : inp(`data-c="${i}" data-k="value"`, c.value, 'valeur')}${ro ? '' : `<button class="btn btn-ghost btn-sm" type="button" data-cdel="${i}" aria-label="Supprimer">✕</button>`}</div>`).join('') + `<datalist id="flds">${S.events[ev].fields.map((f) => `<option value="${f.replace('<champ>', '')}">`).join('')}</datalist>`;
    document.getElementById('acts')!.innerHTML = S.actions.map((a, i) => {
      const t = sel(TYPES, a.type, `data-a="${i}" data-k="type"`);
      const extra = a.type === 'notifier_role' ? sel(S.roles, a.role ?? 'admin', `data-a="${i}" data-k="role"`) + inp(`data-a="${i}" data-k="message"`, a.message ?? '', 'message (facultatif)', '220px')
        : a.type === 'email' ? inp(`data-a="${i}" data-k="to" type="email"`, a.to ?? '', 'destinataire@…', '220px') + inp(`data-a="${i}" data-k="subject"`, a.subject ?? '', 'objet (facultatif)')
        : a.type === 'assigner' ? inp(`data-a="${i}" data-k="email" type="email"`, a.email ?? '', 'e-mail du responsable', '220px')
        : a.type === 'priorite' ? sel([['basse', 'basse'], ['normale', 'normale'], ['haute', 'haute'], ['urgente', 'urgente']], a.value ?? 'haute', `data-a="${i}" data-k="value"`)
        : inp(`data-a="${i}" data-k="url" type="url"`, a.url ?? '', 'https://hooks.zapier.com/…', '320px');
      return `<div class="row" style="gap:6px;margin-bottom:6px;flex-wrap:wrap">${t}${extra}${ro ? '' : `<button class="btn btn-ghost btn-sm" type="button" data-adel="${i}" aria-label="Supprimer">✕</button>`}</div>`;
    }).join('');
    if (ro) form.querySelectorAll('#conds input, #conds select, #acts input, #acts select').forEach((x) => ((x as HTMLInputElement).disabled = true));
  }
  render();
  form.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name === 'event') return render();
    if (el.dataset.c !== undefined) { (S.conditions[Number(el.dataset.c)] as Record<string, string>)[el.dataset.k!] = el.value; if (el.dataset.k === 'op') render(); }
    if (el.dataset.a !== undefined) { const a = S.actions[Number(el.dataset.a)]; if (el.dataset.k === 'type') { S.actions[Number(el.dataset.a)] = { type: el.value } as A; render(); } else a[el.dataset.k!] = el.value; }
  });
  form.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    if (b.id === 'addCond') S.conditions.push({ field: '', op: 'egal', value: '' });
    else if (b.id === 'addAct') S.actions.push({ type: 'notifier_role', role: 'admin', message: '' });
    else if (b.dataset.cdel) S.conditions.splice(Number(b.dataset.cdel), 1);
    else if (b.dataset.adel) S.actions.splice(Number(b.dataset.adel), 1);
    else return;
    render();
  });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const actions = S.actions.map((a) => a.type === 'notifier_role' ? { type: a.type, role: a.role ?? 'admin', message: a.message ?? '' } : a.type === 'priorite' ? { type: a.type, value: a.value ?? 'haute' } : a);
    const r = await fetch('/api/admin/automatisations', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'save', id: S.id ?? undefined, name: fd.get('name'), event: fd.get('event'), conditions: S.conditions.filter((c) => c.field), actions, active: fd.get('active') === 'on' }) }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : { error: 'Erreur réseau.' };
    toast(d.message ?? d.error ?? 'Erreur.');
    if (d.ok && d.redirect) setTimeout(() => (location.href = d.redirect), 500);
  });
  document.getElementById('escF')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target as HTMLFormElement);
    const r = await fetch('/api/admin/parametrage', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'setting.save', key: 'escalade', value: { remindHours: Number(fd.get('remindHours')), escalateHours: Number(fd.get('escalateHours')), role: fd.get('role'), email: String(fd.get('email') ?? '') } }) }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : { error: 'Erreur réseau.' };
    toast(d.message ?? d.error ?? 'Erreur.');
    if (d.ok) setTimeout(() => location.reload(), 500);
  });
</script>
