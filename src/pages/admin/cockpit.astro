---
/* CEA OS — Cockpit (prototype › pCockpit), managers : chiffres clés du périmètre, encaissements et budgets par domaine,
   points d'attention, registre des décisions ; files de travail du site en dessous. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import LegacyBoard from '../../components/os/LegacyBoard.astro';
import Bars from '../../components/os/Bars.astro';
import Tags from '../../components/os/Tags.astro';
import { and, desc, eq, inArray, notInArray, sql, type Column } from 'drizzle-orm';
import { db } from '../../lib/db';
import { invoice } from '../../db/schema/finance';
import { payment, membership, profile } from '../../db/schema/app';
import { dossier } from '../../db/schema/kapital';
import { osDecision, osTask, osContract, osStockItem, osInscription, osSite, osSiteLot } from '../../db/schema/os';
import { marge } from '../../lib/os/domaines';
import { osContext, allStaff, scopeState, scopeCountries } from '../../lib/os/core';
import { pendingFor, budgets } from '../../lib/os/approvals';
import { allOkrs, okrProg } from '../../lib/os/pilotage';
import { isStaff } from '../../lib/rbac';
import { DK, DOM, fmt, mfcfa, dstr, type Dom } from '../../lib/os/ref';

export const prerender = false;
const os = await osContext(Astro.locals.user!);
const sc = scopeState(os, Astro.cookies);
// Périmètre appliqué à tous les chiffres : pays de la facture, du membre, du dossier, de la tâche ou du chantier
const cs = scopeCountries(sc);
const inC = (col: Column) => (cs ? inArray(col, cs) : undefined);
const people = await allStaff();
const year = new Date().getFullYear();
const today = new Date().toISOString().slice(0, 10);
const n = sql<number>`coalesce(sum(${invoice.totalXof}),0)::float`;
const [[enc], [due], late, bud, [mem], [kap], decisions, lateTasks, pend] = await Promise.all([
  db.select({ s: n }).from(invoice).where(and(eq(invoice.kind, 'facture'), eq(invoice.status, 'payee'), eq(invoice.year, year), inC(invoice.country))),
  db.select({ s: n }).from(invoice).where(and(eq(invoice.kind, 'facture'), eq(invoice.status, 'a_payer'), inC(invoice.country))),
  db.select({ number: invoice.number, total: invoice.totalXof }).from(invoice).where(and(eq(invoice.kind, 'facture'), eq(invoice.status, 'a_payer'), sql`${invoice.dueOn} < ${today}`, inC(invoice.country))),
  budgets(year),
  db.select({ n: sql<number>`count(*)::int` }).from(membership).leftJoin(profile, eq(profile.userId, membership.userId)).where(and(eq(membership.status, 'active'), inC(profile.country))),
  db.select({ n: sql<number>`count(*)::int` }).from(dossier).where(and(notInArray(dossier.status, ['finance', 'cloture']), inC(dossier.country))),
  db.select().from(osDecision).orderBy(desc(osDecision.at)).limit(6),
  db.select({ n: sql<number>`count(*)::int` }).from(osTask).where(and(sql`${osTask.due} < now()`, sql`${osTask.status} <> 'Terminé'`, inC(osTask.country))),
  os.me ? pendingFor(os.me.id, { people }) : Promise.resolve([]),
]);
const okrs = await allOkrs();
const roots = okrs.filter((o) => !o.parentId);
const decPending = os.me?.prof === 'dg' ? decisions.filter((d) => d.status === 'En attente').length : 0;
const ds = DK.filter((d) => sc.inScope({ domain: d }));
const eng = ds.reduce((a, d) => a + (bud[d]?.engaged ?? 0), 0), bt = ds.reduce((a, d) => a + (bud[d]?.budget ?? 0), 0);
const lateSum = late.reduce((a, x) => a + x.total, 0);
// Encaissements par domaine : objet du paiement rattaché au domaine d'intervention
const PURPOSE_DOM: Record<string, Dom> = { adhesion: 'voix', billet: 'evt', cours: 'aca', programme: 'aca', mastermind: 'mm', expert: 'prj', mise_en_avant: 'tal', recherche: 'kap', sponsoring: 'evt' };
const byPurpose = await db.select({ p: payment.purpose, s: sql<number>`coalesce(sum(${payment.amountXof}),0)::float` }).from(payment).leftJoin(profile, eq(profile.userId, payment.userId)).where(and(eq(payment.status, 'reussi'), sql`extract(year from ${payment.paidAt}) = ${year}`, inC(profile.country))).groupBy(payment.purpose);
const byDom = ds.map((d) => byPurpose.filter((x) => PURPOSE_DOM[x.p] === d).reduce((a, x) => a + x.s, 0));
const insAll = (await db.select({ c: osInscription.country, d: osInscription.domains, st: osInscription.status, f: osInscription.slaFrom }).from(osInscription)).filter((x) => sc.inScope({ country: x.c, domain: x.d }));
const insV = insAll.filter((x) => x.st === 'Validée').length, insP = insAll.filter((x) => x.st === 'En attente').length;
const insLate = insAll.filter((x) => x.st === 'En attente' && Date.now() - x.f.getTime() > 48 * 36e5).length;
const staffN = people.filter((s) => s.active && sc.inScope({ country: s.country })).length;
// Chantiers BTP : facturé (situations), marges à terminaison
const [sites, sLots] = await Promise.all([db.select().from(osSite), db.select().from(osSiteLot)]);
const sitesV = sites.filter((x) => sc.inScope({ country: x.country })).map((x) => ({ x, m: marge(x.amount, sLots.filter((l) => l.siteId === x.id)) }));
const btpCa = Number(((await db.execute(sql`select coalesce(sum(st.amount),0)::float s from os_site_statement st join os_site si on si.id = st.site_id where ${cs ? sql`si.country in (${sql.join(cs.map((c) => sql`${c}`), sql`, `)})` : sql`true`}`)).rows[0] as { s: number }).s);
const [expiring, lowStock] = await Promise.all([
  db.select({ title: osContract.title, country: osContract.country, domain: osContract.domain }).from(osContract).where(sql`${osContract.status} = 'En vigueur' and ${osContract.end} < now() + interval '60 days'`),
  db.select({ label: osStockItem.label, country: osStockItem.country }).from(osStockItem).where(sql`${osStockItem.qty} < ${osStockItem.min}`),
]).then(([e, st]) => [e.filter((k) => sc.inScope(k)), st.filter((k) => sc.inScope(k))] as const);
const attention = [
  late.length ? `${late.length} facture(s) en retard : ${mfcfa(lateSum)}` : null,
  ...ds.filter((d) => bud[d] && bud[d].budget && bud[d].engaged / bud[d].budget > 0.9).map((d) => `Budget presque consommé : ${DOM[d].n}`),
  insLate ? `${insLate} inscription(s) au-delà de 48 h` : null,
  ...sitesV.filter((y) => y.m.pct < 8).map((y) => `Marge faible : ${y.x.name}`),
  lateTasks[0].n ? `${lateTasks[0].n} tâche(s) en retard` : null,
  pend.length > 5 ? `${pend.length} approbations vous attendent` : null,
  ...expiring.map((k) => `Contrat bientôt échu : ${k.title}`),
  ...lowStock.map((x) => `Stock bas : ${x.label}`),
].filter(Boolean).slice(0, 7) as string[];
---
<AdminLayout title="Cockpit" lead={`${sc.label} · temps réel`}>
  <Fragment slot="actions">
    <button class="btn ghost" type="button" data-ai-task="semaine" data-ai-title="Synthèse de la semaine">Synthèse de la semaine</button>
    {os.me && <a class="btn" href="/admin/approbations">{pend.length + decPending} à approuver</a>}
  </Fragment>
  <div class="grid g4">
    <div class="card kpi"><div class="l">Encaissements</div><div class="v num">{mfcfa(enc.s)}</div><div class="d">Factures soldées en {year}</div></div>
    <div class="card kpi"><div class="l">Restant à encaisser</div><div class="v num">{mfcfa(due.s)}</div><div class:list={['d', { down: late.length > 0 }]}>{late.length} facture(s) en retard</div></div>
    <div class="card kpi"><div class="l">Budget engagé</div><div class="v num">{bt ? Math.round((eng / bt) * 100) : 0} %</div><div class="d">{mfcfa(eng)} sur {mfcfa(bt)}</div></div>
    <div class="card kpi"><div class="l">Membres validés</div><div class="v num">{fmt(insV)}</div><div class:list={['d', { down: insP > 0 }]}>{insP} inscription(s) en attente · {fmt(mem.n)} adhésion(s) actives</div></div>
    <div class="card kpi"><div class="l">Dossiers Kapital actifs</div><div class="v num">{kap.n}</div></div>
    <div class="card kpi"><div class="l">BTP facturé</div><div class="v num">{mfcfa(btpCa)}</div><div class="d">{sitesV.length} chantier(s)</div></div>
    <div class="card kpi"><div class="l">Effectif</div><div class="v num">{staffN}</div><div class="d">collaborateurs</div></div>
  </div>
  <div class="grid g2" style="margin-top:14px">
    <div class="card"><h2>Encaissements par domaine</h2><Bars title="Encaissements par domaine" horizontal labels={ds.map((d) => DOM[d].n.replace('CEA ', ''))} series={[{ label: 'Encaissé', color: '#C9962B', values: byDom }]} colors={ds.map((d) => DOM[d].c)} /></div>
    <div class="card"><h2>Budget engagé par domaine</h2><Bars title="Budget par domaine" labels={ds.map((d) => DOM[d].n.replace('CEA ', ''))} series={[{ label: 'Budget', color: '#B7C6D8', values: ds.map((d) => bud[d]?.budget ?? 0) }, { label: 'Engagé', color: '#C9962B', values: ds.map((d) => bud[d]?.engaged ?? 0) }, { label: 'Réalisé', color: '#082B4C', values: ds.map((d) => bud[d]?.realised ?? 0) }]} /></div>
  </div>
  <div class="grid g3" style="margin-top:14px">
    <div class="card"><h2>Objectifs {year}</h2>{roots.map((o) => { const p = okrProg(o, okrs); return <div style="margin:8px 0"><div class="row between small"><span>{o.title}</span><b>{p} %</b></div><div class:list={['bar', { warn: p < 40 }]}><span style={`width:${p}%`}></span></div></div>; })}{!roots.length && <p class="small muted">Aucun objectif fixé : <a href="/admin/okr">Objectifs (OKR)</a>.</p>}</div>
    <div class="card"><h2>Points d'attention</h2>{attention.map((t) => <div class="watch" style="margin-bottom:8px">{t}</div>)}{!attention.length && <div class="empty">Rien d'urgent.</div>}</div>
    <div class="card">
      <h2>Décisions</h2>
      <ul class="timeline">{decisions.map((d) => <li><i></i><div class="small"><b>{d.text}</b><br /><span class="muted">{dstr(d.at)}</span> <Tags st={d.status === 'Décidé' ? 'Validée' : d.status === 'Refusé' ? 'Rejetée' : 'En attente'} label={d.status} /></div></li>)}</ul>
      {!decisions.length && <p class="small muted">Aucune décision enregistrée : elles viennent des comptes rendus de réunion.</p>}
    </div>
  </div>
  {isStaff(Astro.locals.user!.roles) && <><h2 style="margin-top:22px">Files de travail du site</h2><LegacyBoard /></>}
</AdminLayout>
