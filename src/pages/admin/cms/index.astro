---
/* CMS éditorial (CDC §12) : contenus par état du circuit, création, import des articles écrits dans le code. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { desc, eq } from 'drizzle-orm';
import { db } from '../../../lib/db';
import { cmsContent } from '../../../db/schema/app';
import { user } from '../../../db/schema/auth';
import { can } from '../../../lib/rbac';
import { STATUS_LABEL, STATUS_TONE, isLive, type CmsStatus } from '../../../lib/cms';
import { ARTICLES, dateFr } from '../../../data/site';

export const prerender = false;
const me = Astro.locals.user!;
const canCreate = can(me.roles, 'contenus', 'C');
const st = Astro.url.searchParams.get('etat') as CmsStatus | null;
const rows = await db.select({ c: cmsContent, who: user.name }).from(cmsContent).leftJoin(user, eq(user.id, cmsContent.updatedBy))
  .where(st && st in STATUS_LABEL ? eq(cmsContent.status, st) : undefined).orderBy(desc(cmsContent.updatedAt)).limit(300);
const counts = await db.select({ s: cmsContent.status, key: cmsContent.key, lang: cmsContent.lang, slug: cmsContent.slug }).from(cmsContent);
const n = (s: CmsStatus) => counts.filter((x) => x.s === s).length;
const imported = new Set(counts.filter((x) => x.lang === 'fr').map((x) => x.slug));
const toImport = ARTICLES.filter((a) => !imported.has(a.id));
// Langues disponibles par contenu (clé commune)
const langs = (key: string) => counts.filter((x) => x.key === key).map((x) => x.lang.toUpperCase()).sort().join(' · ');
const toReview = n('en_relecture');
---
<AdminLayout title="CMS éditorial" lead="Rédaction → relecture → validation → publication (immédiate ou programmée). Chaque enregistrement est historisé et restaurable." obj="contenus">
  <div class="row between" style="flex-wrap:wrap;gap:10px;margin-bottom:12px">
    <div class="filters" style="margin:0">
      <a class="chip" href="/admin/cms" aria-pressed={!st ? 'true' : 'false'}>Tous ({counts.length})</a>
      {(Object.keys(STATUS_LABEL) as CmsStatus[]).map((s) => <a class="chip" href={`?etat=${s}`} aria-pressed={st === s ? 'true' : 'false'}>{STATUS_LABEL[s]} ({n(s)})</a>)}
    </div>
    <a class="btn btn-ghost btn-sm" href="/admin/cms/medias">Médiathèque</a>
  </div>
  {toReview > 0 && can(me.roles, 'contenus', 'V') && <p class="small"><span class="tag info">{toReview} en relecture</span> Des contenus attendent votre validation.</p>}

  {canCreate && (
    <form class="panel row" data-api="/api/admin/cms" style="gap:8px;flex-wrap:wrap;align-items:flex-end;margin-bottom:16px">
      <input type="hidden" name="action" value="create" />
      <div style="flex:1;min-width:220px"><label class="f" for="nt">Nouvel article</label><input class="in" id="nt" name="title" required minlength="2" maxlength="200" placeholder="Titre de l'article" /></div>
      <div><label class="f" for="nl">Langue</label><select class="in" id="nl" name="lang"><option value="fr">Français</option><option value="en">Anglais</option></select></div>
      <button class="btn btn-primary btn-sm" type="submit">Créer le brouillon</button>
    </form>
  )}

  <div class="panel scroll-x">
    {rows.length === 0 ? <p class="small muted" style="margin:0">Aucun contenu{st ? ' dans cet état' : ''}.</p> : (
      <table class="t">
        <thead><tr><th>Titre</th><th>Langues</th><th>État</th><th>Dernière modification</th></tr></thead>
        <tbody>{rows.map(({ c, who }) => (
          <tr>
            <td><a href={`/admin/cms/${c.id}`}><b>{c.title}</b></a><div class="xs muted">/{c.lang === 'en' ? 'en/' : ''}ressources/article/{c.slug}{c.category ? ` · ${c.category}` : ''}</div></td>
            <td class="small">{c.lang.toUpperCase()}<span class="xs muted">{langs(c.key).length > 2 ? ` (${langs(c.key)})` : ''}</span></td>
            <td><span class={`tag ${STATUS_TONE[c.status]}`}>{STATUS_LABEL[c.status]}</span>{c.status === 'programme' && c.publishAt && <div class="xs muted">{isLive(c) ? 'en ligne depuis' : 'le'} {c.publishAt.toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })}</div>}</td>
            <td class="small">{c.updatedAt.toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })}<div class="xs muted">{who ?? '—'} · v{c.version}</div></td>
          </tr>
        ))}</tbody>
      </table>
    )}
  </div>

  {canCreate && toImport.length > 0 && (
    <details class="panel" style="margin-top:16px">
      <summary><b>Articles du site à reprendre dans le CMS ({toImport.length})</b></summary>
      <p class="xs muted">Ces articles sont écrits dans le code. Importez-en un pour le modifier ici : la version du CMS le remplacera sur le site dès sa publication.</p>
      {toImport.map((a) => (
        <div class="list-row"><span class="small">{a.t} <span class="xs muted">· {a.cat} · {dateFr(a.d)}</span></span>
          <button class="btn btn-ghost btn-sm" type="button" data-post="/api/admin/cms" data-body={JSON.stringify({ action: 'import', articleId: a.id })}>Importer</button></div>
      ))}
    </details>
  )}
</AdminLayout>
