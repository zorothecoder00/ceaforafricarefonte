---
/* Administration système (textes et images du site) : un bouton par rubrique de la navigation ; la rubrique choisie affiche ses pages
   (ouverture en mode édition) et leurs modifications. Réseaux sociaux et liste complète des modifications ont aussi leur bouton. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { desc, eq } from 'drizzle-orm';
import { db } from '../../lib/db';
import { siteText, user } from '../../db/schema/index';
import { MEGA, SOCIAL } from '../../data/nav';
import { SUBS } from '../../data/site';
import { canEditSite, KIND_LABEL, SITE } from '../../lib/site-text';
import { getSetting } from '../../lib/settings';

export const prerender = false;
const me = Astro.locals.user!;
const canEdit = canEditSite(me);
const q = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase();
const pageFilter = Astro.url.searchParams.get('page') ?? '';

// Rubriques de la navigation (un bouton chacune) : accueil, méga-menu (rubriques et sous-rubriques), sous-navigations, pied de page
const clean = (h: string) => h.split(/[?#]/)[0].replace(/\/$/, '') || '/';
const seen = new Set<string>();
const take = (links: [string, string][]) => links.map(([h, t]) => [clean(h), t] as [string, string]).filter(([h]) => !/^\/(espace|admin)\b/.test(h) && !seen.has(h) && seen.add(h));
const groups: { k: string; h: string; links: [string, string][] }[] = [
  { k: 'accueil', h: 'Accueil', links: take([['/', 'Page d’accueil'], ['/commencer', 'Par où commencer ?'], ['/connexion', 'Connexion'], ['/inscription', 'Inscription']]) },
  ...MEGA.map((m) => ({ k: m.k, h: m.label.fr, links: take([[m.href, m.label.fr], ...m.cols.flatMap((c) => c.items.map((i) => [i.href, i.t.fr] as [string, string])), ...(SUBS[m.k] ?? [])]) })),
  { k: 'projets', h: 'Projets et Voix', links: take([...SUBS.projets, ...SUBS.voix, ...SUBS.actionnariat]) },
  { k: 'kapital', h: 'CEA Kapital Invest', links: take([['/kapital', 'Accueil Kapital'], ['/kapital/opportunites', 'Opportunités'], ['/kapital/marches', 'Bourses africaines'], ['/kapital/capital-risque', 'Capital-risque'], ['/kapital/obligations', 'Marché des capitaux'], ['/kapital/risques', 'Risques'], ['/kapital/diagnostic', 'Diagnostic'], ['/kapital/devenir-investisseur', 'Devenir investisseur']]) },
  { k: 'infos', h: 'Pied de page et informations', links: take([['/domaines/btp', 'BTP & Infrastructures'], ['/monde', 'Vue sur le monde'], ['/representants', 'Représentants pays'], ['/legal/mentions-legales', 'Mentions légales'], ['/legal/confidentialite', 'Confidentialité'], ['/legal/cookies', 'Cookies'], ['/legal/conditions', 'Conditions d’utilisation'], ['/legal/code-de-conduite', 'Code de conduite'], ['/legal/charte-de-moderation', 'Charte de modération'], ['/legal/reclamations', 'Procédure de réclamation'], ['/legal/accessibilite', 'Accessibilité'], ['/aide', 'Centre d’aide'], ['/statut', 'Statut de la plateforme'], ['/plan-du-site', 'Plan du site']]) },
].filter((g) => g.links.length);
const editUrl = (h: string, en = false) => (en ? (h === '/' ? '/en/' : '/en' + h) : h) + '?edition=1';

const links = await getSetting('reseaux');
const rows = await db.select({ t: siteText, by: user.name }).from(siteText).leftJoin(user, eq(user.id, siteText.updatedBy)).orderBy(desc(siteText.updatedAt)).catch(() => []);
const where = (s: string) => (s === SITE ? 'Tout le site' : s);
const fmt = (d: Date) => d.toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'Africa/Lome' });

// Rubrique choisie (?vue=…) : rien n'est affiché tant qu'aucun bouton n'est choisi
const vue = Astro.url.searchParams.get('vue') ?? '';
const group = groups.find((g) => g.k === vue);
// Une modification appartient à une rubrique si elle porte sur l'une de ses pages (français ou version /en)
const inGroup = (g: (typeof groups)[number], scope: string) => g.links.some(([h]) => scope === h || scope === (h === '/' ? '/en' : '/en' + h));
const count = (g: (typeof groups)[number]) => rows.filter(({ t }) => inGroup(g, t.scope)).length;
const scopes = [...new Set(rows.map((r) => r.t.scope))].sort();
const shown = group
  ? rows.filter(({ t }) => inGroup(group, t.scope))
  : vue === 'modifs' ? rows.filter(({ t }) => (!pageFilter || t.scope === pageFilter) && (!q || t.original.toLowerCase().includes(q) || t.value.toLowerCase().includes(q))) : [];
const tab = (k: string) => ({ class: `btn btn-sm ${vue === k ? 'btn-primary' : 'btn-ghost'}`, href: `?vue=${k}`, 'aria-current': vue === k ? ('page' as const) : undefined });
---
<AdminLayout title="Administration système" lead="Tous les textes, titres, chiffres, liens et images des pages publiques se modifient directement sur la page, en mode édition. Choisissez une rubrique pour voir ses pages. Chaque modification est inscrite au journal d'audit et peut être annulée." obj="contenus">
  {!canEdit && <div class="panel small" style="margin-bottom:16px;border-left:4px solid var(--gold)">Consultation seule : la modification des textes du site est réservée aux éditeurs et administrateurs, avec la double authentification active.</div>}

  <nav class="row" aria-label="Rubriques du site" style="gap:8px;margin-bottom:18px">
    {groups.map((g) => { const n = count(g); return <a {...tab(g.k)}>{g.h}{n > 0 && <span class="xs" style="opacity:.75"> ({n})</span>}</a>; })}
    <a {...tab('reseaux')}>Réseaux sociaux</a>
    <a {...tab('modifs')}>Toutes les modifications <span class="xs" style="opacity:.75">({rows.length})</span></a>
  </nav>

  {!vue && <div class="empty">Choisissez une rubrique ci-dessus pour afficher ses pages, ses textes et ses images.</div>}

  {group && (
    <section class="panel" style="margin-bottom:18px">
      <h2 style="font-size:1.15rem;margin-top:0">{group.h}</h2>
      <p class="small muted" style="margin-top:0">La page s'ouvre dans un nouvel onglet avec une barre d'édition en bas de l'écran. Cliquez sur un texte, un chiffre, un lien ou une image, modifiez-le, puis choisissez s'il change <b>sur cette page</b> ou <b>partout sur le site</b> (en-tête, pied de page, texte répété). Le mode « Naviguer » permet d'ouvrir les menus et de passer d'une page à l'autre sans quitter l'édition. La version anglaise (EN) se modifie séparément.</p>
      <ul style="list-style:none;margin:0;padding:0">
        {group.links.map(([h, t]) => (
          <li class="row between small" style="padding:8px 0;border-bottom:1px solid var(--line, #E3E8EF);gap:8px">
            <span style="min-width:0">{t}<span class="xs muted" style="display:block">{h}</span></span>
            {canEdit ? <span class="row" style="gap:4px;flex:none"><a class="btn btn-primary btn-sm" href={editUrl(h)} target="_blank" rel="noopener">Modifier</a><a class="btn btn-ghost btn-sm" href={editUrl(h, true)} target="_blank" rel="noopener" title="Version anglaise">EN</a></span> : <a class="btn btn-ghost btn-sm" href={h} target="_blank" rel="noopener">Voir</a>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {vue === 'reseaux' && <section class="panel" style="margin-bottom:18px">
    <h2 style="font-size:1.15rem;margin-top:0">Réseaux sociaux</h2>
    <p class="small muted" style="margin-top:0">Les icônes apparaissent dans le pied de page de toutes les pages dès que l'adresse est renseignée (adresse complète commençant par https://). Pour WhatsApp : https://wa.me/228XXXXXXXX.</p>
    <form data-api="/api/admin/textes" data-reload>
      <input type="hidden" name="action" value="reseaux" />
      <fieldset disabled={!canEdit} style="border:0;padding:0;margin:0">
        <div class="grid g2" style="gap:0 12px">
          {SOCIAL.map((s) => <div><label class="f" for={`rs-${s.k}`}>{s.n}</label><input class="in" id={`rs-${s.k}`} name={s.k} type="url" placeholder="https://" value={links[s.k]} /></div>)}
        </div>
        {canEdit && <button class="btn btn-primary btn-sm" type="submit" style="margin-top:10px">Enregistrer</button>}
      </fieldset>
    </form>
  </section>}

  {(group || vue === 'modifs') && <section>
    <h2 style="font-size:1.15rem">{group ? `Modifications déjà faites dans « ${group.h} »` : 'Toutes les modifications enregistrées'} <span class="xs muted">({shown.length})</span></h2>
    {vue === 'modifs' && <form class="row" method="get" style="gap:8px;margin-bottom:12px;flex-wrap:wrap">
      <input type="hidden" name="vue" value="modifs" />
      <input class="in" name="q" value={q} placeholder="Rechercher un texte" aria-label="Rechercher un texte" style="max-width:280px" />
      <select class="in" name="page" aria-label="Page" style="max-width:260px">
        <option value="">Toutes les pages</option>
        {scopes.map((s) => <option value={s} selected={s === pageFilter}>{where(s)}</option>)}
      </select>
      <button class="btn btn-ghost btn-sm" type="submit">Filtrer</button>
    </form>}
    {shown.length === 0 && <div class="empty">{group ? 'Aucune modification sur ces pages pour l’instant : elles affichent leurs textes d’origine.' : rows.length ? 'Aucune modification ne correspond.' : 'Aucune modification pour l’instant : le site affiche ses textes d’origine.'}</div>}
    {shown.map(({ t, by }) => (
      <details class="panel" style="margin-bottom:8px">
        <summary class="row between" style="cursor:pointer;gap:10px">
          <span class="small" style="min-width:0"><span class="tag">{KIND_LABEL[t.kind] ?? t.kind}</span> <b>{t.value.length > 90 ? t.value.slice(0, 90) + '…' : t.value || '(vide)'}</b></span>
          <span class="xs muted" style="flex:none">{where(t.scope)} · {fmt(t.updatedAt)}{by ? ` · ${by}` : ''}</span>
        </summary>
        <p class="xs muted" style="margin:10px 0 4px">Texte d'origine</p>
        <p class="small" style="margin:0 0 10px;white-space:pre-wrap">{t.original}</p>
        <form data-api="/api/admin/textes" data-reload>
          <input type="hidden" name="action" value="update" /><input type="hidden" name="id" value={t.id} />
          <label class="f" for={`v-${t.id}`}>Texte affiché</label>
          <textarea class="in" id={`v-${t.id}`} name="value" rows="3" disabled={!canEdit}>{t.value}</textarea>
          {canEdit && (
            <div class="row" style="gap:8px;margin-top:8px;flex-wrap:wrap">
              <button class="btn btn-primary btn-sm" type="submit">Enregistrer</button>
              <button class="btn btn-ghost btn-sm" type="button" data-post="/api/admin/textes" data-body={JSON.stringify({ action: 'delete', id: t.id })} data-confirm="Rétablir le texte d'origine ?" data-reload>Rétablir l'original</button>
              {t.scope !== SITE && <a class="btn btn-ghost btn-sm" href={`${t.scope}?edition=1`} target="_blank" rel="noopener">Voir sur la page</a>}
            </div>
          )}
        </form>
      </details>
    ))}
  </section>}
</AdminLayout>
