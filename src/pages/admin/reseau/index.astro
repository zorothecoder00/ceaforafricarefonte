---
/* CEA OS — Réseau territorial (prototype › pReseau), profils dg, adg, dirreg, rep : bureaux régionaux et de représentation,
   effectif, membres, inscriptions en attente, encaissements et rapport mensuel de chaque pays. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Tags from '../../../components/os/Tags.astro';
import { and, eq, sql } from 'drizzle-orm';
import { db } from '../../../lib/db';
import { osInscription, osReport } from '../../../db/schema/os';
import { invoice } from '../../../db/schema/finance';
import { osContext, allStaff, scopeState } from '../../../lib/os/core';
import { memberBase, reportPeriod } from '../../../lib/os/relations';
import { PK, REGIONS, pn, regOf, fmt, mfcfa, type Region } from '../../../lib/os/ref';

export const prerender = false;
const os = await osContext(Astro.locals.user!);
const sc = scopeState(os, Astro.cookies);
const rf = Astro.url.searchParams.get('r');
const people = await allStaff();
const period = reportPeriod();
const [base, pending, paid, reports] = await Promise.all([
  memberBase(),
  db.select({ c: osInscription.country, n: sql<number>`count(*)::int` }).from(osInscription).where(eq(osInscription.status, 'En attente')).groupBy(osInscription.country),
  db.select({ c: invoice.country, s: sql<number>`coalesce(sum(${invoice.totalXof}),0)::float` }).from(invoice).where(and(eq(invoice.kind, 'facture'), eq(invoice.status, 'payee'))).groupBy(invoice.country),
  db.select().from(osReport).where(eq(osReport.period, period)),
]);
const regs = (Object.keys(REGIONS) as Region[]).filter((k) => (!rf || rf === k) && PK.some((p) => regOf(p) === k && sc.inScope({ country: p })));
const st = (p: string) => reports.find((r) => r.country === p)?.status ?? 'Brouillon';
---
<AdminLayout title="Réseau territorial" lead={`Bureaux régionaux et de représentation · ${sc.label} · rapports de ${period}`}>
  <Fragment slot="actions">{rf && <a class="btn ghost" href="/admin/reseau">Toutes les régions</a>}</Fragment>
  {regs.map((k) => {
    const ps = PK.filter((p) => regOf(p) === k && sc.inScope({ country: p }));
    const dir = people.find((s) => s.prof === 'dirreg' && s.reg === k && s.active);
    return (
      <div class="card" style="margin-bottom:14px">
        <div class="row between"><div><h2 style="margin:0">{REGIONS[k].n}</h2><span class="small muted">Bureau régional de {REGIONS[k].city} · {dir?.name ?? '—'} · {ps.length} pays</span></div><span class="small">{ps.filter((p) => st(p) === 'Soumis').length}/{ps.length} rapports soumis</span></div>
        <div class="tw" style="margin-top:10px">
          <table class="t">
            <thead><tr><th>Pays</th><th>Représentant·e</th><th>Effectif</th><th>Membres</th><th>Inscriptions en attente</th><th>Encaissé</th><th>Rapport</th><th></th></tr></thead>
            <tbody>{ps.map((p) => { const rep = people.find((s) => s.prof === 'rep' && s.country === p && s.active); return (
              <tr><td><b>{pn(p)}</b></td><td class="small">{rep?.name ?? '—'}</td><td class="num">{people.filter((s) => s.country === p && s.active).length}</td><td class="num">{fmt(Object.values(base[p] ?? {}).reduce((a, b) => a + b, 0))}</td><td class="num">{pending.find((x) => x.c === p)?.n ?? 0}</td><td class="num">{mfcfa(paid.find((x) => x.c === p)?.s ?? 0)}</td><td><Tags st={st(p)} /></td><td><a class="btn ghost sm" href={`/admin/reseau/rapport/${p}`}>Ouvrir</a></td></tr>
            ); })}</tbody>
          </table>
        </div>
      </div>
    );
  })}
  {!regs.length && <div class="empty">Aucun bureau dans votre périmètre.</div>}
</AdminLayout>
