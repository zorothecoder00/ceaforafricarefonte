---
/* Candidatures aux programmes (CDC §7.1, §11) : vue de suivi de toutes les candidatures.
   Une candidature rattachée à un appel du back-office se décide en comité, sur la fiche de l'appel (jury, grille, procès-verbal) ;
   celles des programmes historiques sans appel se décident ici (statut et note, candidat notifié). */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { and, desc, eq, ne } from 'drizzle-orm';
import { db } from '../../lib/db';
import { programmeApplication, applicationStatusEnum } from '../../db/schema/app';
import { programmeCall } from '../../db/schema/programmes';
import { user } from '../../db/schema/auth';
import { scope } from '../../lib/rbac';
import { LEGACY, LEGACY_FIELD_LABELS } from '../../lib/calls';
import { Fields } from '../../lib/programmes';

export const prerender = false;
const me = Astro.locals.user!;
const canDecide = scope(me.roles, 'candidature', 'V') === 'all';
const q = Astro.url.searchParams;
const prog = q.get('programme') ?? '';
const st = q.get('statut') ?? '';
// Appels du back-office (hors brouillon) : leurs candidatures se décident en comité
const calls = await db.select({ id: programmeCall.id, slug: programmeCall.slug, title: programmeCall.title, fields: programmeCall.fields }).from(programmeCall).where(ne(programmeCall.status, 'brouillon'));
const callOf = new Map(calls.map((c) => [c.slug, c]));
const progs = (await db.selectDistinct({ p: programmeApplication.programme }).from(programmeApplication)).map((r) => r.p).sort();
const progLabel = (p: string) => callOf.get(p)?.title ?? LEGACY[p]?.label ?? p;
const rows = await db.select({ a: programmeApplication, name: user.name, email: user.email }).from(programmeApplication).innerJoin(user, eq(user.id, programmeApplication.userId))
  .where(and(prog ? eq(programmeApplication.programme, prog) : undefined, st && (applicationStatusEnum.enumValues as readonly string[]).includes(st) ? eq(programmeApplication.status, st as 'recue') : undefined)).orderBy(desc(programmeApplication.submittedAt)).limit(300);
const L: Record<string, string> = { brouillon: 'Brouillon', recue: 'Reçue', en_evaluation: 'En évaluation', entretien: 'Entretien', admise: 'Admise', liste_attente: "Liste d'attente", refusee: 'Refusée', retiree: 'Retirée' };
const labelOf = (p: string, k: string) => {
  const f = callOf.get(p)?.fields;
  return (Fields.safeParse(f).success ? (f as Fields).find((x) => x.key === k)?.label : undefined) ?? LEGACY_FIELD_LABELS[k] ?? k;
};
---
<AdminLayout title="Candidatures programmes" lead={`${rows.length} candidature${rows.length > 1 ? 's' : ''}. Les candidatures d'un appel avec jury se décident en comité, sur la fiche de l'appel ; le candidat est notifié à chaque décision.`} obj="candidature">
  <form class="filters" method="get" style="margin-top:0">
    <select class="in" name="programme" aria-label="Programme"><option value="">Tous les programmes</option>{progs.map((p) => <option value={p} selected={p === prog}>{progLabel(p)}</option>)}</select>
    <select class="in" name="statut" aria-label="Statut"><option value="">Tous les statuts</option>{applicationStatusEnum.enumValues.map((s) => <option value={s} selected={s === st}>{L[s]}</option>)}</select>
    <button class="btn btn-primary btn-sm" type="submit">Filtrer</button>
  </form>
  {rows.length === 0 && <div class="empty">Aucune candidature.</div>}
  {rows.map(({ a, name, email }) => {
    const call = callOf.get(a.programme);
    return (
      <details class="panel" style="margin-bottom:10px">
        <summary class="row between" style="cursor:pointer"><span><b>{a.reference}</b> · {name} <span class="xs muted">· {progLabel(a.programme)}</span></span><span><span class="tag info">{L[a.status]}</span>{a.score != null && <span class="tag gold" style="margin-left:4px">{a.score}/100</span>}</span></summary>
        <div class="xs muted" style="margin-top:6px">{email} · déposée le {a.submittedAt.toLocaleDateString('fr-FR')}</div>
        <dl class="small" style="display:grid;grid-template-columns:minmax(120px,max-content) 1fr;gap:4px 12px;margin:10px 0">
          {Object.entries(a.data as Record<string, unknown>).filter(([k]) => k !== 'documents').map(([k, v]) => <><dt class="muted">{labelOf(a.programme, k)}</dt><dd style="margin:0;white-space:pre-wrap">{Array.isArray(v) ? v.join(', ') : String(v ?? '')}</dd></>)}
          {((a.data as { documents?: { label: string; name: string }[] }).documents ?? []).length > 0 && <><dt class="muted">Pièces jointes</dt><dd style="margin:0">{(a.data as { documents: { label: string; name: string }[] }).documents.map((doc, i) => <a class="small" style="display:block" href={`/api/pieces-jointes?ref=${encodeURIComponent(a.reference)}&i=${i}`}>⬇ {doc.label} — {doc.name}</a>)}</dd></>}
        </dl>
        {call ? (
          <p class="small" style="margin:0"><a class="btn btn-ghost btn-sm" href={`/admin/programmes/appel/${call.id}`}>Évaluations et décision en comité →</a> <span class="xs muted">Cet appel a un jury : la décision se prend en comité, avec la moyenne des notes et un procès-verbal.</span></p>
        ) : canDecide ? (
          <form data-api="/api/admin" data-reload class="row" style="gap:6px;align-items:end">
            <input type="hidden" name="action" value="application.update" /><input type="hidden" name="id" value={a.id} />
            <div><label class="f" for={`s-${a.id}`}>Statut</label><select class="in" id={`s-${a.id}`} name="status" style="margin:0">{applicationStatusEnum.enumValues.map((s) => <option value={s} selected={s === a.status}>{L[s]}</option>)}</select></div>
            <div><label class="f" for={`n-${a.id}`}>Note /100</label><input class="in" id={`n-${a.id}`} name="score" type="number" min="0" max="100" value={a.score ?? ''} style="margin:0;width:110px" /></div>
            <button class="btn btn-primary btn-sm" type="submit">Enregistrer</button>
          </form>
        ) : <p class="xs muted">Lecture seule : la décision demande le droit de validation (V) sur les candidatures.</p>}
      </details>
    );
  })}
</AdminLayout>
