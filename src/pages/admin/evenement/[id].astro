---
/* Écran d'un événement côté équipe (CDC §7.3) : prévision de fréquentation et alertes de surréservation, accès « stand » des
   sponsors (collecte de contacts avec l'accord des participants), impression des badges. Droit : controle_acces. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { count, desc, eq } from 'drizzle-orm';
import { db } from '../../../lib/db';
import { eventSponsorAccess, eventLead } from '../../../db/schema/app';
import { user } from '../../../db/schema/auth';
import { can } from '../../../lib/rbac';
import { findEvent } from '../../../lib/catalog';
import { eventForecast, salesByDay, LEVEL_LABEL } from '../../../lib/event-forecast';
import { dateFr, fmt } from '../../../data/site';

export const prerender = false;
const me = Astro.locals.user!;
const e = await findEvent(Astro.params.id ?? '', { hidden: true });
if (!e) return new Response('Événement introuvable', { status: 404 });
const ok = can(me.roles, 'controle_acces', 'L');
const manage = can(me.roles, 'controle_acces', 'V');
const f = ok ? await eventForecast(e) : null;
const byDay = ok ? await salesByDay(e.id) : {};
const days = Array.from({ length: 30 }, (_, i) => new Date(Date.now() - (29 - i) * 864e5).toISOString().slice(0, 10));
const maxDay = Math.max(1, ...days.map((d) => byDay[d] ?? 0));
const access = ok ? await db.select({ a: eventSponsorAccess, name: user.name, email: user.email, leads: count(eventLead.id) }).from(eventSponsorAccess)
  .innerJoin(user, eq(user.id, eventSponsorAccess.userId)).leftJoin(eventLead, eq(eventLead.accessId, eventSponsorAccess.id))
  .where(eq(eventSponsorAccess.eventId, e.id)).groupBy(eventSponsorAccess.id, user.name, user.email).orderBy(desc(eventSponsorAccess.createdAt)) : [];
const sponsorNames = e.extra?.sponsors?.map((s) => s.n).filter(Boolean) ?? [];
const TONE: Record<string, string> = { ok: 'ok', complet_prevu: 'gold', complet: 'info', surreservation: 'bad' };
const pct = (n: number) => `${Math.round(n * 100)} %`;
---
<AdminLayout title={e.t} lead={`${dateFr(e.date)} · ${e.city} · ${e.capacity ? `${fmt(e.capacity)} places` : 'sans jauge'}`} obj="controle_acces" crumbs={[['/os/dom/evt', 'Événements'], [e.t]]}>
  {f && (
    <>
      <div class="row between" style="gap:8px;flex-wrap:wrap">
        <h2 style="font-size:1.1rem;margin:0">Prévision de fréquentation <span class={`tag ${TONE[f.level]}`}>{LEVEL_LABEL[f.level]}</span></h2>
        <div class="row" style="gap:6px"><a class="btn btn-ghost btn-sm" href={`/evenements/badges?event=${e.id}`} target="_blank" rel="noopener">Imprimer les badges</a><a class="btn btn-ghost btn-sm" href="/evenements/scanner">Contrôle d'accès</a></div>
      </div>
      <div class="grid g4" style="margin-top:12px">
        <div class="panel kpi"><span class="small muted">Inscrits</span><b>{fmt(f.sold)}{f.capacity ? ` / ${fmt(f.capacity)}` : ''}</b><span class="xs muted">{f.perDay.toLocaleString('fr-FR')} par jour (14 derniers jours)</span></div>
        <div class="panel kpi"><span class="small muted">Inscrits prévus le jour J</span><b>{fmt(f.projected)}</b><span class="xs muted">{f.daysLeft ? `dans ${f.daysLeft} jour${f.daysLeft > 1 ? 's' : ''}` : 'événement commencé ou passé'}</span></div>
        <div class="panel kpi"><span class="small muted">Présence attendue</span><b>{fmt(f.expected)}</b><span class="xs muted">taux de présence {pct(f.showRate)} ({f.showRateSource === 'historique' ? 'observé sur les événements passés' : 'estimation par défaut'})</span></div>
        <div class="panel kpi"><span class="small muted">Liste d'attente</span><b>{fmt(f.waitlist)}</b><span class="xs muted">demande totale estimée : {fmt(f.demand)}</span></div>
      </div>
      {f.level === 'surreservation' && <div class="lock" style="margin-top:12px;border-color:var(--bad)"><b>Surréservation :</b> la demande estimée ({fmt(f.demand)}) dépasse la jauge de plus de 10 %. Prévoyez une salle plus grande, une diffusion en ligne{f.extraSeats ? `, ou ouvrez jusqu'à ${fmt(f.extraSeats)} places de plus : avec le taux d'absence observé, la salle ne serait pas dépassée` : ''}.</div>}
      {f.level === 'complet_prevu' && <div class="lock" style="margin-top:12px"><b>Complet prévu le {new Date(`${f.fullOn}T00:00:00Z`).toLocaleDateString('fr-FR', { timeZone: 'UTC' })}</b> au rythme actuel. Les personnes suivantes iront en liste d'attente.</div>}
      {f.level === 'complet' && <div class="lock" style="margin-top:12px"><b>Complet.</b> {f.waitlist ? `${fmt(f.waitlist)} personne(s) attendent une place.` : ''}{f.extraSeats ? ` Avec le taux d'absence observé, ${fmt(f.extraSeats)} places de plus resteraient sous la capacité de la salle.` : ''}</div>}
      <div class="panel" style="margin-top:12px">
        <h3 style="margin-top:0">Inscriptions des 30 derniers jours</h3>
        <div class="ev-bars" role="img" aria-label="Billets émis par jour sur les 30 derniers jours">{days.map((d) => <span title={`${new Date(`${d}T00:00:00Z`).toLocaleDateString('fr-FR', { timeZone: 'UTC' })} : ${byDay[d] ?? 0}`} style={`height:${Math.round(((byDay[d] ?? 0) / maxDay) * 100)}%`}></span>)}</div>
        <p class="xs muted" style="margin:6px 0 0">Une alerte est envoyée à l'équipe d'accueil quand un complet ou une surréservation se dessine (une fois par alerte), dans les 60 jours avant l'événement.</p>
      </div>

      <h2 style="font-size:1.1rem;margin-top:22px">Sponsors : collecte de contacts sur les stands</h2>
      <div class="panel">
        <p class="small muted" style="margin-top:0">Le représentant de chaque sponsor scanne les badges depuis <b>/evenements/{e.id}/stand</b>. Il ne voit le nom et l'e-mail d'un participant que si celui-ci l'a accepté (depuis « Mes billets ») ; l'accord est retirable à tout moment.</p>
        {access.length ? access.map(({ a, name, email, leads }) => (
          <div class="list-row"><span class="small"><b>{a.sponsorName}</b> — {name} ({email}){a.revokedAt ? ' · accès fermé' : ''}</span><span class="row" style="gap:6px"><span class="xs muted">{leads} badge{leads > 1 ? 's' : ''} scanné{leads > 1 ? 's' : ''}</span>{manage && !a.revokedAt && <button class="btn btn-ghost btn-sm" type="button" data-post="/api/evenements/sponsors" data-method="DELETE" data-body={JSON.stringify({ id: a.id })} data-confirm="Fermer l’accès stand de ce sponsor ?" data-reload>Fermer</button>}</span></div>
        )) : <p class="small muted">Aucun accès stand pour le moment.</p>}
        {manage && (
          <form class="row" data-api="/api/evenements/sponsors" data-reset data-reload style="gap:8px;margin-top:12px;align-items:flex-end;flex-wrap:wrap">
            <input type="hidden" name="eventId" value={e.id} />
            <div><label class="f" for="sn">Sponsor</label><input class="in" id="sn" name="sponsorName" required minlength="2" maxlength="120" list="spn" style="margin:0" /><datalist id="spn">{sponsorNames.map((n) => <option value={n} />)}</datalist></div>
            <div><label class="f" for="se">E-mail du représentant (compte membre)</label><input class="in" id="se" name="email" type="email" required style="margin:0" /></div>
            <button class="btn btn-primary btn-sm" type="submit">Ouvrir l'accès</button>
          </form>
        )}
      </div>
    </>
  )}
</AdminLayout>
<style>
  .ev-bars{display:flex;align-items:flex-end;gap:3px;height:90px;border-bottom:1px solid var(--line)}
  .ev-bars span{flex:1;background:var(--navy);border-radius:3px 3px 0 0;min-height:2px}
</style>
