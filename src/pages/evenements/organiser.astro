---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Money from '../../components/Money.astro';
import { SUBS } from '../../data/site';

export const prerender = false;

const packs: [string, number, string[]][] = [
  ['Partenaire', 500000, ['Logo sur le site', '2 pass']],
  ['Argent', 2000000, ['Stand', '5 pass', '1 prise de parole']],
  ['Or', 5000000, ['Stand premium', '10 pass', 'Rapport de leads']],
  ['Platine', 12000000, ["Naming d'une salle", '20 pass', 'Session dédiée Kapital Invest']],
];
---
<BaseLayout title="Organiser avec nous">
  <PageHead title="Organiser avec nous" lead="Proposez un événement, devenez sponsor ou exposant, ou organisez dans votre pays avec l'antenne CEA." crumbs={[['/evenements', 'Événements'], ['', 'Organiser']]} subnav={SUBS.evenements} />
  <section class="block">
    <div class="wrap">
      <h2>Devenir sponsor du Forum 2026</h2>
      <div class="grid g4">
        {packs.map(([n, p, items], i) => (
          <div class="panel" style={i === 3 ? 'border:2px solid var(--gold)' : ''}>
            <h3>{n}</h3>
            <b style="font-family:var(--display);font-size:1.3rem;color:var(--navy)"><Money xof={p} /></b>
            <ul class="small">{items.map((x) => <li>{x}</li>)}</ul>
            <button class="btn btn-primary btn-sm" type="button" data-post="/api/demande" data-body={JSON.stringify({ type: 'sponsor', message: `Dossier de sponsoring : formule ${n}` })}>Demander le dossier</button>
          </div>
        ))}
      </div>
      <form class="panel" style="margin-top:24px;max-width:720px" data-api="/api/demande" data-reset>
          <input type="hidden" name="type" value="evenement" /><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px" />
        <h3>Proposer un événement</h3>
        <label class="f" for="eon">Nom</label><input class="in" id="eon" name="name" required minlength="2" autocomplete="name" />
          <label class="f" for="eoc">E-mail ou téléphone</label><input class="in" id="eoc" name="contact" required minlength="5" autocomplete="email" />
        <label class="f" for="et">Titre</label><input class="in" id="et" name="message" required minlength="3" />
        <label class="f" for="ec">Pays et ville</label><input class="in" id="ec" name="Pays et ville" required />
        <label class="f" for="ed">Date</label><input class="in" id="ed" name="Date" type="date" />
        <label class="f" for="ef">Format</label><select class="in" id="ef" name="Format"><option>Présentiel</option><option>En ligne</option><option>Hybride</option></select>
        <label class="f" for="ecap">Capacité</label><input class="in" id="ecap" name="Capacité" type="text" inputmode="numeric" pattern="[0-9]+" value="100" />
        <button class="btn btn-primary" type="submit">Soumettre</button>
      </form>
    </div>
  </section>
</BaseLayout>
