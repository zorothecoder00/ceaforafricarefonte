---
/* Agenda des événements (CDC §7.3) : filtres (type, format, pays, gratuit/payant), vue liste ou carte, abonnement au calendrier. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import EventRow from '../../components/EventRow.astro';
import KapitalAd from '../../components/KapitalAd.astro';
import { SUBS, country } from '../../data/site';
import { allEvents } from '../../lib/catalog';
import { getLang } from '../../i18n/ui';

export const prerender = false;
const EVENTS = await allEvents({ lang: getLang(Astro.currentLocale) === 'en' ? 'en' : 'fr' });

// Type d'événement (filtre ?type= utilisé par le méga-menu)
const TYPE: Record<string, string> = { e1: 'Forum', e2: 'Masterclass et ateliers', e3: 'Rencontres investisseurs', e4: 'Masterclass et ateliers', e5: 'Réseautage' };
const list = [...EVENTS].sort((a, b) => a.date.localeCompare(b.date));
const types = [...new Set(Object.values(TYPE))];
const countries = [...new Set(EVENTS.map((e) => e.c))];
// Points de la vue carte : événements avec un lieu physique
const points = list.filter((e) => e.extra?.venue).map((e) => ({ id: e.id, t: e.t, date: e.date, name: e.extra!.venue!.name, lat: e.extra!.venue!.lat, lon: e.extra!.venue!.lon }));
// Vue calendrier : grilles mensuelles couvrant les événements à venir (au plus 4 mois)
const months: { label: string; cells: (null | { d: number; evs: typeof list })[] }[] = [];
if (list.length) {
  const start = new Date(list[0].date.slice(0, 7) + '-01T00:00:00');
  for (let i = 0; i < 4; i++) {
    const y = start.getFullYear(), m = start.getMonth() + i, first = new Date(y, m, 1), days = new Date(y, m + 1, 0).getDate();
    const evs = list.filter((e) => { const d = new Date(e.date + 'T00:00:00'); return d.getFullYear() === first.getFullYear() && d.getMonth() === first.getMonth(); });
    if (!evs.length && i > 0) continue;
    const cells: (null | { d: number; evs: typeof list })[] = Array((first.getDay() + 6) % 7).fill(null);
    for (let d = 1; d <= days; d++) cells.push({ d, evs: evs.filter((e) => Number(e.date.slice(8, 10)) === d) });
    months.push({ label: first.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' }), cells });
  }
}
const gcal = `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(`webcal://${new URL(Astro.site!).host}/evenements.ics`)}`;
---
<BaseLayout title="Événements">
  <PageHead title="CEA Events" lead="Forums, masterclass, ateliers et rencontres investisseurs, en présentiel et en ligne." crumbs={[['', 'CEA Events']]} subnav={SUBS.evenements} />
  <section class="block" style="padding-top:20px">
    <div class="wrap">
      <div class="filters">
        <div class="row" role="group" aria-label="Affichage" style="gap:4px">
          <button class="chip" type="button" data-view="liste" aria-pressed="true">Liste</button>
          <button class="chip" type="button" data-view="cal" aria-pressed="false">Calendrier</button>
          <button class="chip" type="button" data-view="carte" aria-pressed="false">Carte</button>
        </div>
        <select class="in" id="fType" aria-label="Type"><option value="">Tous les types</option>{types.map((t) => <option>{t}</option>)}</select>
        <select class="in" id="fFmt" aria-label="Format"><option value="">Tous les formats</option><option>Présentiel</option><option>En ligne</option><option>Hybride</option></select>
        <select class="in" id="fC" aria-label="Pays"><option value="">Tous les pays</option>{countries.map((c) => <option value={c}>{country(c)}</option>)}</select>
        <select class="in" id="fP" aria-label="Prix"><option value="">Gratuit et payant</option><option value="1">Accès gratuit</option><option value="0">Payant</option></select>
        <details style="position:relative">
          <summary class="btn btn-ghost btn-sm">S'abonner au calendrier</summary>
          <div class="panel" style="position:absolute;z-index:5;right:0;min-width:280px;margin-top:6px">
            <p class="small" style="margin:0 0 8px">Les nouveaux événements apparaîtront automatiquement dans votre agenda.</p>
            <a class="btn btn-primary btn-sm" id="webcal" href="/evenements.ics" style="margin-bottom:8px">Ouvrir dans mon agenda</a>
            <a class="small" href={gcal} target="_blank" rel="noopener" style="display:block">Ajouter à Google Agenda</a>
            <a class="small" href="/evenements.ics" download="evenements-cea.ics" style="display:block">Télécharger le fichier .ics</a>
          </div>
        </details>
      </div>
      <div class="split">
        <div>
          <div id="evList">{list.map((e) => <div data-type={TYPE[e.id]} data-id={e.id} data-free={e.tk.some((t) => !t.p) ? '1' : '0'}><EventRow e={e} /></div>)}</div>
          <div class="empty" id="evEmpty" hidden style="margin-top:12px">Aucun événement pour ces critères.</div>
          <div id="evCal" hidden>
            {months.map((mo) => (
              <>
                <h3 style="margin-top:14px">{mo.label}</h3>
                <div class="cal">
                  {['L', 'M', 'M', 'J', 'V', 'S', 'D'].map((d) => <div class="h">{d}</div>)}
                  {mo.cells.map((c) => (c ? <div><b>{c.d}</b>{c.evs.map((e) => <a href={`/evenements/${e.id}`} data-ev={e.id}>{e.t.slice(0, 22)}…</a>)}</div> : <div></div>))}
                </div>
              </>
            ))}
          </div>
          <div id="evMap" hidden>
            <div id="map" style="height:460px;border-radius:12px;margin-top:12px;border:1px solid var(--line)" role="region" aria-label="Carte des événements"></div>
            <p class="xs muted" style="margin:6px 0 0">Les événements en ligne n'apparaissent pas sur la carte. Fond de carte © contributeurs OpenStreetMap.</p>
          </div>
        </div>
        <aside><KapitalAd variant={0} /></aside>
      </div>
    </div>
  </section>
</BaseLayout>
<script type="application/json" id="evPoints" set:html={JSON.stringify(points)} />
<script>
  type Pt = { id: string; t: string; date: string; name: string; lat: number; lon: number };
  // Sous-ensemble de l'API Leaflet utilisé ici (bibliothèque chargée à la demande)
  type LMap = { fitBounds: (b: unknown, o: object) => void; setView: (c: [number, number], z: number) => void; invalidateSize: () => void };
  type Layer = { addTo: (m: unknown) => Layer; clearLayers: () => void; bindPopup: (h: string) => Layer };
  type Leaflet = { map: (el: HTMLElement) => LMap; tileLayer: (u: string, o: object) => Layer; marker: (ll: [number, number]) => Layer; layerGroup: () => Layer; latLngBounds: (p: [number, number][]) => unknown };

  const f = document.getElementById('fFmt') as HTMLSelectElement, c = document.getElementById('fC') as HTMLSelectElement;
  const ty = document.getElementById('fType') as HTMLSelectElement, pr = document.getElementById('fP') as HTMLSelectElement;
  const points: Pt[] = JSON.parse(document.getElementById('evPoints')!.textContent!);
  const visible = new Set(points.map((p) => p.id));
  (document.getElementById('webcal') as HTMLAnchorElement).href = `webcal://${location.host}/evenements.ics`;

  function apply() {
    let n = 0;
    document.querySelectorAll<HTMLElement>('#evList > [data-type]').forEach((box) => {
      const el = box.querySelector<HTMLElement>('a')!;
      const ok = (!ty.value || box.dataset.type === ty.value) && (!f.value || el.dataset.fmt === f.value) && (!c.value || el.dataset.c === c.value) && (!pr.value || box.dataset.free === pr.value);
      box.hidden = !ok;
      if (ok) { n++; visible.add(box.dataset.id!); } else visible.delete(box.dataset.id!);
    });
    document.getElementById('evEmpty')!.hidden = n > 0;
    document.querySelectorAll<HTMLElement>('#evCal [data-ev]').forEach((a) => { a.hidden = !visible.has(a.dataset.ev!); });
    drawMarkers();
  }
  [f, c, ty, pr].forEach((x) => x.addEventListener('change', apply));

  // Vue carte : Leaflet et les tuiles OpenStreetMap ne sont chargés qu'à l'ouverture de la carte
  let L: Leaflet | null = null, map: LMap | null = null, layer: Layer | null = null;
  const load = (tag: 'link' | 'script', attrs: Record<string, string>) => new Promise<void>((ok, ko) => {
    const el = document.createElement(tag);
    Object.entries(attrs).forEach(([k, v]) => el.setAttribute(k, v));
    el.onload = () => ok(); el.onerror = ko;
    document.head.appendChild(el);
  });
  async function openMap() {
    if (!L) {
      await Promise.all([
        load('link', { rel: 'stylesheet', href: 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css', integrity: 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=', crossorigin: '' }),
        load('script', { src: 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js', integrity: 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=', crossorigin: '' }),
      ]);
      L = (window as unknown as { L: Leaflet }).L;
      map = L.map(document.getElementById('map')!);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '© OpenStreetMap' }).addTo(map);
      layer = L.layerGroup().addTo(map);
    }
    map!.invalidateSize();
    drawMarkers();
  }
  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);
  function drawMarkers() {
    if (!L || !map || !layer) return;
    layer.clearLayers();
    const shown = points.filter((p) => visible.has(p.id));
    shown.forEach((p) => L!.marker([p.lat, p.lon]).bindPopup(`<b>${esc(p.t)}</b><br>${new Date(p.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })} · ${esc(p.name)}<br><a href="/evenements/${p.id}">Voir l'événement</a>`).addTo(layer!));
    if (shown.length) map.fitBounds(L.latLngBounds(shown.map((p) => [p.lat, p.lon])), { padding: [40, 40], maxZoom: 7 });
    else map.setView([5, 10], 3);
  }
  document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', async () => {
    const carte = b.dataset.view === 'carte', cal = b.dataset.view === 'cal';
    document.querySelectorAll('[data-view]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.getElementById('evList')!.hidden = carte || cal;
    document.getElementById('evCal')!.hidden = !cal;
    document.getElementById('evMap')!.hidden = !carte;
    if (carte) await openMap().catch(() => { document.getElementById('map')!.innerHTML = '<p class="empty">La carte ne peut pas être chargée. Vérifiez votre connexion.</p>'; });
  }));

  const q = new URLSearchParams(location.search).get('type');
  if (q && [...ty.options].some((o) => o.value === q)) { ty.value = q; apply(); }
</script>
