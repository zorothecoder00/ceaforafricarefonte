---
import MediaPlayer from '../../components/MediaPlayer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { REPLAYS, SUBS } from '../../data/site';
---
<BaseLayout title="Replays">
  <PageHead title="Replays" lead="Les événements passés, chapitrés, avec un résumé généré par IA et relu par l'équipe." crumbs={[['/evenements', 'Événements'], ['', 'Replays']]} subnav={SUBS.evenements} />
  <section class="block">
    <div class="wrap grid g3">
      {REPLAYS.map((r) => (
        <div class="panel">
          <MediaPlayer title={r.t} cap={`${r.d} · ${r.v} vues`} soon="Replay en cours de montage" />
          <h3 style="margin-top:14px">{r.t}</h3>
          <ol class="small muted" style="margin:0;padding-left:18px">{r.ch.map((c) => <li>{c}</li>)}</ol>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
