# Modèle de variables d'environnement (copier vers .env et compléter)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Production Neon : URL directe (sans -pooler) pour les migrations
DATABASE_URL_UNPOOLED=
PUBLIC_SITE_URL=http://localhost:4321
# Numéro WhatsApp officiel affiché sur la page Contact (format international, ex. 22890000000) ; sans valeur, le canal est masqué
PUBLIC_WHATSAPP_NUMBER=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321

# Connexion sociale (facultatif : activée si renseignée)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Paiements (CinetPay) — sans clé : fournisseur « simulation » en développement uniquement
CINETPAY_APIKEY=
CINETPAY_SITE_ID=

# E-mail (Resend), SMS (Twilio), WhatsApp Cloud API — sans clé : affichage en console en développement
RESEND_API_KEY=
EMAIL_FROM=CEA for Africa <noreply@cea4africa.com>
CONTACT_EMAIL=contact@cea4africa.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Stockage compatible S3 (data room, CV, documents) — sans clé : dossier local .uploads/
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Prestataire KYC (identité, vivacité, sanctions) — sans clé : contrôles saisis manuellement
KYC_PROVIDER=

# CEA Copilot (API Anthropic) — sans clé : réponses guidées par mots-clés
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5

# Mesure d'audience Matomo (chargée uniquement après consentement)
PUBLIC_MATOMO_URL=
PUBLIC_MATOMO_SITE_ID=

# Tâches planifiées (rappels de rendez-vous) : secret envoyé par Vercel Cron
CRON_SECRET=

# Notifications push (Web Push) : npx web-push generate-vapid-keys
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@cea4africa.com

# Supervision : page d’historique de disponibilité de la sonde externe (UptimeRobot, Better Stack…), affichée sur /statut
PUBLIC_STATUS_HISTORY_URL=
