# Modèle de variables d'environnement (copier vers .env et compléter)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Production Neon : URL directe (sans -pooler) pour les migrations
DATABASE_URL_UNPOOLED=
PUBLIC_SITE_URL=http://localhost:4321

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321

# Connexion sociale (facultatif : activée si renseignée)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
